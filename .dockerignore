# =============================================================================
# Build context exclusions.
#
# Everything here is sent to the Docker daemon on EVERY build before a single
# instruction runs. Without this file the context is ~1.1 GB, almost all of it
# node_modules that the image rebuilds from the lockfile anyway.
#
# Rule of thumb: if the image can regenerate it, or it is a secret, exclude it.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies — reinstalled inside the image from pnpm-lock.yaml.
# Copying host node_modules in would also be actively wrong: native modules
# (@node-rs/argon2, prisma engines, esbuild) are compiled per platform, so
# darwin-arm64 binaries would land in a linux image and fail at runtime.
# -----------------------------------------------------------------------------
**/node_modules
.pnpm-store

# -----------------------------------------------------------------------------
# Build output — regenerated by the build stage
# -----------------------------------------------------------------------------
**/dist
**/build
**/.next
**/out
**/*.tsbuildinfo
**/.turbo

# Prisma client is generated in-image so the query engine matches the image's
# libc (musl on alpine), not the host's.
packages/db/generated

# -----------------------------------------------------------------------------
# Secrets — never in an image layer. Env comes from compose / Secrets Manager.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
.npmrc.local

# -----------------------------------------------------------------------------
# Version control and CI
# -----------------------------------------------------------------------------
.git
.gitignore
.gitattributes
.github
.husky
.archive

# -----------------------------------------------------------------------------
# Tests and coverage — not shipped in a runtime image
# -----------------------------------------------------------------------------
**/coverage
**/*.test.ts
**/*.spec.ts
**/tests
**/__tests__
**/__mocks__
jest.config.ts
**/jest.config.ts
**/tsconfig.test.json

# -----------------------------------------------------------------------------
# Docs and design material — large, and irrelevant to a running container
# -----------------------------------------------------------------------------
docs
*.md
!README.md
LICENSE

# -----------------------------------------------------------------------------
# Local tooling and editor state
# -----------------------------------------------------------------------------
.vscode
.idea
.claude
*.swp
.DS_Store
**/.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Logs and scratch
# -----------------------------------------------------------------------------
**/logs
**/*.log
npm-debug.log*
pnpm-debug.log*
tmp
temp

# -----------------------------------------------------------------------------
# Docker's own files — no reason to ship them into the context
# -----------------------------------------------------------------------------
Dockerfile*
**/Dockerfile*
docker-compose*.yml
.dockerignore

# -----------------------------------------------------------------------------
# Local infra: init SQL runs via a compose bind mount, not from an image.
# -----------------------------------------------------------------------------
infra/postgres
