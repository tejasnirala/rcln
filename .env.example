# =============================================================================
# Copy to .env and fill in. NEVER commit .env.
# In production every one of these comes from AWS Secrets Manager, not a file.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Tenancy — the root domain tenant subdomains hang off.
# alpha.lvh.me:3000 resolves to 127.0.0.1 with no /etc/hosts edit.
# -----------------------------------------------------------------------------
ROOT_DOMAIN=lvh.me
WEB_URL=http://lvh.me:3000
API_URL=http://localhost:5000
# Where the web container reaches the API from inside the compose network.
# Server Actions call this; the browser never sees it. Set in docker-compose.yml
# for local dev — override in production to the internal API address.
API_INTERNAL_URL=http://api:5000

# -----------------------------------------------------------------------------
# Database
# DATABASE_URL      -> app role, RLS ENFORCED (used by api + worker at runtime)
# DIRECT_DATABASE_URL -> owner role, RLS BYPASSED (migrations + seeds only)
# These MUST be different roles. If the app connects as the table owner,
# Postgres silently skips every RLS policy and tenant isolation is a no-op.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://rcln_app:app_password@localhost:5432/rcln?schema=public
DIRECT_DATABASE_URL=postgresql://rcln_owner:owner_password@localhost:5432/rcln?schema=public

# The test database. `pnpm test` rewrites both URLs above to point here, so the
# suites never write their fixtures into the database you are browsing. Same
# server, same roles, different database — there is nothing else to configure.
# Build it with `pnpm db:test:setup` (docker compose up does it for you).
# Leave this unset unless `rcl_testing` collides with something already there.
# TEST_DATABASE_NAME=rcl_testing

# -----------------------------------------------------------------------------
# Redis — cache, rate limits, locks, BullMQ
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# -----------------------------------------------------------------------------
# Auth
# JWT_SECRET must be >=32 chars. Generate: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Email/phone verification codes. Longer than a login OTP — this one has to
# survive a mail queue, not just a walk to the desk.
VERIFICATION_TTL_SECONDS=900
# A code that confirms any email address or phone number, for as long as neither
# SES nor TRAI DLT can actually deliver one.
#
# ⚠️ DEVELOPMENT ONLY. The API refuses to boot with this set when
# NODE_ENV=production, and never reads it there. It does NOT log anyone in —
# only /auth/verify/* consults it. Delete it once a real sender exists.
DEV_MASTER_VERIFICATION_CODE=123456

# -----------------------------------------------------------------------------
# CORS — dynamic per-tenant origins are validated against organization_domains;
# this list is the static allowlist for local dev and the marketing site.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://lvh.me:3000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# DEVELOPMENT ONLY. Multiplies EVERY rate-limit budget — including the ones
# written as literals (registration, OTP, invitations, slug lookups) — by
# RATE_LIMIT_RELAXED_FACTOR, so clicking through the UI stops earning 429s.
# The API refuses to boot with this set in production, and the test suite pins
# it off. Set it to true in your own .env; leave it false here.
RATE_LIMIT_RELAXED=false
RATE_LIMIT_RELAXED_FACTOR=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Super admin seed — used once by `pnpm db:seed`. Change before any real deploy.
# -----------------------------------------------------------------------------
SUPERADMIN_EMAIL=superadmin@rcln.local
SUPERADMIN_PASSWORD=ChangeMe!SuperAdmin1
SUPERADMIN_NAME=Platform Super Admin

# =============================================================================
# Third-party — leave blank locally; the adapters fall back to a console stub.
# =============================================================================

# Object storage (S3, ap-south-1)
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Payments — platform subscriptions
#
# Which acquirer is a deployment decision, not a code one. PAYMENT_PROVIDER
# selects an adapter in @rcln/payments; nothing outside that package names one,
# so switching is this variable plus its credentials.
#
# `mock` is the development default and it is a REAL implementation: it signs
# its webhooks with the same HMAC scheme, redirects to a sandbox page an
# operator has to click, and can be told to decline or to deliver the same
# event twice. The whole subscription lifecycle runs end to end with no gateway
# account. The API refuses to BOOT with it in production.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# Where providers POST outcomes. Must be publicly reachable — localhost is not,
# so use a tunnel when testing against a real gateway. Irrelevant to the mock,
# whose events are generated in-process and never leave the network.
PAYMENTS_WEBHOOK_BASE_URL=http://localhost:5000

# How a customer-present checkout is shown:
#
#   embedded  our own page, with the provider's widget mounted on it. The
#             browser never leaves the clinic's subdomain. Card entry still
#             happens inside the provider's overlay, so cardholder data never
#             touches our markup or our servers — PCI DSS stays at SAQ-A.
#   redirect  send the browser to the provider's hosted page.
#
# Not a customer choice and not in any request contract. A provider that
# declares no widget degrades to `redirect` on its own, so this and
# PAYMENT_PROVIDER can be changed independently.
PAYMENTS_CHECKOUT_PRESENTATION=embedded

# Signs the mock provider's webhooks. Not protecting money — protecting the
# shape of the code path, so that a signature failure in development means the
# same thing it means in production.
MOCK_PAYMENTS_SECRET=mock-payments-development-secret

# Cashfree. An India-domiciled acquirer: it will charge a foreign cardholder in
# their own currency, and the merchant settles in INR. Its mandates (UPI
# Autopay, eNACH, card) are Indian rails, so unattended renewal is INR-only —
# the billing screen reads that from the adapter's declared capabilities and
# offers manual invoices elsewhere rather than a toggle that would fail.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Cashfree signs webhooks with the API secret unless a separate signing secret
# is configured in their dashboard. Leave blank to use the API secret.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=sandbox

# Razorpay. The other India-domiciled acquirer, and the same shape of deal:
# foreign cardholders can pay, the merchant settles in INR, and the recurring
# rails (UPI Autopay, e-mandate, card mandates) are domestic — so auto-renewal
# is INR-only here too.
#
# ⚠️ THERE IS NO SANDBOX HOSTNAME. Test and live are the SAME API URL, selected
#   by the key's prefix. A live key in a staging deployment charges real cards
#   with nothing in the URL to notice, so RAZORPAY_ENVIRONMENT is checked
#   against the rzp_test_ / rzp_live_ prefix and the API refuses to BOOT if they
#   disagree. Set both, and set them together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ⚠️ NOT the API secret, and there is no fallback to it. This is the secret you
#   type into Razorpay's dashboard when you create the webhook (Settings →
#   Webhooks). Leaving it blank fails the boot rather than 401-ing every
#   delivery — which is deliberate, because a silently-refused webhook means
#   subscriptions never activate and nothing anywhere says why.
#
#   Subscribe the webhook to: payment_link.paid, payment_link.expired,
#   payment_link.cancelled, payment.captured, payment.failed, invoice.paid,
#   invoice.expired, refund.processed, refund.failed.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=sandbox
# Which rail a mandate is taken on: upi (UPI Autopay — widest coverage, the
# default), emandate (netbanking, better for larger amounts, bank must support
# it) or card (the only one usable without an Indian bank account).
RAZORPAY_MANDATE_METHOD=upi
# What the authorisation transaction itself charges, in PAISE. Zero is a real
# zero-amount authorisation and is what UPI Autopay and e-mandate use. Some card
# issuers will not authorise for zero and need 100 (₹1), which Razorpay refunds
# automatically. It is not the ceiling — the ceiling is computed from the plan
# price by @rcln/billing.
RAZORPAY_MANDATE_AUTH_AMOUNT_MINOR=0

# WhatsApp (Meta Cloud API / BSP)
WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# SMS (MSG91 — needs TRAI DLT registration before it will deliver)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

# Email
#
# `smtp` sends; `console` logs the message and delivers nothing.
#
# Under docker compose this is already `smtp` pointed at Mailpit (compose sets
# EMAIL_PROVIDER/SMTP_HOST itself, overriding whatever is here) and every
# invitation link and verification code is readable at http://localhost:8025.
# Mailpit delivers to nobody — no address in it can receive a real message.
#
# Running natively without Docker there is no Mailpit, so either leave this on
# `console` and read the API log, or run one yourself:
#   docker run -p 8025:8025 -p 1025:1025 axllent/mailpit
# and set EMAIL_PROVIDER=smtp with SMTP_HOST=localhost.
#
# A real relay (SES, Postmark, Resend) is the same two variables plus
# credentials — SES still needs domain verification, DKIM, SPF and DMARC.
EMAIL_PROVIDER=console
EMAIL_FROM=rcln <noreply@rcln.local>
SMTP_HOST=localhost
SMTP_PORT=1025
# Implicit TLS (port 465). Mailpit is plaintext; a relay on 587 upgrades itself.
SMTP_SECURE=false
# Blank means unset. Mailpit authenticates nobody.
SMTP_USER=
SMTP_PASSWORD=
SES_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# Where generated documents — invoice PDFs today, lab reports and prescriptions
# later — are written. `local` is the development default and needs nothing
# beyond a writable path; `s3` needs a PRIVATE bucket.
#
# STORAGE_LOCAL_PATH IS THE ONLY SETTING. It is used three times from this one
# value: the folder on your machine, the mount point inside the API container,
# and the mount point inside the worker container — all identical. Change it
# here and the documents move. No compose edit, nothing else to keep in sync.
#
# The files are REAL FILES ON YOUR MACHINE. Open the folder, read the PDFs,
# delete them — the containers see every change immediately, and vice versa.
#
# ⚠️ IT MUST BE ABSOLUTE. A relative value cannot be a mount point inside a
#   container, and `docker compose up` fails with "invalid mount target".
#
# ⚠️ IT MUST BE SOMEWHERE DOCKER DESKTOP SHARES — anywhere under your home
#   directory is, by default. /var/lib, /opt and /srv are NOT.
#
#   Getting this wrong does NOT produce an error. Docker silently creates the
#   directory inside its own Linux VM, the app writes there quite happily, and
#   the files simply never appear on your machine. Measured: a bind mount of
#   /var/lib/rcln-mount-test reported success and left nothing on the host.
#   To use a path outside your home directory, add it first in
#   Docker Desktop → Settings → Resources → File sharing.
#
# ⚠️ IT MUST PERSIST. Anywhere on your real disk does. A path that only exists
#   inside a container loses every stored PDF on the next
#   `docker compose up --build`, while the database rows describing them
#   survive — an invoice that insists it has a document nobody can download.
#
# ⚠️ DO NOT PUT IT INSIDE THIS REPOSITORY. An invoice PDF names a patient, and
#   a folder in a git working tree is one `git add -f` from being published
#   permanently. It is also why this is not in a cloud-synced folder by default.
#
# Unset, compose falls back to ${HOME}/rcln/documents. A native run (no Docker)
# uses this same value; if it is relative there it resolves against the REPO
# ROOT, never the working directory — the API runs from apps/api and the worker
# from apps/worker, so resolving against cwd would silently give the two
# processes different storage roots.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/Users/tejasnirala/.rcln/documents

# Where the PDF renderer finds Chromium.
#
# ⚠️ ONLY THE WORKER LAUNCHES IT. The api container is capped at 1g and already
#   exits 137 running its own test suite; a browser process per render lands on
#   top of that. Rendering is a worker job for that reason, and the api never
#   reads this variable.
#
# Unset, the worker uses /usr/bin/chromium, which is where the alpine package
# puts it and is correct inside compose. It is here for a NATIVE run, where the
# path differs per platform:
#   macOS (brew install chromium)  /Applications/Chromium.app/Contents/MacOS/Chromium
#   Debian/Ubuntu                  /usr/bin/chromium-browser
#
# ⚠️ `playwright-core` drives the SYSTEM browser deliberately. `npx playwright
#   install` downloads a glibc build that cannot start on alpine's musl at all —
#   and it fails at LAUNCH, not at install, so the error arrives at the first
#   invoice somebody issues rather than during the build.
# CHROMIUM_EXECUTABLE_PATH=

# Production only. The bucket must be private — invoice PDFs are never public,
# and downloads go out as short-lived signed URLs minted per authorized request.
# Selecting s3 without a bucket and region is a fatal boot error, deliberately:
# a silent fall back to local disk is how a production deployment loses every
# document it thinks it stored.
#
# ⚠️ NO AWS KEYS HERE, ON PURPOSE. The S3 provider uses the standard AWS
#   credential chain — environment, shared config, or an instance IAM role,
#   which is what production should use. A long-lived key in a config object is
#   a secret that ends up in a log the first time somebody debugs configuration.
S3_BUCKET=
S3_REGION=
S3_KEY_PREFIX=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
