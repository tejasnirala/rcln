# Dependencies
node_modules/
.pnpm-store/

# Next.js generates this on every dev/build and marks it "do not edit".
# create-next-app gitignores it by default; the app-level .gitignore was folded
# into this one during the monorepo restructure.
apps/web/next-env.d.ts

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Generated Prisma client
packages/db/generated/

# Environment — NEVER commit real secrets
.env
.env.*
!.env.example

# Test / coverage
coverage/
.nyc_output/

# Turbo
.turbo/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Knowledge base: the index is committed, the dirty marker is not.
.kb/.dirty

# Locally stored documents — invoice PDFs and anything else DocumentService
# writes when STORAGE_PROVIDER=local (§30).
#
# STORAGE_LOCAL_PATH should point OUTSIDE this repository (the default is
# ~/rcln/documents), so normally nothing here matches anything. These entries
# are a safety net for a misconfiguration that puts documents in the tree:
# an invoice PDF names a patient, and committing one would put it in every
# clone and every fork, permanently.
#
# ⚠️ Anchored with a leading slash on purpose. A bare `storage/` pattern
#   matches at ANY depth, so it would also swallow `packages/storage/` — the
#   source of the storage package itself.
/storage/
/documents/

# Rendered sample invoices from `pnpm --filter @rcln/documents run preview`.
# A development tool for LOOKING at the template; its output is a build
# artefact, and the ones that matter are written outside the repo anyway.
/packages/documents/preview/
