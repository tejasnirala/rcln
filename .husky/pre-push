#!/bin/sh
# =============================================================================
# Pre-push: block protected branches, then validate properly.
# Linting lives here rather than pre-commit because eslint 9 flat config must
# run per-package, which is too slow for every commit.
# =============================================================================

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

case "$CURRENT_BRANCH" in
  main|master|stage|staging|dev|develop)
    echo ""
    echo "PUSH REJECTED: direct pushes to '$CURRENT_BRANCH' are not allowed."
    echo ""
    echo "  git checkout -b feature/your-feature-name"
    echo "  git push origin feature/your-feature-name"
    echo ""
    echo "  Prefixes: feature/ fix/ hotfix/ docs/ refactor/ test/ chore/"
    echo ""
    exit 1
    ;;
esac

pnpm run typecheck || exit 1
pnpm run lint || exit 1

# The .kb index is committed, so a stale one must not reach the remote. Cheap
# enough (sub-second, no database, no network) to just run rather than check.
if ! pnpm kb --quiet; then
  echo "PUSH REJECTED: .kb generation failed."
  exit 1
fi
if ! git diff --quiet -- .kb; then
  echo ""
  echo "PUSH REJECTED: .kb was stale and has been regenerated."
  echo "Review and commit it, then push again:"
  echo ""
  echo "  git add .kb && git commit -m 'chore(kb): refresh index'"
  echo ""
  exit 1
fi

# RLS is worth a slow hook: a missing policy is silent in every other check.
if pnpm db:rls:check >/dev/null 2>&1; then
  echo "RLS check passed."
else
  echo "RLS check skipped or failed (is the database up? 'pnpm infra:up')"
fi
