# =============================================================================
# Development image — shared by api, web and worker.
#
# ONE image for all three because in dev they need the identical workspace:
# the same node_modules tree, the same generated Prisma client, the same
# packages/*. Only the CMD differs, which compose supplies per service.
#
# Source is NOT copied in. compose bind-mounts the repo at /app so edits on the
# host are visible instantly, and node_modules is masked by a named volume so
# the container's linux binaries are never shadowed by the host's.
#
# Build from the repo root:
#   docker build -f infra/docker/Dockerfile.dev .
# =============================================================================

FROM node:24-alpine

# libc6-compat: Prisma's engine and @node-rs/argon2 are glibc-linked prebuilds;
# alpine ships musl. Without this they fail to load at runtime.
# curl is used by the compose healthchecks.
RUN apk add --no-cache libc6-compat curl \
  && corepack enable pnpm

# ---------------------------------------------------------------------------
# Chromium, for the WORKER's PDF renderer.
#
# ⚠️ IT IS IN THE SHARED DEV IMAGE AND ONLY THE WORKER EVER LAUNCHES IT, WHICH
#   IS THE POINT. The api container is capped at 1g and already exits 137
#   running its own test suite beside the dev server; a browser process there
#   would land on top of that. This costs the api and web containers image SIZE,
#   which is a developer's disk, and costs them no memory at all, which is the
#   thing that was actually breaking. The production images are separate per app
#   (apps/*/Dockerfile) and only the worker's installs this.
#
#   The alternative — a second dev image for the worker alone — reintroduces the
#   footgun the compose header warns about at length: `docker compose build api`
#   leaving the other services on a stale image.
#
# ⚠️ THE DISTRIBUTION'S CHROMIUM, NOT PLAYWRIGHT'S. `npx playwright install`
#   downloads a glibc build that cannot start on alpine's musl at all, and it
#   fails at launch rather than at install. `playwright-core` is the dependency
#   for exactly this reason and is pointed at the binary below.
RUN apk add --no-cache chromium nss freetype harfbuzz ttf-freefont
ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# The husky prepare script runs on install and needs git, which this image
# deliberately does not carry. Hooks belong on the host, not in the container.
ENV HUSKY=0

# Manifests only. This layer is cached until a package.json or the lockfile
# changes, so editing source never triggers a reinstall.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json             apps/api/
COPY apps/web/package.json             apps/web/
COPY apps/worker/package.json          apps/worker/
COPY packages/db/package.json          packages/db/
COPY packages/contracts/package.json   packages/contracts/
COPY packages/permissions/package.json packages/permissions/
COPY packages/config/package.json      packages/config/
COPY packages/documents/package.json   packages/documents/
COPY packages/queue/package.json       packages/queue/
COPY packages/storage/package.json     packages/storage/
COPY packages/payments/package.json    packages/payments/
COPY packages/billing/package.json     packages/billing/
COPY packages/tax/package.json         packages/tax/
COPY packages/invoicing/package.json   packages/invoicing/

# Full install (dev dependencies included — tsx, prisma CLI, next all live there).
RUN pnpm install --frozen-lockfile

# The entrypoint reconciles dependencies on boot and waits for the database.
COPY infra/docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

ENTRYPOINT ["dev-entrypoint.sh"]
