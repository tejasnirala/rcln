{
  "name": "rcln",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant healthcare management SaaS",
  "license": "AGPL-3.0-only",
  "author": "Tejas Nirala",
  "homepage": "https://github.com/tejasnirala/rcln#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejasnirala/rcln.git"
  },
  "bugs": {
    "url": "https://github.com/tejasnirala/rcln/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@rcln/api",
    "dev:web": "turbo run dev --filter=@rcln/web",
    "dev:worker": "turbo run dev --filter=@rcln/worker",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "kb": "node .kb/generate.mjs",
    "kb:check": "node .kb/generate.mjs --check",
    "kb:find": "node .kb/find.mjs",
    "db:generate": "pnpm --filter @rcln/db run generate",
    "db:migrate": "pnpm --filter @rcln/db run migrate",
    "db:migrate:prod": "pnpm --filter @rcln/db run migrate:prod",
    "db:seed": "pnpm --filter @rcln/db run seed",
    "db:studio": "pnpm --filter @rcln/db run studio",
    "db:reset": "pnpm --filter @rcln/db run reset",
    "db:grants": "pnpm --filter @rcln/db run grants",
    "db:rls:check": "pnpm --filter @rcln/db run rls:check",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "commit": "cz",
    "up": "docker compose up",
    "up:d": "docker compose up -d",
    "down": "docker compose down",
    "nuke": "docker compose down -v",
    "logs": "docker compose logs -f",
    "rebuild": "docker compose build --no-cache",
    "sh": "docker compose exec api sh",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t rcln-api .",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t rcln-web .",
    "docker:build:worker": "docker build -f apps/worker/Dockerfile -t rcln-worker .",
    "infra": "docker compose up -d postgres redis mailpit",
    "infra:stop": "docker compose stop postgres redis mailpit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.0",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  }
}
