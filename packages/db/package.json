{
  "name": "@rcln/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./unsafe": {
      "types": "./dist/unsafe.d.ts",
      "default": "./dist/unsafe.js"
    },
    "./generated": {
      "types": "./generated/prisma/index.d.ts",
      "default": "./generated/prisma/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "reset": "sh -c 'prisma migrate reset \"$@\" && tsx scripts/apply-grants.ts && tsx prisma/seed.ts' --",
    "grants": "tsx scripts/apply-grants.ts",
    "rls:check": "tsx scripts/check-rls.ts",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "clean": "rm -rf dist generated *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@rcln/clinical": "workspace:*",
    "@rcln/config": "workspace:*",
    "@rcln/permissions": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "catalog:"
  }
}
