// =============================================================================
// rcln — Multi-tenant healthcare SaaS
//
// PHASE 0 SCOPE: tenancy, subscriptions, identity, RBAC, settings, audit.
// Clinical / lab / pharmacy / inventory / billing land in later phases —
// see .kb/Database/schema-design.md for the full target design.
//
// Conventions:
//   - uuid PKs, snake_case columns via @map, plural table names
//   - organizationId on every tenant table (RLS predicate + composite FK target)
//   - deletedAt for soft delete, never an is_deleted boolean
//   - tenant tables carry @@unique([organizationId, id]) so children can
//     reference (organization_id, id) and make cross-tenant rows unrepresentable
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Prisma 7 no longer accepts `url` here.
//   - Migrations / seeds  -> DIRECT_DATABASE_URL (owner role), set in prisma.config.ts
//   - Running application -> DATABASE_URL (app role, RLS enforced), passed to
//     PrismaClient via the pg adapter in src/client.ts
datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum OrganizationType {
  CLINIC
  HOSPITAL
  CHAIN
  LAB
}

enum BranchType {
  CLINIC
  HOSPITAL
  LAB
  PHARMACY
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum FeatureValueType {
  INT
  BOOL
}

enum SubscriptionStatus {
  /// Inside the free trial. No money has been asked for yet.
  TRIALING
  /// Checkout has started and the first payment has not landed. Entitlements are
  /// NOT granted here — a subscription that grants access before the money
  /// arrives is a subscription anyone can have for free.
  INCOMPLETE
  ACTIVE
  /// A renewal was attempted and failed. Access continues until
  /// `grace_period_end`, which is what dunning is retrying against.
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SubscriptionInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

/// An authorisation to debit without the customer present.
///
/// PENDING means the customer was shown the authorisation page and has not
/// finished. ACTIVE is the ONLY state a debit may be attempted from — see
/// `@rcln/payments/types.ts`, which these mirror exactly so no translation
/// table is needed between the provider seam and the database.
enum MandateStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  FAILED
}

/// One attempt to move money, and the row a provider's webhook is matched to.
///
/// CREATED is before the provider has been asked; PENDING is after, while the
/// customer is on the hosted page or a UPI collect is outstanding. Neither
/// grants anything.
enum PaymentIntentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

/// Why money is being asked for. Drives what the webhook handler does on
/// success, so it is a column and not something inferred from which foreign
/// keys happen to be set.
enum PaymentPurpose {
  /// First payment for a subscription — from trial, or after expiry.
  SUBSCRIPTION_START
  /// The prorated difference on a mid-period plan change.
  UPGRADE
  /// An automatic charge at period end.
  RENEWAL
  /// A zero-or-nominal charge whose only job is to authorise future debits.
  MANDATE_SETUP
  /// A customer paying an open invoice by hand, typically after dunning.
  INVOICE_PAYMENT
}

/// What happened to a subscription, and why. The billing audit trail proper —
/// `audit_logs` records that a row changed; this records the commercial event.
enum SubscriptionChangeType {
  SUBSCRIBE
  UPGRADE
  RENEW
  CANCEL_AT_PERIOD_END
  CANCEL_IMMEDIATE
  RESUME
  REACTIVATE
  TRIAL_EXPIRED
  PAYMENT_FAILED
  SUSPENDED
}

/// What an invoice line is for. A prorated upgrade produces a credit line and a
/// charge line on the same invoice, and a clinic reading its own invoice has to
/// be able to tell which is which without doing the arithmetic itself.
/// How a price relates to the tax on it.
enum TaxBehavior {
  /// The catalogue figure is net; tax is added on top. The default, and what
  /// every current `plan_prices` row means.
  EXCLUSIVE
  /// The catalogue figure is what the customer pays, tax already inside it.
  /// Required for consumer-facing prices in the EU and UK.
  INCLUSIVE
}

/// Why a supply was taxed the way it was. Recorded on the invoice because it is
/// the thing an auditor asks about, and it cannot be recomputed later — the
/// registrations and the customer's validation status will both have moved on.
enum TaxTreatment {
  /// Tax charged at the rate of the place of supply.
  STANDARD
  /// The customer accounts for the tax themselves. EU cross-border B2B with a
  /// valid VAT number, and India's reverse-charge cases.
  REVERSE_CHARGE
  /// Taxable at 0% — an export of services out of a jurisdiction we collect in.
  /// Different from EXEMPT: a zero-rated supply still appears on a return.
  ZERO_RATED
  /// Outside the scope of the tax entirely.
  EXEMPT
  /// We hold no registration covering this place of supply, so we may not
  /// collect. NOT a rate of zero — it is an absence of authority to charge, and
  /// the distinction is the whole reason this value exists.
  NOT_REGISTERED
  /// We ARE registered here, but no `tax_rules` row says what this item's tax
  /// category is taxed at, so nothing was charged.
  ///
  /// ⚠️ THE ONE TREATMENT THAT MEANS "THIS DOCUMENT IS NOT FIT TO ISSUE".
  ///   Every other value is a legal position. This one is a configuration gap,
  ///   and the safe direction for a gap is to charge nothing and say so rather
  ///   than to apply the registration's standard rate — a rate nobody chose,
  ///   on a document a patient may claim against insurance. A DRAFT may carry
  ///   it; finalisation refuses to ISSUE an invoice that still does.
  UNRATED
  /// The jurisdiction's tax cannot be computed from a rate table at all, and no
  /// external tax provider is configured to compute it.
  ///
  /// ⚠️ DIFFERENT FROM `UNRATED`, BECAUSE THE REMEDY IS DIFFERENT. `UNRATED`
  ///   means "add a `tax_rules` row" and a clinic can fix it in a screen.
  ///   This means "subscribe to Avalara / Stripe Tax", and no amount of data
  ///   entry will help: US sales tax is ~11,000 jurisdictions with
  ///   economic-nexus thresholds, and EU cross-border consumer VAT needs all 27
  ///   rates plus VIES. Both are honest refusals rather than plausible guesses.
  ///   Like `UNRATED`, finalisation must refuse to ISSUE an invoice carrying it.
  PROVIDER_REQUIRED
}

/// How ONE rate becomes the tax LINES printed on an invoice.
///
/// A rate and a line are not the same thing, and conflating them is what makes a
/// tax engine India-shaped. 12% GST in Karnataka prints as two lines of 6%; the
/// same 12% in Singapore prints as one line; 12% across an Indian state border
/// prints as one line called something else again. The arithmetic is identical
/// and only the presentation differs, so the presentation is data.
enum TaxSplit {
  /// One rate, one line. Every VAT country, and every GST country except India.
  NONE
  /// India's constitutional split. A supply INSIDE the state the issuer is
  /// registered in is halved between the centre and the state — `CGST` + `SGST`,
  /// or `UTGST` in a union territory without a legislature. A supply to any
  /// other state is one line for the whole amount, `IGST`.
  ///
  /// The halves are derived from the rule's `line_name` by prefix (`GST` ->
  /// `CGST`/`SGST`/`IGST`), which is exactly how the names are constructed in
  /// law. `regional_line_name` overrides the state half for a union territory.
  INTRA_STATE_HALVES
}

/// Whether a customer's tax identifier has been checked with the authority that
/// issued it.
enum TaxIdStatus {
  NOT_PROVIDED
  /// Given, not yet checked. Treated as absent when deciding reverse charge.
  UNVALIDATED
  VALID
  /// Checked and refused. Kept rather than blanked, so the customer is not asked
  /// for it again in a loop and support can see what happened.
  INVALID
}

/// The kind of tax a registration is for. Determines which engine handles it.
enum TaxScheme {
  GST
  VAT
  SALES_TAX
}

enum InvoiceLineKind {
  SUBSCRIPTION
  PRORATION_CREDIT
  PRORATION_CHARGE
  TAX
  ADJUSTMENT
}

/// The lifecycle of one inbound webhook delivery.
///
/// IGNORED is a success, not a failure: providers send event types we do not
/// act on, and recording that we saw and dismissed one is what makes the ledger
/// answer "did we ever receive this?" rather than only "did we act on it?".
enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LOCKED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RoleScopeLevel {
  PLATFORM
  ORGANIZATION
  BRANCH
}

enum OverrideEffect {
  GRANT
  DENY
}

enum AuthTokenPurpose {
  LOGIN_OTP
  PASSWORD_RESET
  VERIFY_EMAIL
  VERIFY_PHONE
  INVITE_ACCEPT
}

enum SettingScopeType {
  PLATFORM
  ORGANIZATION
  BRANCH
  USER
  PATIENT
  DOCTOR
}

enum SettingDataType {
  STRING
  INT
  BOOL
  DECIMAL
  JSON
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  SWITCH_BRANCH
  IMPERSONATE
  PERMISSION_CHANGE
}

/// What KIND of node this is in the clinical taxonomy tree.
///
/// ⚠️ THIS IS A LABEL, NOT A DEPTH. Nothing in the database or the services
///   asserts that a SUB_SPECIALTY sits exactly three levels down, and nothing
///   should start. The tree's shape is `parent_id` and only `parent_id`:
///
///     Medical → Cardiology → Interventional Cardiology → Structural Heart
///     DOMAIN    DEPARTMENT   SPECIALTY                   SUB_SPECIALTY
///
///     Dental  → Endodontics
///     DOMAIN    SPECIALTY
///
///   Both are valid. A branch that needs four levels and one that needs two are
///   the same shape to every query here, which is the whole point — the moment
///   a `depth` column or a fixed domain/department/specialty column triple
///   appears, adding a fifth level becomes a migration instead of a row.
///
/// The type exists so the UI can LABEL a cascading selector ("Clinical Domain",
/// "Sub-specialty") and so reporting can roll up consistently. It is presentation
/// and grouping metadata. Never branch authorization on it.
enum TaxonomyNodeType {
  /// Tree root — Medical, Dental, Allied Health. Practically never assigned to
  /// a doctor directly.
  DOMAIN
  /// A broad grouping that a hospital would plausibly also run as an org unit.
  /// ⚠️ Still the CLINICAL concept, not `branches` and not an org chart.
  DEPARTMENT
  SPECIALTY
  SUB_SPECIALTY
  /// Narrower than a sub-specialty and not a recognised training pathway —
  /// "Sports Rehabilitation" under Physiotherapy.
  FOCUS_AREA
  /// The finest grain. ⚠️ NOT a procedure — see the note on `Specialty`.
  EXPERTISE
}

/// How deeply a doctor practises one node. ADVISORY AND DISPLAY-ONLY.
///
/// ⚠️ NEVER an authorization input. "Is this doctor allowed to do X" is a
///   permission question answered by `membership_roles`, and answering it from
///   a self-declared proficiency label would make a profile edit a privilege
///   escalation. This exists so a directory can say "Expert in" rather than
///   "Practises", and for nothing else.
enum SpecialtyProficiency {
  PRACTISING
  SPECIALIST
  EXPERT
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
  /// Retired from practice here. Kept because prescriptions reference them.
  ARCHIVED
}

/// LEAVE and BLOCK remove availability; EXTRA_SHIFT adds it.
enum ScheduleExceptionType {
  LEAVE
  BLOCK
  EXTRA_SHIFT
}

/// Only APPROVED exceptions affect the availability engine. A REQUESTED leave
/// shows on the doctor's own calendar as pending and changes nothing else.
enum ScheduleExceptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// ⚠️ NOT A CLOSED SET IN THE REAL WORLD, AND STORED AS AN ENUM ANYWAY.
///   `OTHER` carries every identity these four labels do not, and `UNKNOWN` is
///   the honest answer for an unconscious patient at the desk — which is a
///   different fact from `OTHER` and must not collapse into it. Free text was
///   the alternative and it makes "how many female patients over 60" a
///   question about spelling. India's ABDM vocabulary is M/F/O, which these map
///   onto without losing the unrecorded case.
enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

/// The eight ABO/Rh groups plus the unrecorded case. `UNKNOWN` is the default
/// because a blank blood group and O-negative must never look alike.
enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  SEPARATED
  UNKNOWN
}

/// `DECEASED` is a clinical fact and NOT a soft delete — the record stays
/// readable, billable and auditable. `MERGED` marks the losing side of a
/// duplicate merge; it keeps resolving so an old appointment still names a
/// patient. Neither is `deleted_at`, which is erasure under the DPDP Act.
enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  MERGED
}

enum PatientRegistrationStatus {
  ACTIVE
  INACTIVE
}

enum AddressType {
  HOME
  WORK
  OTHER
}

/// `OTHER` covers latex, contrast media and everything else that is neither a
/// marketed drug nor a food.
enum AllergenType {
  DRUG
  FOOD
  ENVIRONMENT
  OTHER
}

/// ⚠️ DECLARATION ORDER IS LOAD-BEARING — see `PatientConditionStatus`. The
/// allergy list is read `ORDER BY severity DESC`, so SEVERE comes first, which
/// is the order a prescriber needs it in.
enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

/// `CHRONIC` is not "active for a long time" — it changes what the medication
/// list means. A chronic condition never resolves and its drugs are expected to
/// be ongoing; an ACTIVE one is expected to end.
/// ⚠️ DECLARATION ORDER IS LOAD-BEARING. It is the Postgres enum's sort order,
/// and the problem list is read `ORDER BY status ASC` so that an active or
/// chronic problem is never rendered below a resolved one. Same reasoning as
/// `AllergySeverity`, which is declared MILD→SEVERE and read `DESC`.
enum PatientConditionStatus {
  ACTIVE
  CHRONIC
  RESOLVED
}

/// Why the patient is coming. Billing reads this later — a follow-up inside the
/// free window is not chargeable — which is why WALK_IN is a visit type rather
/// than only a `source`: the walk-in that becomes a booking still needs to bill
/// as a walk-in.
enum AppointmentVisitType {
  NEW
  FOLLOW_UP
  WALK_IN
  TELECONSULT
  PROCEDURE
}

/// Who made the booking. Kept apart from `visitType` because "a follow-up booked
/// on WhatsApp" is two independent facts, and the online-booking setting is
/// enforced against this one.
enum AppointmentSource {
  FRONT_DESK
  ONLINE
  PHONE
  WHATSAPP
}

/// ⚠️ DECLARATION ORDER IS LOAD-BEARING — it is the Postgres enum's sort order,
///   and the day board is read `ORDER BY scheduled_start, status` so that a
///   patient still waiting sorts above one already seen.
///
/// The two terminal states are not interchangeable: CANCELLED is somebody's
/// decision and NO_SHOW is the absence of one. Both free the slot; only the
/// second is a fact about the patient.
/// How often a doctor is paid. Recorded beside the amount on
/// `doctor_compensation`; nothing computes a payout from it yet.
///
/// ⚠️ `PER_SESSION` OVERLAPS WITH THE CONSULTATION FEE AND IS NOT THE SAME
///   THING. The fee is what the PATIENT pays for an appointment; this is what
///   the CLINIC pays the doctor for turning up to a sitting. A visiting
///   consultant can have both.
enum PayoutInterval {
  MONTHLY
  FORTNIGHTLY
  WEEKLY
  DAILY
  HOURLY
  PER_SESSION
}

/// Who asked for an appointment to be moved.
///
/// ⚠️ THIS EXISTS SO THE CLINIC IS NEVER CHARGED FOR ITS OWN LEAVE. A
///   patient-initiated move adds the `RESCHEDULE` fee; a clinic-initiated one
///   adds nothing. Before this column the system could not tell the two apart,
///   and the only safe default would have been to charge nobody.
enum RescheduleInitiator {
  PATIENT
  CLINIC
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// =============================================================================
// TENANCY
// =============================================================================

/// The tenant. A single-location clinic and a 3-branch hospital are the same
/// shape: one organization, one or three branches.
model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  /// Subdomain label. `alpha` -> alpha.xyz.com
  slug        String             @unique @db.VarChar(63)
  legalName   String             @map("legal_name") @db.VarChar(255)
  displayName String             @map("display_name") @db.VarChar(255)
  orgType     OrganizationType   @default(CLINIC) @map("org_type")
  status      OrganizationStatus @default(PENDING)
  currency    String             @default("INR") @db.Char(3)
  timezone    String             @default("Asia/Kolkata") @db.VarChar(64)
  countryCode String             @default("IN") @map("country_code") @db.Char(2)
  /// Sub-national jurisdiction, where tax depends on one. `KA` for Karnataka,
  /// `CA` for California — the part after the country in ISO 3166-2.
  ///
  /// India needs this and a country code is not enough: a supply from our
  /// Karnataka registration to a Karnataka clinic is CGST+SGST, and to a Kerala
  /// clinic it is IGST. Same country, same rate, different taxes, different
  /// returns. Null means "not captured", which forces the inter-state treatment
  /// — the safe direction, because IGST is fully creditable to the customer
  /// whereas a wrongly-split CGST/SGST is not.
  regionCode  String?            @map("region_code") @db.VarChar(10)
  /// The clinic's own tax identifier, whatever its country calls it — a GSTIN in
  /// India, a TRN in the UAE, a VAT number in Ireland, an ABN in Australia.
  /// `locale.ts` supplies the label, the format and the example per country;
  /// nothing here assumes which.
  ///
  /// ⚠️ THIS IS THE CLINIC AS RCLN'S CUSTOMER, NOT AS AN ISSUER. It is what goes
  ///   on the SUBSCRIPTION invoice rcln raises against the clinic, and what
  ///   decides reverse charge if the clinic is ever in a VAT country. The number
  ///   the clinic prints on invoices it raises against ITS OWN patients lives in
  ///   `issuer_tax_registrations`, effective-dated, because one business can hold
  ///   several. Do not read this one when issuing a patient invoice.
  ///
  /// ⚠️ AND IT IS NOW DERIVED, NOT TYPED. The registration is the authoritative
  ///   record; this column is a cache of the one that currently applies to the
  ///   organization, maintained by `syncOrganizationTaxIdentity` whenever the
  ///   registrations or their coverage change. It is no longer editable through
  ///   the organization API, because two independently maintained copies of one
  ///   GSTIN is precisely how a clinic ends up billing under a number its own
  ///   settings screen disagrees with.
  taxId       String?            @map("tax_id") @db.VarChar(32)
  /// Whether that identifier has been checked against the issuing authority.
  ///
  /// It decides the TREATMENT, not just data quality: an EU business with a
  /// VIES-valid VAT number is reverse-charged and pays no VAT to us, and the
  /// same business with an unvalidated one is charged at its country's consumer
  /// rate. Guessing VALID is revenue we never collected and cannot reclaim.
  taxIdStatus TaxIdStatus        @default(NOT_PROVIDED) @map("tax_id_status")
  ownerUserId String?            @map("owner_user_id") @db.Uuid
  onboardedAt DateTime?          @map("onboarded_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(6)

  owner                  User?                      @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  domains                OrganizationDomain[]
  branches               Branch[]
  memberships            Membership[]
  roles                  Role[]
  invitations            Invitation[]
  subscriptions          Subscription[]
  subscriptionInvoices   SubscriptionInvoice[]
  subscriptionChanges    SubscriptionChange[]
  issuerTaxRegistrations IssuerTaxRegistration[]
  taxRegistrationBranches IssuerTaxRegistrationBranch[]
  taxRules               TaxRule[]
  paymentMandates        PaymentMandate[]
  paymentIntents         PaymentIntent[]
  usageCounters          UsageCounter[]
  files                  StoredFile[]
  auditLogs              AuditLog[]
  dataAccessLogs         DataAccessLog[]
  numberSequences        NumberSequence[]
  specialties            Specialty[]
  qualifications         Qualification[]
  designations           Designation[]
  roleDesignations       RoleDesignation[]
  doctorProfiles         DoctorProfile[]
  doctorSpecialties      DoctorSpecialty[]
  doctorQualifications   DoctorQualification[]
  doctorBranchSettings   DoctorBranchSetting[]
  doctorCompensation     DoctorCompensation[]
  feeScheduleEntries     FeeScheduleEntry[]
  appointmentReschedules AppointmentReschedule[]
  doctorSchedules        DoctorSchedule[]
  doctorExceptions       DoctorScheduleException[]
  patients               Patient[]
  patientRegistrations   PatientRegistration[]
  patientAddresses       PatientAddress[]
  patientContacts        PatientContact[]
  patientAllergies       PatientAllergy[]
  patientConditions      PatientCondition[]
  patientMedications     PatientMedication[]
  appointments           Appointment[]
  appointmentHistory     AppointmentStatusHistory[]
  appointmentVitals      AppointmentVital[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  invoiceTaxes           InvoiceTax[]
  invoiceDocuments       InvoiceDocument[]
  lastForPlatformAdmins  User[]                     @relation("PlatformAdminLastOrganization")

  @@unique([id, slug])
  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
}

/// Every host the tenant is reachable on. The platform subdomain is created at
/// registration; custom domains (portal.pmcs.com) are verified later.
model OrganizationDomain {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  domain         String    @unique @db.VarChar(255)
  isPrimary      Boolean   @default(false) @map("is_primary")
  isPlatformSub  Boolean   @default(true) @map("is_platform_subdomain")
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_domains")
}

/// A physical location. PMCS branch A / B / C are three rows here.
model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(32)
  name           String       @db.VarChar(255)
  branchType     BranchType   @default(CLINIC) @map("branch_type")
  timezone       String       @default("Asia/Kolkata") @db.VarChar(64)
  phone          String?      @db.VarChar(20)
  email          String?      @db.VarChar(255)
  addressLine1   String?      @map("address_line1") @db.VarChar(255)
  addressLine2   String?      @map("address_line2") @db.VarChar(255)
  city           String?      @db.VarChar(100)
  /// The state as it is printed on an address — "Karnataka". Free text, for
  /// humans. `regionCode` is what the tax engine reads; the two are separate
  /// because "Karnataka", "KARNATAKA" and "Karnatak" are the same address and
  /// three different lookup keys.
  state          String?      @db.VarChar(100)
  pincode        String?      @db.VarChar(10)
  /// ⚠️ WHERE A PATIENT INVOICE RAISED HERE IS DEEMED TO BE SUPPLIED.
  ///   A clinical service is performed at a place, so the place of supply is the
  ///   BRANCH — not the patient's address, and not the organization's. These two
  ///   columns are what `resolveTax` is handed as `placeOfSupply`, and they pick
  ///   the `issuer_tax_registrations` row whose GSTIN goes on the invoice.
  ///
  ///   Defaulted from the ORGANIZATION when a branch is created, not from this
  ///   column's `IN` — which was the old behaviour and stamped an Irish clinic's
  ///   branches as Indian, so its VAT registration covered nothing and its
  ///   invoices came out untaxed with no error. Both fields are editable per
  ///   branch, because the group that opens in a second state is exactly the case
  ///   the default cannot serve.
  ///
  ///   ⚠️ THIS IS THE FALLBACK FOR SELECTING A REGISTRATION, NOT THE RULE.
  ///     `issuer_tax_registration_branches` states coverage outright; these two
  ///     columns are consulted only for a branch that has no such statement, and
  ///     they remain the place of supply for the RATE either way.
  countryCode    String       @default("IN") @map("country_code") @db.Char(2)
  /// ISO 3166-2 subdivision without the country prefix — `KA`, never `IN-KA`.
  /// NULL means the country-wide registration applies.
  regionCode     String?      @map("region_code") @db.VarChar(10)
  /// ⚠️ DEPRECATED AND UNREACHABLE. NOT THE INVOICING AUTHORITY, AND NEVER WAS.
  ///   `issuer_tax_registrations` plus `issuer_tax_registration_branches` decide
  ///   which number a patient invoice raised at this branch is issued under. This
  ///   column cannot do that job: no scheme, no effective date, no way to express
  ///   a clinic that holds two — reading it would print a number that looks right
  ///   and is unverifiable.
  ///
  ///   It is no longer accepted by the branch API and no longer returned by it.
  ///   The column is kept rather than dropped so that anything typed into it
  ///   before is still recoverable; nothing in the application reads or writes it.
  taxId          String?      @map("tax_id") @db.VarChar(32)
  isPrimary      Boolean      @default(false) @map("is_primary")
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization           Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operatingHours         BranchOperatingHour[]
  closures               BranchClosure[]
  membershipRoles        MembershipRole[]
  membershipOverrides    MembershipPermissionOverride[]
  invitationBranches     InvitationBranch[]
  sessions               Session[]
  lastForMemberships     Membership[]                   @relation("MembershipLastBranch")
  doctorSettings         DoctorBranchSetting[]
  doctorSchedules        DoctorSchedule[]
  doctorExceptions       DoctorScheduleException[]
  patientRegistrations   PatientRegistration[]
  appointments           Appointment[]
  appointmentVitals      AppointmentVital[]
  appointmentReschedules AppointmentReschedule[]
  feeScheduleEntries     FeeScheduleEntry[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  invoiceTaxes           InvoiceTax[]
  invoiceDocuments       InvoiceDocument[]
  taxRegistrationCoverage IssuerTaxRegistrationBranch[]

  @@unique([organizationId, code])
  /// Composite-FK target: children reference (organization_id, id) so a row can
  /// never point at a branch belonging to a different tenant.
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("branches")
}

model BranchOperatingHour {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") @db.SmallInt
  opensAt     DateTime @map("opens_at") @db.Time(0)
  closesAt    DateTime @map("closes_at") @db.Time(0)
  isClosed    Boolean  @default(false) @map("is_closed")
  slotMinutes Int      @default(15) @map("slot_minutes") @db.SmallInt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_operating_hours")
}

model BranchClosure {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  closureDate DateTime @map("closure_date") @db.Date
  reason      String?  @db.VarChar(255)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, closureDate])
  @@map("branch_closures")
}

// =============================================================================
// SUBSCRIPTIONS (the platform bills the clinic)
// =============================================================================

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(255)
  tagline   String?  @db.VarChar(255)
  trialDays Int      @default(14) @map("trial_days") @db.SmallInt
  isPublic  Boolean  @default(true) @map("is_public")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Where rcln itself is registered to collect tax.
///
/// ⚠️ THIS TABLE IS THE AUTHORITY ON WHETHER TAX MAY BE CHARGED AT ALL, AND THAT
///    IS A LEGAL QUESTION RATHER THAN AN ARITHMETIC ONE.
///   Charging tax in a jurisdiction we hold no registration for is collecting
///   money we have no authority to collect, and it cannot be fixed by remitting
///   it later — there is nobody to remit it to. So the tax engine charges
///   nothing unless a row here covers the place of supply, and records
///   `NOT_REGISTERED` on the invoice saying so. An empty table means every
///   supply is untaxed, which is the correct behaviour for a business that has
///   not registered anywhere yet.
///
/// NOT TENANT-SCOPED, AND NOT A CATALOGUE EITHER
///   It describes the SUPPLIER — us — not any clinic. There is one set of rows
///   for the whole platform, like `plans`. It is listed in EXEMPT in
///   check-rls.ts with that reason.
///
/// ONE ROW PER PLACE WE REGISTERED SEPARATELY
///   India issues a GSTIN per state, so a multi-state presence is several rows
///   with the same `country_code` and different `region_code`. A country-wide
///   registration — most VAT regimes, and India's OIDAR route for a foreign
///   supplier — is one row with `region_code` NULL.
model TaxRegistration {
  id                 String    @id @default(uuid()) @db.Uuid
  countryCode        String    @map("country_code") @db.Char(2)
  /// ISO 3166-2 subdivision, without the country prefix. NULL = country-wide.
  regionCode         String?   @map("region_code") @db.VarChar(10)
  scheme             TaxScheme
  /// Our number in that jurisdiction, printed on every invoice it covers.
  registrationNumber String    @map("registration_number") @db.VarChar(64)
  /// The rate to charge, in basis points, for the digital-services category we
  /// sell in. 18% GST is 1800.
  ///
  /// Held here rather than in a rate table because a rate table for the world is
  /// a subscription to a tax provider, not a column — see the header of
  /// `@rcln/tax`. One rate per registration is honest for the jurisdictions a
  /// business registers in early, and the provider engine ignores it entirely.
  standardRateBps    Int       @map("standard_rate_bps")
  /// When this registration took effect. A supply before it is not taxable by
  /// us even though the row exists, which matters for the first invoices after
  /// registering.
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  /// When it lapsed, if it has. Kept rather than deleted so historical invoices
  /// remain explicable.
  effectiveTo        DateTime? @map("effective_to") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// `region_code` is nullable, so this needs NULLS NOT DISTINCT to actually
  /// constrain the country-wide rows — appended by hand to the migration, as
  /// ADR-0004 requires.
  @@unique([countryCode, regionCode, scheme])
  @@index([countryCode])
  @@map("tax_registrations")
}

/// Where a CLINIC is registered to collect tax. The tenant-scoped twin of
/// `tax_registrations`.
///
/// ⚠️ THIS IS NOT `tax_registrations` AND MUST NEVER BE MERGED WITH IT.
///   That table holds rcln's own numbers and answers "may WE charge this clinic
///   for its subscription?". This one holds the clinic's numbers and answers
///   "may THIS CLINIC charge its patient?". Different issuer, different
///   authority, different return. They are the same shape for the same reason
///   two businesses fill in the same form, and `@rcln/tax` reads both through
///   one `IssuerRegistration` interface precisely so neither can learn which of
///   the two it is serving.
///
/// TENANT-SCOPED, WHERE ITS TWIN IS EXEMPT
///   The reasoning that exempts `tax_registrations` — a policy would return zero
///   rows inside a tenant transaction and every invoice would silently come out
///   untaxed — does not apply here, because these rows ARE the tenant's. It gets
///   an ordinary `tenant_isolation` policy, and one clinic reading another's
///   GSTIN would be a straightforward tenancy leak.
///
/// ONE ROW PER REGISTRATION THE CLINIC ACTUALLY HOLDS, AND NOT ONE PER PLACE
///   India issues a GSTIN per state, so a group with branches in Karnataka and
///   Kerala usually holds two rows and its two branches bill under different
///   numbers. USUALLY, not always, and the table must not assume it:
///
///   - a clinic may hold NONE (below the registration threshold),
///   - it may hold two in ONE jurisdiction — India has allowed a second GSTIN per
///     state for a separate business vertical since 2019,
///   - and it keeps the ones it no longer uses, because an invoice raised today
///     for last year's consultation has to cite the number in force THEN.
///
///   So the key is (organization, country, scheme, NUMBER): you cannot record the
///   same registration twice, and everything else is a business fact rather than
///   a constraint. What a registration COVERS is stated in
///   `issuer_tax_registration_branches`, not inferred from geography.
model IssuerTaxRegistration {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  countryCode        String    @map("country_code") @db.Char(2)
  /// ISO 3166-2 subdivision, without the country prefix. NULL = country-wide.
  regionCode         String?   @map("region_code") @db.VarChar(10)
  scheme             TaxScheme
  /// The clinic's number in that jurisdiction, printed on every invoice it
  /// covers. Snapshotted onto the invoice at issue, never re-read afterwards.
  registrationNumber String    @map("registration_number") @db.VarChar(64)
  /// The name the registration is held in, which is not always the name over
  /// the door. A GST invoice must print the registered legal name.
  legalName          String?   @map("legal_name") @db.VarChar(255)
  /// When this registration took effect. A supply before it is not taxable by
  /// the clinic even though the row exists.
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  /// When it lapsed, if it has. Kept rather than deleted so historical invoices
  /// remain explicable.
  effectiveTo        DateTime? @map("effective_to") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  branchCoverage IssuerTaxRegistrationBranch[]

  /// ⚠️ THE NUMBER, NOT THE JURISDICTION, IS WHAT CANNOT REPEAT.
  ///   This used to be (organization, country, region, scheme), which read as
  ///   "one registration per place" and made two true things unrecordable: a
  ///   second concurrent registration in one state, and a lapsed registration
  ///   kept alongside the one that replaced it. Both are ordinary. Recording the
  ///   SAME number twice is not, and is what this key still refuses.
  ///
  ///   Selecting between several live registrations is therefore a matter of
  ///   coverage rather than of uniqueness — see the branch link table.
  @@unique([organizationId, countryCode, scheme, registrationNumber])
  /// Composite-FK target: `invoices` and `issuer_tax_registration_branches`
  /// reference (organization_id, id) so neither can point at another tenant's
  /// registration.
  @@unique([organizationId, id])
  @@index([organizationId, countryCode])
  @@map("issuer_tax_registrations")
}

/// WHICH BRANCHES A REGISTRATION COVERS. Stated by the clinic, never inferred.
///
/// ⚠️ THIS TABLE EXISTS BECAUSE COVERAGE IS A BUSINESS FACT AND ADDRESSES ARE NOT
///   EVIDENCE OF IT. Before it, "which branches does this GSTIN cover?" was
///   answered by matching the branch's (country, region) against the
///   registration's — so the answer was *whichever branches happen to sit in the
///   same state*, and a clinic could not say otherwise. That silently forbids
///   three shapes the business genuinely has: two branches in one state billing
///   under two different numbers, one number deliberately covering only some of
///   the branches in its state, and any arrangement in a country whose
///   registrations are not drawn on state lines at all.
///
/// A BRANCH WITH NO ROW HERE FALLS BACK TO JURISDICTION MATCHING, and that
///   fallback is what makes this table additive rather than a migration of
///   behaviour. A clinic that never opens the coverage screen bills exactly as it
///   did before; the moment it states coverage for a branch, the statement wins.
///
/// ⚠️ AT MOST ONE LIVE REGISTRATION PER (BRANCH, SCHEME) — enforced in the
///   service, not here, because "live" is a date range and Postgres cannot
///   express the overlap in a unique index without an exclusion constraint over
///   a join. Two live GSTINs on one branch is not a richer configuration, it is
///   an invoice whose number depends on planner order.
model IssuerTaxRegistrationBranch {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  taxRegistrationId String    @map("tax_registration_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite FKs, per ADR-0004: the tenant travels in the key, so a link can
  /// never join this org's branch to another org's registration.
  registration IssuerTaxRegistration @relation(fields: [organizationId, taxRegistrationId], references: [organizationId, id], onDelete: Cascade)
  branch       Branch                @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, taxRegistrationId, branchId])
  @@index([organizationId, branchId])
  @@index([organizationId, taxRegistrationId])
  @@map("issuer_tax_registration_branches")
}

/// What ONE KIND OF THING is taxed at, here, on this date.
///
/// ⚠️ THE REASON A RATE CANNOT LIVE ON THE REGISTRATION.
///   `tax_registrations.standard_rate_bps` is one rate per place, which is
///   honest when you sell one product. A clinic sells several with genuinely
///   different treatments: in India a consultation is EXEMPT, medicines are 5%
///   or 12%, most consumables are 12% or 18%. Billing a consultation at the
///   registration's standard rate is not a rounding error — it charges GST on
///   an exempt supply, which the clinic then owes to the government on money it
///   should never have collected.
///
/// EFFECTIVE-DATED, BECAUSE RATES CHANGE AND OLD INVOICES MUST STILL EXPLAIN
///   A rate change is a new row, not an edit: `effective_to` on the old one is
///   the day BEFORE `effective_from` on the new one, which is how a rate
///   notification reads. Both ends are inclusive. An invoice issued last year
///   remains explicable because the row that priced it is still here.
///
/// ⚠️ `treatment` IS CONSTRAINED TO THREE VALUES BY A CHECK, NOT BY THE ENUM.
///   An item can be STANDARD, ZERO_RATED or EXEMPT. It can never be
///   REVERSE_CHARGE (a fact about the two parties) or NOT_REGISTERED / UNRATED
///   (facts about the issuer). Prisma cannot express a subset of an enum, so
///   the constraint is hand-appended to the migration — without it a catalogue
///   row could assert a legal position it knows nothing about. Mirrored in TS
///   as `ItemTaxTreatment`.
model TaxRule {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  countryCode      String       @map("country_code") @db.Char(2)
  /// ISO 3166-2 subdivision, without the country prefix. NULL = country-wide,
  /// which is what almost every GST rate is — the rate is national even though
  /// the registration is per state.
  regionCode       String?      @map("region_code") @db.VarChar(10)
  scheme           TaxScheme
  /// The item key. An HSN/SAC code (`999312`, `3004`) or a clinic's own category
  /// (`CONSULTATION`). Matched EXACTLY against the item's category — there is no
  /// HSN prefix-tree here, deliberately, because a prefix match that silently
  /// finds a broader heading is how the wrong rate gets applied confidently.
  taxCategory      String       @map("tax_category") @db.VarChar(64)
  /// What a human calls it on the rate-configuration screen. Never printed on an
  /// invoice — the invoice prints the tax LINE's name (`CGST`), not this.
  description      String?      @db.VarChar(255)
  /// Basis points. 5% is 500. Must be 0 when `treatment` is not STANDARD.
  rateBps          Int          @map("rate_bps")
  treatment        TaxTreatment @default(STANDARD)
  /// ⚠️ WHAT THE AUTHORITY CALLS THIS TAX, PRINTED VERBATIM ON THE INVOICE.
  ///   `GST`, `VAT`, `HST`, `PST`, `QST`, `Sales Tax`. It is per-RULE and not
  ///   per-country because a single country needs several: an Ontario clinic
  ///   charges one 13% `HST` line, a British Columbia one charges 5% `GST` plus
  ///   7% `PST`, and both are Canada. A generic "Tax" is not compliant anywhere.
  lineName         String       @map("line_name") @db.VarChar(32)
  /// The state half's name when `split` is INTRA_STATE_HALVES. NULL derives it
  /// from `line_name` (`GST` -> `SGST`), which is right for a state and wrong
  /// for a union territory, where it is `UTGST`.
  regionalLineName String?      @map("regional_line_name") @db.VarChar(32)
  split            TaxSplit     @default(NONE)
  /// Whether this rule applies IN ADDITION to the country-wide rule for the same
  /// category, rather than instead of it.
  ///
  /// ⚠️ THE DIFFERENCE BETWEEN CANADA AND EVERYWHERE ELSE. A region-specific
  ///   rule normally OVERRIDES the country-wide one — an Indian state rate
  ///   replaces the national rate. In Canada it STACKS: federal GST at 5% is
  ///   charged as well as provincial PST at 7%, as two separate lines owed to
  ///   two separate authorities. US state + county + city would stack the same
  ///   way, three deep, if this engine ever computed them (it does not — see
  ///   PROVIDER_REQUIRED).
  ///
  ///   A stacking rule is only ever regional; a country-wide rule that stacked
  ///   would stack on itself. Enforced by CHECK.
  stacks           Boolean      @default(false)
  effectiveFrom    DateTime     @map("effective_from") @db.Date
  effectiveTo      DateTime?    @map("effective_to") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceTaxes InvoiceTax[]

  /// ⚠️ Needs NULLS NOT DISTINCT, same as the registration above — appended by
  ///   hand. It stops two rules for one category starting on the same day; it
  ///   does NOT stop overlapping ranges, which is why `ruleFor` resolves ties by
  ///   taking the latest `effective_from` rather than trusting the row order.
  @@unique([organizationId, countryCode, regionCode, scheme, taxCategory, effectiveFrom])
  /// Composite-FK target, so `invoice_taxes` can cite the rule that priced it.
  @@unique([organizationId, id])
  /// The engine's read: every rule for one category, effective-dated.
  @@index([organizationId, taxCategory, effectiveFrom])
  @@map("tax_rules")
}

/// The rate cards rcln maintains, which every clinic inherits until it says
/// otherwise. The platform-owned twin of `tax_rules`.
///
/// ⚠️ THE DEFAULTS ARE INHERITED, NEVER COPIED INTO A TENANT.
///   The obvious implementation — seed a clinic's `tax_rules` from this table at
///   registration — is a trap, and it is worth stating why because it is the
///   change somebody will eventually propose:
///
///     1. A rate change becomes a migration across every tenant, instead of one
///        effective-dated INSERT here.
///     2. It permanently destroys the difference between "this clinic chose 12%"
///        and "this is a stale copy of our 2025 default". Both are just rows.
///     3. A clinic that never touches its rate card keeps an obsolete rate for
///        ever — and its screen shows it as fully configured, so nobody looks.
///
///   Resolution is therefore at READ time: a tenant rule wins, else this table,
///   else `UNRATED`. Exactly the shape of `setting_definitions` /
///   `setting_values`, which solved this problem here first. See `rulesFor`.
///
/// ⚠️ A CLINIC THAT OVERRIDES A CATEGORY OWNS IT COMPLETELY.
///   Resolution is all-or-nothing per tax category, not per row. If a tenant
///   holds ANY applicable rule for a category, its whole set is used and this
///   table is ignored for that category. Mixing a tenant's base rate with an
///   inherited stacked provincial tax would produce a combination nobody
///   authored and nobody could explain to an auditor.
///
/// NOT TENANT-SCOPED, AND NOT A LEGAL CLAIM EITHER
///   One set of rows for the whole platform, like `plans`. Unlike
///   `tax_registrations` it asserts nothing about who is registered where — it
///   says only "in this country, this kind of thing is taxed like this", and it
///   has no effect at all on a clinic holding no registration. That is why this
///   table IS seeded and that one deliberately is not.
model TaxRuleDefault {
  id               String       @id @default(uuid()) @db.Uuid
  countryCode      String       @map("country_code") @db.Char(2)
  /// ISO 3166-2 subdivision, without the country prefix. NULL = country-wide,
  /// which is what almost every published rate is.
  regionCode       String?      @map("region_code") @db.VarChar(10)
  scheme           TaxScheme
  taxCategory      String       @map("tax_category") @db.VarChar(64)
  /// What a human calls it in the platform console. Never printed on an invoice.
  description      String?      @db.VarChar(255)
  rateBps          Int          @map("rate_bps")
  treatment        TaxTreatment @default(STANDARD)
  lineName         String       @map("line_name") @db.VarChar(32)
  regionalLineName String?      @map("regional_line_name") @db.VarChar(32)
  split            TaxSplit     @default(NONE)
  stacks           Boolean      @default(false)
  /// ⚠️ WHERE THIS FIGURE CAME FROM, IN WORDS A HUMAN CAN CHECK.
  ///   A rate with no provenance is a rate nobody can verify, and this table is
  ///   the one place a wrong number becomes wrong invoices for every clinic in a
  ///   country at once. Name the notification, the schedule, or the section.
  sourceNote       String?      @map("source_note") @db.VarChar(500)
  effectiveFrom    DateTime     @map("effective_from") @db.Date
  effectiveTo      DateTime?    @map("effective_to") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  invoiceTaxes InvoiceTax[]

  /// ⚠️ NULLS NOT DISTINCT, appended by hand — country-wide is the common case
  ///   here, so without it the table does not constrain its own primary shape.
  @@unique([countryCode, regionCode, scheme, taxCategory, effectiveFrom])
  @@index([countryCode, taxCategory, effectiveFrom])
  @@map("tax_rule_defaults")
}

model PlanPrice {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  currency        String          @default("INR") @db.Char(3)
  billingInterval BillingInterval @map("billing_interval")
  amount          Decimal         @db.Decimal(14, 2)
  /// Whether `amount` already includes tax. See `TaxBehavior`.
  taxBehavior     TaxBehavior     @default(EXCLUSIVE) @map("tax_behavior")
  isActive        Boolean         @default(true) @map("is_active")

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([planId, currency, billingInterval])
  @@map("plan_prices")
}

/// Entitlements. Runtime resolution order:
/// subscription_feature_overrides -> plan_features -> hard default in code.
model PlanFeature {
  id         String           @id @default(uuid()) @db.Uuid
  planId     String           @map("plan_id") @db.Uuid
  featureKey String           @map("feature_key") @db.VarChar(64)
  valueType  FeatureValueType @map("value_type")
  intValue   Int?             @map("int_value")
  boolValue  Boolean?         @map("bool_value")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

/// What a clinic is paying for, and where it is in the cycle.
///
/// ⚠️ THE BILLING CLOCK IS OURS, NOT THE PROVIDER'S (ADR-0013).
///   `current_period_end` is the authority on when the next charge happens, and
///   the worker's due-sweep reads it. Cashfree's own subscription object is used
///   only as a mandate holder (`payment_mandates`) — it has no schedule of its
///   own, so a provider swap does not move a single renewal date.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  planPriceId        String             @map("plan_price_id") @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  /// The currency this subscription is billed in, fixed at subscribe time.
  ///
  /// Denormalised from `plan_prices` on purpose. A plan may gain, lose or
  /// re-price a currency at any time, and none of that may silently change what
  /// an existing customer is charged in — an upgrade must find a price in THIS
  /// currency or be refused. Reading it off the joined price would make the
  /// answer depend on the catalogue's current state rather than on the contract.
  currency           String             @default("INR") @db.Char(3)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  /// When a scheduled cancellation takes effect. Always `current_period_end`
  /// for a cancel-at-period-end; `now()` for an immediate one.
  cancelAt           DateTime?          @map("cancel_at") @db.Timestamptz(6)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  /// Set the moment the customer asks to cancel; the subscription keeps running
  /// and keeps its entitlements until `cancel_at`. Separate from `canceled_at`
  /// because "has asked to leave" and "has left" are different states and the
  /// screen has to say which one the clinic is in.
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  /// Free text from the cancellation form. Never a patient-identifying string.
  cancelReason       String?            @map("cancel_reason") @db.VarChar(500)
  /// Whether the renewal engine may debit the mandate unattended.
  ///
  /// NOT derivable from `mandate_id IS NOT NULL`: a clinic may hold a live
  /// mandate and still choose to approve every invoice by hand, and turning
  /// auto-renewal off must not throw away the authorisation they already gave.
  autoRenew          Boolean            @default(false) @map("auto_renew")
  seatQuantity       Int                @default(1) @map("seat_quantity")
  /// The provider that holds the money relationship, once there is one.
  provider           String?            @db.VarChar(32)
  mandateId          String?            @map("mandate_id") @db.Uuid
  /// How long access survives a failed renewal. Null outside dunning.
  gracePeriodEnd     DateTime?          @map("grace_period_end") @db.Timestamptz(6)
  dunningAttempts    Int                @default(0) @map("dunning_attempts") @db.SmallInt
  lastRenewalAt      DateTime?          @map("last_renewal_attempt_at") @db.Timestamptz(6)
  /// First successful payment. Null for a subscription still in trial.
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?          @map("ended_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             Plan                          @relation(fields: [planId], references: [id])
  planPrice        PlanPrice                     @relation(fields: [planPriceId], references: [id])
  // Composite, so a subscription can only ever hold a mandate belonging to its
  // own organization — the cross-tenant version is unrepresentable (ADR-0004).
  // NoAction, not SetNull: the FK spans (organization_id, mandate_id) and
  // organization_id is NOT NULL, so Postgres cannot null half of it. Nothing
  // deletes a mandate anyway — revoking one sets `status = CANCELLED`, which
  // keeps the history of what the customer authorised.
  mandate          PaymentMandate?               @relation(fields: [organizationId, mandateId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  featureOverrides SubscriptionFeatureOverride[]
  invoices         SubscriptionInvoice[]
  intents          PaymentIntent[]
  changes          SubscriptionChange[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([currentPeriodEnd])
  // The due-sweep's query: everything renewable whose period has run out.
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionFeatureOverride {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  featureKey     String   @map("feature_key") @db.VarChar(64)
  intValue       Int?     @map("int_value")
  boolValue      Boolean? @map("bool_value")
  reason         String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureKey])
  @@map("subscription_feature_overrides")
}

/// What was owed for one period. Immutable once issued, in the accounting sense:
/// a mistake is corrected with an adjustment line or a VOID, never by editing
/// the totals of an invoice a customer has already been shown.
model SubscriptionInvoice {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  subscriptionId String                    @map("subscription_id") @db.Uuid
  invoiceNumber  String                    @unique @map("invoice_number") @db.VarChar(64)
  periodStart    DateTime                  @map("period_start") @db.Date
  periodEnd      DateTime                  @map("period_end") @db.Date
  currency       String                    @default("INR") @db.Char(3)
  subtotal       Decimal                   @db.Decimal(14, 2)
  taxAmount      Decimal                   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal                   @db.Decimal(14, 2)
  /// Where this supply was deemed to take place — `IN-KA`, `IE`, `US-CA`.
  ///
  /// For digital services it is the CUSTOMER's location, not ours, in every
  /// regime that matters. It is what selects the rate, so it is snapshotted:
  /// a clinic that later moves state must not retrospectively change the tax on
  /// invoices already issued.
  placeOfSupply  String?                   @map("place_of_supply") @db.VarChar(10)
  /// Why it was taxed the way it was. See `TaxTreatment`.
  taxTreatment   TaxTreatment              @default(NOT_REGISTERED) @map("tax_treatment")
  /// OUR registration number for that place of supply, as printed. Snapshotted
  /// because registrations lapse and change, and a reissued invoice must say
  /// what the original said.
  supplierTaxId  String?                   @map("supplier_tax_id") @db.VarChar(64)
  /// THEIR identifier, as it stood when the invoice was issued. Both numbers are
  /// a legal requirement on a GST invoice and on an EU reverse-charge one.
  customerTaxId  String?                   @map("customer_tax_id") @db.VarChar(64)
  /// Settled so far. A partial payment is a real state — a proration credit can
  /// cover part of an upgrade and leave a smaller balance to collect.
  amountPaid     Decimal                   @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status         SubscriptionInvoiceStatus @default(DRAFT)
  dueDate        DateTime?                 @map("due_date") @db.Date
  paidAt         DateTime?                 @map("paid_at") @db.Timestamptz(6)
  voidedAt       DateTime?                 @map("voided_at") @db.Timestamptz(6)
  /// How many times collection has been attempted. Drives the dunning schedule.
  attemptCount   Int                       @default(0) @map("attempt_count") @db.SmallInt
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lines        SubscriptionInvoiceLine[]
  payments     SubscriptionPayment[]
  intents      PaymentIntent[]
  changes      SubscriptionChange[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([subscriptionId, createdAt])
  @@map("subscription_invoices")
}

model SubscriptionInvoiceLine {
  id                    String          @id @default(uuid()) @db.Uuid
  subscriptionInvoiceId String          @map("subscription_invoice_id") @db.Uuid
  /// A prorated upgrade puts a credit and a charge on one invoice. Without this
  /// the customer sees two lines of arithmetic and has to work out which is
  /// which; with it the screen can label them.
  kind                  InvoiceLineKind @default(SUBSCRIPTION)
  description           String          @db.VarChar(255)
  quantity              Decimal         @default(1) @db.Decimal(14, 3)
  unitAmount            Decimal         @map("unit_amount") @db.Decimal(14, 2)
  lineTotal             Decimal         @map("line_total") @db.Decimal(14, 2)
  /// The stretch of time this line covers, where it covers one. Null for tax.
  periodStart           DateTime?       @map("period_start") @db.Date
  periodEnd             DateTime?       @map("period_end") @db.Date
  /// On a TAX line: the rate applied, in basis points. 18% is 1800.
  ///
  /// ⚠️ SNAPSHOTTED, NEVER LOOKED UP AGAIN. Rates change by statute. An invoice
  ///   that re-reads today's rate would silently restate a two-year-old
  ///   document, which is the kind of thing that is discovered during an audit.
  ///   Basis points and not a decimal so the arithmetic stays in integers.
  taxRateBps            Int?            @map("tax_rate_bps")
  /// What the customer's jurisdiction calls it: CGST, SGST, IGST, VAT.
  /// Printed as-is, because "Tax" on an Indian invoice is not compliant.
  taxName               String?         @map("tax_name") @db.VarChar(32)
  /// Which authority this line is owed to — `IN-KA`, `IE`. One supply can carry
  /// two lines to two authorities; that is exactly what CGST + SGST is.
  taxJurisdiction       String?         @map("tax_jurisdiction") @db.VarChar(10)

  invoice SubscriptionInvoice @relation(fields: [subscriptionInvoiceId], references: [id], onDelete: Cascade)

  @@index([subscriptionInvoiceId])
  @@map("subscription_invoice_lines")
}

/// Money that actually arrived (or did not). One row per attempt, never updated
/// in place from FAILED to SUCCESS — a retry is a new attempt, and collapsing
/// the two loses the fact that the first card was declined.
model SubscriptionPayment {
  id                    String        @id @default(uuid()) @db.Uuid
  subscriptionInvoiceId String        @map("subscription_invoice_id") @db.Uuid
  /// The attempt this settles. Null only for a payment recorded by hand.
  paymentIntentId       String?       @map("payment_intent_id") @db.Uuid
  amount                Decimal       @db.Decimal(14, 2)
  currency              String        @default("INR") @db.Char(3)
  method                String?       @db.VarChar(32)
  /// Last four digits, or a UPI handle's domain. NEVER a full instrument.
  instrumentLabel       String?       @map("instrument_label") @db.VarChar(32)
  gateway               String?       @db.VarChar(32)
  gatewayPaymentId      String?       @map("gateway_payment_id") @db.VarChar(128)
  status                PaymentStatus @default(PENDING)
  failureCode           String?       @map("failure_code") @db.VarChar(64)
  failureMessage        String?       @map("failure_message") @db.VarChar(500)
  refundedAmount        Decimal       @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice SubscriptionInvoice @relation(fields: [subscriptionInvoiceId], references: [id], onDelete: Cascade)
  intent  PaymentIntent?      @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([gateway, gatewayPaymentId])
  @@index([subscriptionInvoiceId])
  @@map("subscription_payments")
}

/// A standing authorisation to debit this clinic without anyone present.
///
/// WHAT IS AND IS NOT STORED HERE
///   The provider's id for the mandate, its ceiling, and a four-digit tail for
///   the customer to recognise it by. No card number, no token that could be
///   replayed by anyone holding this row, and nothing that would let a database
///   dump be turned into a charge. The instrument lives at the provider; this is
///   a pointer to it.
///
/// THE CEILING IS THE CUSTOMER'S CONSENT, AND IT IS ENFORCED TWICE
///   `max_amount` is what the customer saw and approved. The provider enforces
///   it, and the renewal engine checks it before asking — because a debit that
///   is going to be refused should be turned into an invoice the customer can
///   pay by hand, not into a dunning cycle.
model PaymentMandate {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  provider          String        @db.VarChar(32)
  /// The provider's identifier. Null until the provider has accepted it.
  providerMandateId String?       @map("provider_mandate_id") @db.VarChar(128)
  status            MandateStatus @default(PENDING)
  currency          String        @db.Char(3)
  maxAmount         Decimal       @map("max_amount") @db.Decimal(14, 2)
  method            String?       @db.VarChar(32)
  instrumentLabel   String?       @map("instrument_label") @db.VarChar(32)
  activatedAt       DateTime?     @map("activated_at") @db.Timestamptz(6)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(6)
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  intents       PaymentIntent[]

  @@unique([organizationId, id])
  @@unique([provider, providerMandateId])
  @@index([organizationId, status])
  @@map("payment_mandates")
}

/// One attempt to move money, and the row every webhook is matched back to.
///
/// WHY THE ROW EXISTS BEFORE THE PROVIDER IS CALLED
///   Its id IS the idempotency key sent to the provider. Creating it first means
///   a call that times out can be retried with the same reference — the provider
///   deduplicates, and we reconcile rather than charging twice. A row written
///   after a successful call could not do that, because the interesting failure
///   is the one where we never learn whether the call succeeded.
///
/// WHY IT CANNOT GRANT ANYTHING BY ITSELF
///   The return URL is a browser hint and is trivially forged. Entitlement is
///   granted only when the provider says SUCCEEDED — on a verified webhook, or
///   on an explicit `getCharge` — never because a customer arrived back at a
///   page with a success-looking query string.
model PaymentIntent {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  subscriptionId   String?             @map("subscription_id") @db.Uuid
  invoiceId        String?             @map("subscription_invoice_id") @db.Uuid
  /// Set when this is an off-session debit rather than a hosted checkout.
  mandateId        String?             @map("mandate_id") @db.Uuid
  provider         String              @db.VarChar(32)
  providerChargeId String?             @map("provider_charge_id") @db.VarChar(128)
  purpose          PaymentPurpose
  status           PaymentIntentStatus @default(CREATED)
  amount           Decimal             @db.Decimal(14, 2)
  currency         String              @db.Char(3)
  description      String              @db.VarChar(255)
  /// Where the customer was sent, and where they come back to. Both are URLs on
  /// our own hosts; neither carries anything secret, because a browser holds it.
  redirectUrl      String?             @map("redirect_url") @db.Text
  returnUrl        String?             @map("return_url") @db.Text
  method           String?             @db.VarChar(32)
  instrumentLabel  String?             @map("instrument_label") @db.VarChar(32)
  failureCode      String?             @map("failure_code") @db.VarChar(64)
  failureMessage   String?             @map("failure_message") @db.VarChar(500)
  settledAt        DateTime?           @map("settled_at") @db.Timestamptz(6)
  expiresAt        DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription?         @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Cascade)
  invoice      SubscriptionInvoice?  @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  // NoAction for the same reason as on `subscriptions.mandate` above.
  mandate      PaymentMandate?       @relation(fields: [organizationId, mandateId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  payments     SubscriptionPayment[]

  @@unique([organizationId, id])
  @@unique([provider, providerChargeId])
  @@index([organizationId, status])
  @@index([subscriptionId])
  @@map("payment_intents")
}

/// The commercial history of a subscription: what changed, what it cost, and who
/// asked for it.
///
/// SEPARATE FROM `audit_logs` ON PURPOSE. That table records that a row's
/// columns changed, which answers a security question. This one answers a
/// billing question — "why was I charged ₹1,832 on the 14th?" — and the answer
/// has to survive the plan being re-priced afterwards, so the amounts are
/// copied here rather than recomputed from the catalogue.
model SubscriptionChange {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  subscriptionId  String                 @map("subscription_id") @db.Uuid
  changeType      SubscriptionChangeType @map("change_type")
  fromPlanId      String?                @map("from_plan_id") @db.Uuid
  fromPlanPriceId String?                @map("from_plan_price_id") @db.Uuid
  toPlanId        String?                @map("to_plan_id") @db.Uuid
  toPlanPriceId   String?                @map("to_plan_price_id") @db.Uuid
  currency        String                 @db.Char(3)
  /// Unused time on the old plan, as a positive number.
  prorationCredit Decimal                @default(0) @map("proration_credit") @db.Decimal(14, 2)
  /// Remaining time on the new plan, as a positive number.
  prorationCharge Decimal                @default(0) @map("proration_charge") @db.Decimal(14, 2)
  /// charge - credit, floored at zero. We do not refund a downgrade because
  /// there is no downgrade (ADR-0014); a credit larger than the charge would
  /// mean the arithmetic is wrong.
  amountDue       Decimal                @default(0) @map("amount_due") @db.Decimal(14, 2)
  invoiceId       String?                @map("subscription_invoice_id") @db.Uuid
  effectiveAt     DateTime               @map("effective_at") @db.Timestamptz(6)
  /// Who asked. Null for a change the renewal engine made on its own.
  actorUserId     String?                @map("actor_user_id") @db.Uuid
  reason          String?                @db.VarChar(500)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription         @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Cascade)
  // NoAction: composite FK with a NOT NULL organization_id. An invoice is
  // voided, never deleted, so this is unreachable in practice.
  invoice      SubscriptionInvoice? @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, subscriptionId, createdAt])
  @@map("subscription_changes")
}

/// Every webhook delivery we have ever accepted, and what we did with it.
///
/// ⚠️ DELIBERATELY NOT TENANT-SCOPED, AND THAT IS THE POINT
///   A webhook arrives on a public endpoint with no host, no session and no
///   tenant. Which organization it concerns is only known AFTER the signature
///   verifies and the reference resolves — so scoping the table by a tenant we
///   have not yet identified is circular. It is listed in the EXEMPT map in
///   `packages/db/scripts/check-rls.ts` with that reason.
///
///   Deduplication must be global for the same reason: a replayed delivery has
///   to collide whether or not we can work out whose it is. That is what
///   `@@unique([provider, providerEventId])` buys, and it is the only thing
///   standing between a re-sent `charge.succeeded` and a second free month.
///
///   Nothing tenant-identifying is exposed through it. It is read by the
///   platform console and by the worker, never by a tenant-facing route.
model PaymentWebhookEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  provider        String                  @db.VarChar(32)
  /// The provider's own event id, or a hash of the signed bytes when it sends
  /// none. See `WebhookEvent.id` in @rcln/payments.
  providerEventId String                  @map("provider_event_id") @db.VarChar(255)
  eventType       String                  @map("event_type") @db.VarChar(64)
  /// Our `payment_intents` / `payment_mandates` id, once resolved.
  reference       String?                 @db.VarChar(128)
  /// Resolved after the fact, for the console. Not a scoping column.
  organizationId  String?                 @map("organization_id") @db.Uuid
  status          WebhookProcessingStatus @default(RECEIVED)
  attempts        Int                     @default(0) @db.SmallInt
  error           String?                 @db.VarChar(1000)
  /// The provider's payload as received. Retained for reconciliation and the
  /// support desk; it contains billing contact details and never patient data.
  payload         Json
  receivedAt      DateTime                @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?               @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([reference])
  @@map("payment_webhook_events")
}

/// Enforces plan limits (max_branches, max_users) at write time.
model UsageCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  featureKey     String   @map("feature_key") @db.VarChar(64)
  periodStart    DateTime @map("period_start") @db.Date
  usedValue      Decimal  @default(0) @map("used_value") @db.Decimal(14, 2)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey, periodStart])
  @@map("usage_counters")
}

// =============================================================================
// IDENTITY
// =============================================================================

/// ONE table for every human: super admin, doctor, receptionist, patient.
/// Deliberately global (not org-scoped) so one person can hold memberships in
/// several organizations with a single login. There is NO role column here —
/// roles live on membership_roles, scoped per branch.
model User {
  id                         String     @id @default(uuid()) @db.Uuid
  email                      String?    @unique @db.VarChar(255)
  phone                      String?    @unique @db.VarChar(20)
  passwordHash               String?    @map("password_hash") @db.VarChar(255)
  fullName                   String     @map("full_name") @db.VarChar(255)
  avatarFileId               String?    @map("avatar_file_id") @db.Uuid
  status                     UserStatus @default(INVITED)
  /// The seeded platform operator. Bypasses membership checks entirely and can
  /// enter any tenant — every such action is written to audit_logs.
  isPlatformAdmin            Boolean    @default(false) @map("is_platform_admin")
  mfaEnabled                 Boolean    @default(false) @map("mfa_enabled")
  mfaSecret                  String?    @map("mfa_secret") @db.VarChar(255)
  locale                     String     @default("en") @db.VarChar(10)
  /// The clinic this platform admin last worked inside, so the console can offer
  /// it again on their next sign-in instead of making them find it.
  ///
  /// A PREFERENCE, NOT A GRANT. It confers nothing — entering a clinic still goes
  /// through the impersonation handoff, which re-checks `isPlatformAdmin` at
  /// redemption and writes an audit row with a stated reason (ADR-0012). A stale
  /// or deleted organization here is harmless: the console validates it on read
  /// and offers nothing if it no longer resolves.
  ///
  /// It lives on `users` rather than on a tenant table because the person it
  /// describes belongs to no tenant — that is what makes them a platform admin.
  /// Null for everyone else, which is almost everyone.
  lastPlatformOrganizationId String?    @map("last_platform_organization_id") @db.Uuid
  emailVerifiedAt            DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt            DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt                DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedAttempts             Int        @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil                DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  identities                UserIdentity[]
  sessions                  Session[]
  authTokens                AuthToken[]
  memberships               Membership[]
  ownedOrganizations        Organization[]             @relation("OrganizationOwner")
  // SetNull, and safe as a single-column FK on a nullable column: forgetting a
  // preference is the correct outcome when the clinic it named is gone.
  lastPlatformOrganization  Organization?              @relation("PlatformAdminLastOrganization", fields: [lastPlatformOrganizationId], references: [id], onDelete: SetNull)
  invitationsSent           Invitation[]               @relation("InvitedBy")
  auditLogs                 AuditLog[]
  dataAccessLogs            DataAccessLog[]
  uploadedFiles             StoredFile[]
  doctorProfiles            DoctorProfile[]
  /// The portal login for a patient record. Optional on both sides — most
  /// patients never sign up.
  patientRecords            Patient[]
  patientRegistrations      PatientRegistration[]      @relation("PatientRegisteredBy")
  allergiesNoted            PatientAllergy[]           @relation("AllergyNotedBy")
  conditionsNoted           PatientCondition[]         @relation("ConditionNotedBy")
  medicationsNoted          PatientMedication[]        @relation("MedicationNotedBy")
  appointmentsBooked        Appointment[]              @relation("AppointmentBookedBy")
  appointmentsCancelled     Appointment[]              @relation("AppointmentCancelledBy")
  appointmentStatusChanges  AppointmentStatusHistory[] @relation("AppointmentStatusChangedBy")
  vitalsRecorded            AppointmentVital[]         @relation("VitalRecordedBy")
  vitalsAmended             AppointmentVital[]         @relation("VitalSupersededBy")
  invoicesCreated           Invoice[]                  @relation("InvoiceCreatedBy")
  invoicesIssued            Invoice[]                  @relation("InvoiceIssuedBy")
  invoicesCancelled         Invoice[]                  @relation("InvoiceCancelledBy")
  invoiceDocumentsGenerated InvoiceDocument[]          @relation("InvoiceDocumentGeneratedBy")

  @@index([status])
  @@index([isPlatformAdmin])
  @@map("users")
}

model UserIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   @db.VarChar(32)
  providerUid String   @map("provider_uid") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("user_identities")
}

/// Where branch switching physically lives. Changing the active branch is an
/// UPDATE here plus a re-issued access token — never a re-login.
model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  activeBranchId       String?   @map("active_branch_id") @db.Uuid
  impersonatedByUserId String?   @map("impersonated_by_user_id") @db.Uuid
  /// Opaque 256-bit token, hashed. Rotated on every refresh; presenting an
  /// already-rotated token revokes the whole family (theft signal).
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.VarChar(255)
  previousTokenHash    String?   @map("previous_token_hash") @db.VarChar(255)
  ipAddress            String?   @map("ip_address") @db.Inet
  userAgent            String?   @map("user_agent") @db.VarChar(512)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamptz(6)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBranch Branch? @relation(fields: [activeBranchId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// OTP and one-shot links. Phone-first login is non-negotiable in Indian
/// healthcare, so this carries attempt counting and hard expiry.
model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  identifier String           @db.VarChar(255)
  codeHash   String           @map("code_hash") @db.VarChar(255)
  attempts   Int              @default(0) @db.SmallInt
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// =============================================================================
// ACCESS CONTROL
// =============================================================================

/// user × organization. The join that makes one login work across tenants.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  invitedBy      String?          @map("invited_by") @db.Uuid
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  /// The branch this person last worked in, so signing in puts them back where
  /// they were rather than in whichever branch happens to be primary.
  ///
  /// WHY IT LIVES HERE AND NOT ON `users`
  ///   Someone who works at two clinics has a different last branch at each, so
  ///   the preference belongs to the (user × organization) pair — which is exactly
  ///   what a membership is. On `users` it would be one slot for two answers, and
  ///   switching organization would silently clobber the other clinic's.
  ///
  /// A PREFERENCE, NOT A GRANT. Never trusted on read. Sign-in and switch both
  /// re-resolve the caller's branch scope from `membership_roles` and fall back to
  /// the primary branch unless this branch is still in that scope and still
  /// ACTIVE. A branch that has been closed or un-assigned is therefore inert
  /// rather than a way back in.
  lastBranchId   String?          @map("last_branch_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  overrides    MembershipPermissionOverride[]
  staffProfile StaffProfile?
  /**
   * Composite, against `(organization_id, id)` — ADR-0004. Without it this column
   * could name another clinic's branch, and "we validate it on read" is exactly
   * the assurance ADR-0004 exists to replace.
   * NoAction is deliberate, and neither alternative works:
   * - Cascade would delete the MEMBERSHIP when a branch is hard-deleted. Losing
   * someone's access because a location closed is not a preference being
   * forgotten.
   * - SetNull on a composite FK nulls every referencing column, including
   * `organization_id`, which is NOT NULL — so the delete would fail at runtime
   * with a constraint violation rather than doing what it says.
   * Nothing in the application hard-deletes a branch (branch.service.ts sets
   * `deletedAt` and CLOSED), so this constraint is a backstop, not a workflow. If
   * a hard delete is ever needed, clear this column first.
   */
  lastBranch   Branch?                        @relation("MembershipLastBranch", fields: [organizationId, lastBranchId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

/// System roles have organizationId = null and are never edited by a tenant.
/// A tenant clones one into an org-scoped custom role instead.
model Role {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  code           String         @db.VarChar(64)
  name           String         @db.VarChar(128)
  description    String?        @db.VarChar(512)
  scopeLevel     RoleScopeLevel @map("scope_level")
  isSystem       Boolean        @default(false) @map("is_system")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  assignments  MembershipRole[]
  invitations  Invitation[]
  designations RoleDesignation[]

  @@unique([organizationId, code])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(128)
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  description String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles     RolePermission[]
  overrides MembershipPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// The heart of the access model.
///
///   branchId NULL  -> the role applies to EVERY branch in the organization
///   branchId set   -> the role applies to that branch only
///
/// One admin over all three branches  = 1 row, branchId null
/// A separate admin per branch        = 1 row each, branchId set
/// Admin over A and B, another over A = 2 rows + 1 row
model MembershipRole {
  id             String    @id @default(uuid()) @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  /// Denormalised from membership so RLS can filter without a join, and so the
  /// composite FK to branches can be enforced.
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  validFrom      DateTime? @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([membershipId, roleId, branchId])
  @@index([organizationId, branchId])
  @@index([membershipId])
  @@map("membership_roles")
}

/// Per-person exceptions. DENY always beats GRANT, and both beat role grants.
model MembershipPermissionOverride {
  id             String         @id @default(uuid()) @db.Uuid
  membershipId   String         @map("membership_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  permissionId   String         @map("permission_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  effect         OverrideEffect
  reason         String?        @db.VarChar(512)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([membershipId, permissionId, branchId])
  @@index([organizationId])
  @@map("membership_permission_overrides")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  phone          String?   @db.VarChar(20)
  roleId         String    @map("role_id") @db.Uuid
  /// The job title this invite is for. Copied onto the staff profile when the
  /// invitation is accepted, so the answer is decided by whoever knows it —
  /// the person sending the invite — rather than guessed from the role.
  designationId  String?   @map("designation_id") @db.Uuid
  token          String    @unique @db.VarChar(255)
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  designation  Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  inviter      User               @relation("InvitedBy", fields: [invitedBy], references: [id])
  branches     InvitationBranch[]

  @@index([organizationId, email])
  @@map("invitations")
}

model InvitationBranch {
  id           String @id @default(uuid()) @db.Uuid
  invitationId String @map("invitation_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([invitationId, branchId])
  @@map("invitation_branches")
}

/// The job titles a clinic hands out. Platform catalogue with per-tenant
/// extension: `organizationId = NULL` is a platform row every clinic sees.
///
/// Exists as a table rather than free text on `staff_profiles` because a
/// designation is a closed set the clinic curates — the invite form picks from
/// it, and an admin adds to it. Free text produces "Sr. Consultant",
/// "Senior Consultant" and "Sr Consultant" as three different things and makes
/// "how many consultants do we have" unanswerable.
///
/// ⚠️ ITS RLS POLICY IS READ-PERMISSIVE AND WRITE-STRICT, exactly as
/// `specialties` is, and NOT the policy on `files`. A NULL-permissive WITH CHECK
/// would let any clinic insert a platform-wide designation visible to every
/// other tenant. See the migration and enable-rls.sql.
model Designation {
  id             String    @id @default(uuid()) @db.Uuid
  /// NULL = platform row, visible to every tenant.
  organizationId String?   @map("organization_id") @db.Uuid
  code           String    @db.VarChar(64)
  name           String    @db.VarChar(128)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitations   Invitation[]
  staffProfiles StaffProfile[]
  roles         RoleDesignation[]

  /// ⚠️ Rewritten NULLS NOT DISTINCT in the migration — without it the platform
  /// rows are not unique among themselves.
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("designations")
}

/// Which job titles fit which role. A "Receptionist" is not a "Radiologist".
///
/// A real join table rather than an array on either side (ADR-0006): the
/// relationship is genuinely many-to-many — "Consultant" fits only DOCTOR, while
/// "Clinic Manager" fits ORG_ADMIN, BRANCH_ADMIN and RECEPTIONIST — and a JSONB
/// array of ids cannot be joined, constrained by a foreign key, or filtered in
/// SQL.
///
/// `organizationId = NULL` is a platform pairing, seeded for the built-in roles
/// so the feature works on day one. A clinic adds its own for its own custom
/// roles and titles, and cannot touch the platform ones.
///
/// ⚠️ AN UNMAPPED DESIGNATION FITS EVERY ROLE, DELIBERATELY.
///   The eligibility query treats "has no POSITIVE pairing anywhere" as "fits
///   anywhere", not as "fits nowhere". The alternative makes this a trap: a
///   clinic adds a title, forgets to map it, and watches it disappear from every
///   menu with nothing explaining why. Titles added from the invite form are
///   auto-mapped to the role being invited, so that path is mapped from birth.
///
/// ⚠️ "POSITIVE" IS LOAD-BEARING IN THAT SENTENCE — see `isExcluded`.
model RoleDesignation {
  id             String   @id @default(uuid()) @db.Uuid
  /// NULL = platform pairing, visible to every tenant.
  organizationId String?  @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  designationId  String   @map("designation_id") @db.Uuid
  /// A tenant row that SUPPRESSES a platform default rather than adding one:
  /// "our Receptionists are never Clinic Managers". Always false on a platform
  /// row — the platform states what fits, never what does not.
  ///
  /// Excluded rows are deliberately NOT counted when deciding whether a title
  /// is "unmapped". Two things break if they are:
  ///
  ///   - Unticking an unmapped title for ONE role would create its only row,
  ///     making the title look mapped, and it would vanish from every OTHER
  ///     role's menu too.
  ///   - Unticking every one of a title's platform pairings would leave only
  ///     exclusions, making it look unmapped again — and therefore valid
  ///     everywhere, which is the exact opposite of what was asked for.
  isExcluded     Boolean  @default(false) @map("is_excluded")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  designation  Designation   @relation(fields: [designationId], references: [id], onDelete: Cascade)

  /// ⚠️ NULLS NOT DISTINCT in the migration — platform pairings carry a NULL
  /// organization_id and must be unique among themselves.
  @@unique([organizationId, roleId, designationId])
  @@index([roleId])
  @@index([designationId])
  @@map("role_designations")
}

/// Employment facts are per-organization, so this keys on membership, not user.
///
/// `employeeCode`, `designationId` and `joinedOn` are AUTO-POPULATED when an
/// invitation is accepted — see `acceptInvitation`. They stay editable
/// afterwards from the Staff screen.
model StaffProfile {
  id            String    @id @default(uuid()) @db.Uuid
  membershipId  String    @unique @map("membership_id") @db.Uuid
  /// Issued from the EMPLOYEE sequence at accept time. Stable for life: it is
  /// how the clinic refers to this person, so a re-join keeps the original.
  employeeCode  String?   @map("employee_code") @db.VarChar(64)
  department    String?   @db.VarChar(128)
  /// Replaced the free-text `designation` column, which had no rows. One source
  /// of truth: a designation is a row in `designations`, never a typed string.
  designationId String?   @map("designation_id") @db.Uuid
  joinedOn      DateTime? @map("joined_on") @db.Date
  relievedOn    DateTime? @map("relieved_on") @db.Date

  membership  Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  @@index([designationId])
  @@map("staff_profiles")
}

// =============================================================================
// DOCTORS
//
// A doctor is a `users` row plus a `doctor_profiles` row. Practising at three
// branches is three `membership_roles` — the profile is org-level, and anything
// that genuinely varies by location (fees, working hours) is its own table
// keyed by branch. That is why there is no `consultation_fee` column here.
// =============================================================================

/// Clinical specialties. Platform catalogue with per-tenant extension:
/// `organizationId = NULL` is a platform row every clinic sees.
///
/// WHY BOTH, RATHER THAN ONE OR THE OTHER
///   Per-tenant only means every clinic re-types "Cardiology", and cross-clinic
///   reporting plus the later `procedures.specialty_id` become unjoinable.
///   Platform only means a clinic that invents a sub-specialty ("Trichology —
///   PRP") needs a deploy to record it.
///
/// ⚠️ ITS RLS POLICY IS NOT THE ONE ON `files`.
///   `files` allows a NULL organization_id in its WITH CHECK. Copying that here
///   would let any clinic INSERT a platform-wide specialty visible to every
///   other tenant. Read is permissive, write is not — see the migration.
model Specialty {
  id             String           @id @default(uuid()) @db.Uuid
  /// NULL = platform row, visible to every tenant.
  organizationId String?          @map("organization_id") @db.Uuid
  /// Self-reference: a sub-specialty of another specialty. Collapses the old
  /// specialties / sub_specialties / specialization_map triple into one master.
  ///
  /// ⚠️ `onDelete: Restrict`, NOT SetNull. SetNull "succeeds" at deleting a node
  ///   and silently promotes its entire subtree to the root — Interventional
  ///   Cardiology reappears as a top-level domain next to Medical, with no error
  ///   and nothing in the logs. Refusing the delete is the honest outcome; the
  ///   caller deactivates or re-parents the children first. See `deactivateNode`.
  parentId       String?          @map("parent_id") @db.Uuid
  code           String           @db.VarChar(64)
  name           String           @db.VarChar(255)
  /// Descriptive label only — see the enum. NOT the tree's shape.
  type           TaxonomyNodeType @default(SPECIALTY)
  description    String?          @db.Text
  /// Sort among siblings. Ties break by `name` so the order is total.
  displayOrder   Int              @default(0) @map("display_order")
  /// Free-form document: display labels per locale, external system codes
  /// (SNOMED CT, NUCC), regional applicability flags.
  ///
  /// ⚠️ A DOCUMENT, NEVER FOREIGN KEYS. ADR-0006 — no JSON arrays of ids. If you
  ///   find yourself putting a `specialty_id` list in here, you want a join table.
  metadata       Json?            @db.JsonB
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Specialty?        @relation("SpecialtyParent", fields: [parentId], references: [id], onDelete: Restrict)
  children     Specialty[]       @relation("SpecialtyParent")
  doctors      DoctorSpecialty[]

  /// ⚠️ Rewritten NULLS NOT DISTINCT in the migration — without it the platform
  /// rows (organization_id NULL) are not unique among themselves.
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  /// Descendant walks recurse on `parent_id`. Without this the recursive CTE
  /// seq-scans the table once PER LEVEL.
  @@index([parentId])
  @@index([organizationId, type])
  @@map("specialties")
}

/// Medical qualifications (MBBS, MD, MS…). Same platform-plus-tenant shape and
/// the same non-permissive WITH CHECK as `specialties`.
model Qualification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  code           String    @db.VarChar(64)
  name           String    @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctors      DoctorQualification[]

  /// ⚠️ NULLS NOT DISTINCT in the migration, as above.
  @@unique([organizationId, code])
  @@map("qualifications")
}

/// The practitioner. One row per doctor PER ORGANIZATION.
///
/// ⚠️ `userId` IS UNIQUE PER ORGANIZATION, NOT GLOBALLY.
///   The design ERD draws `user_id UK`, which is wrong for this codebase:
///   `users` is global and RLS-exempt — one login spans organizations — so a
///   bare unique would mean a doctor consulting at two clinics can hold exactly
///   one profile. The failure appears only when the SECOND clinic tries to
///   onboard them, which is late and confusing. It also gives the row an
///   `organization_id` for `tenant_isolation` to filter on, which a bare
///   `user_id` unique does not.
///
/// `userId` is NOT NULL: a doctor must be invited before they can be scheduled,
/// because they must be able to log in to prescribe. A visiting consultant with
/// no login is a known future request; the additive change is a nullable column
/// plus a `displayName`.
model DoctorProfile {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @map("organization_id") @db.Uuid
  userId                String       @map("user_id") @db.Uuid
  /// Medical council registration. The number that makes a prescription legal.
  registrationNumber    String?      @map("registration_number") @db.VarChar(64)
  registrationCouncil   String?      @map("registration_council") @db.VarChar(255)
  registrationValidTill DateTime?    @map("registration_valid_till") @db.Date
  experienceYears       Int?         @map("experience_years") @db.SmallInt
  bio                   String?      @db.Text
  signatureFileId       String?      @map("signature_file_id") @db.Uuid
  status                DoctorStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties    DoctorSpecialty[]
  qualifications DoctorQualification[]
  branchSettings DoctorBranchSetting[]
  compensation   DoctorCompensation?
  fees           FeeScheduleEntry[]
  invoices       Invoice[]                 @relation("InvoicePractitioner")
  schedules      DoctorSchedule[]
  exceptions     DoctorScheduleException[]
  appointments   Appointment[]

  @@unique([organizationId, userId])
  /// Composite-FK target: schedules, appointments and queue tokens reference
  /// (organization_id, id) so a cross-tenant row is unrepresentable.
  @@unique([organizationId, id])
  /// ⚠️ NULLS NOT DISTINCT in the migration — the column is nullable, and a
  /// council number appearing twice in one clinic is a data-entry error worth
  /// refusing.
  @@unique([organizationId, registrationNumber])
  @@index([organizationId, status])
  @@map("doctor_profiles")
}

/// Which specialties a doctor practises.
///
/// Org-scoped rather than parent-scoped because it points at TWO parents, one of
/// which (`specialties`) may be a platform row — so scoping through
/// `doctor_profiles` alone would leave the specialty side unconstrained. The
/// second parent gets a RESTRICTIVE `specialty_visible` policy instead, exactly
/// as `invitation_branches` does for its branch.
model DoctorSpecialty {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  doctorProfileId String                @map("doctor_profile_id") @db.Uuid
  specialtyId     String                @map("specialty_id") @db.Uuid
  /// At most one TRUE per doctor, enforced by the partial unique index
  /// `doctor_specialties_one_primary` from the doctors migration — Prisma cannot
  /// express `WHERE is_primary`. Zero is legal: a doctor may have specialties
  /// recorded with none nominated as the headline.
  isPrimary       Boolean               @default(false) @map("is_primary")
  /// Advisory display label. ⚠️ Never an authorization input — see the enum.
  proficiency     SpecialtyProficiency?
  /// When this classification began and ended. Both NULL is the ordinary case:
  /// "practises this, no dates recorded".
  ///
  /// ⚠️ `isActive` IS NOT DERIVED FROM THESE, deliberately. A fellowship that
  ///   lapsed and one that was entered in error are different facts, and only
  ///   the second should vanish from the directory. Dates are evidence; the flag
  ///   is the decision.
  effectiveFrom   DateTime?             @map("effective_from") @db.Date
  effectiveTo     DateTime?             @map("effective_to") @db.Date
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  specialty     Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, doctorProfileId, specialtyId])
  @@index([organizationId, specialtyId])
  @@map("doctor_specialties")
}

/// Which qualifications a doctor holds. Same two-parent shape as above.
model DoctorQualification {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  doctorProfileId  String   @map("doctor_profile_id") @db.Uuid
  qualificationId  String   @map("qualification_id") @db.Uuid
  institute        String?  @db.VarChar(255)
  yearOfCompletion Int?     @map("year_of_completion") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Restrict)

  /// `institute` is part of the key: the same degree from two institutions is
  /// two legitimate rows. ⚠️ NULLS NOT DISTINCT in the migration.
  @@unique([organizationId, doctorProfileId, qualificationId, institute])
  @@map("doctor_qualifications")
}

/// What a doctor charges at one branch.
///
/// ⚠️ DELIBERATELY NO `slotMinutes` AND NO `acceptsOnlineBooking`.
///   Both were on the design ERD and both are removed. Slot duration has ONE
///   authoritative chain — `doctor_schedules.slot_minutes`, else the resolved
///   `appointment.slot_minutes` setting at DOCTOR → BRANCH → ORGANIZATION —
///   and online booking resolves `appointment.allow_online_booking` the same
///   way. Three columns claiming the same number with no reconciliation rule is
///   how the receptionist's calendar and the patient portal end up disagreeing
///   about whether 10:20 exists. See ADR-0015.
model DoctorBranchSetting {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  doctorProfileId  String   @map("doctor_profile_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  /// ⚠️ `consultation_fee` AND `follow_up_fee` WERE HERE AND ARE NOW ON
  ///   `fee_schedule_entries`, migrated by
  ///   `fee_schedule_and_doctor_compensation`. A fee is per VISIT TYPE, and
  ///   two columns could only price two of the five kinds of appointment this
  ///   product books. Do not re-add them: two places that look like the fee is
  ///   how a clinic bills a number nobody set.
  ///
  /// `follow_up_free_days` deliberately STAYS. It is not money — it is the
  /// window inside which a review is free, and it belongs to the relationship
  /// between a doctor and a branch rather than to a price list.
  followUpFreeDays Int?     @map("follow_up_free_days") @db.SmallInt
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, doctorProfileId, branchId])
  @@index([organizationId, branchId, isActive])
  @@map("doctor_branch_settings")
}

/// What an appointment costs: one row per (branch, doctor, kind of visit).
///
/// ⚠️ BOTH `branch_id` AND `doctor_profile_id` ARE NULLABLE, AND NULL MEANS
///   "ALL" ON EACH AXIS INDEPENDENTLY. That is the `membership_roles` idiom
///   (ADR-0002) applied twice, and it is what lets one table hold the clinic's
///   default and a doctor's override without a second table or a discriminator:
///
///     doctor NULL, branch NULL   the clinic's default everywhere
///     doctor NULL, branch set    the clinic's default at that branch
///     doctor set,  branch NULL   that doctor's price wherever they consult
///     doctor set,  branch set    that doctor's price at that branch
///
///   Resolution is most-specific-first, in `resolveFee()` and nowhere else. A
///   second implementation is how a booking screen quotes one number and the
///   invoice states another.
///
/// ⚠️ A ROW HOLDING ZERO IS A RESOLVED ROW. Free is a price a clinic can choose,
///   and only the ABSENCE of a row falls through to the next level. Reading a
///   zero as "unset" would bill every free follow-up at the full rate the moment
///   somebody deliberately set it to nothing.
///
/// ⚠️ `fee_type` IS A VARCHAR AND NOT `AppointmentVisitType`, DELIBERATELY.
///   Today every value is a visit type plus `RESCHEDULE`, and the contract
///   validates against that closed set. The column is loose so a clinic-defined
///   fee catalogue can arrive without a migration on a table that will by then
///   hold every clinic's price list. The looseness is in the column only —
///   nothing accepts an unrecognised value today.
model FeeScheduleEntry {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  /// NULL = every branch. Composite-FK'd when present.
  branchId        String? @map("branch_id") @db.Uuid
  /// NULL = the clinic's default, which every doctor inherits.
  doctorProfileId String? @map("doctor_profile_id") @db.Uuid
  /// `NEW`, `FOLLOW_UP`, `WALK_IN`, `TELECONSULT`, `PROCEDURE`, `RESCHEDULE`.
  feeType         String  @map("fee_type") @db.VarChar(64)
  /// Currency is the organization's, as everywhere else in this schema.
  amount          Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  doctorProfile DoctorProfile? @relation(fields: [organizationId, doctorProfileId], references: [organizationId, id], onDelete: Cascade)

  /// ⚠️ NULLS NOT DISTINCT in the migration. Both scoping columns are nullable,
  /// and a plain unique index does not constrain NULLs — without it a clinic
  /// can hold two different org-wide `NEW` prices and the planner decides which
  /// one a patient pays.
  @@unique([organizationId, doctorProfileId, branchId, feeType])
  /// The resolver's read: every candidate row for one fee type, in one index.
  @@index([organizationId, feeType])
  @@map("fee_schedule_entries")
}

/// What the clinic has agreed to pay a doctor. A RECORD, NOT A PAYROLL RUN.
///
/// ⚠️ NOTHING COMPUTES ANYTHING FROM THIS. There are no payout periods, no
///   payslips and no reconciliation against what the doctor actually billed —
///   that is the deferred compensation module, and `billing.doctor_payout.manage`
///   is the permission already seeded for it. This table answers one question:
///   "what did we agree to pay Tejas, and how often?"
///
/// ⚠️ ONE ROW PER DOCTOR, ORGANIZATION-WIDE, WITH NO `branch_id`. A person has
///   one employment contract. Splitting a salary across the branches they
///   consult at is cost allocation, which is a reporting question and not this
///   row's business.
///
/// ⚠️ ITS OWN PERMISSION PAIR, `doctor.compensation.read` / `.manage`, AND NOT
///   `doctor.update`. Every BRANCH_ADMIN holds `doctor.update`, so reusing it
///   would mean whoever can fix a typo in a bio can also read what every
///   colleague earns. This is the most gossip-sensitive field in the product.
model DoctorCompensation {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  doctorProfileId String          @map("doctor_profile_id") @db.Uuid
  /// Gross, in the organization's currency. Null means "not agreed yet", which
  /// is different from zero — an unpaid honorary consultant is a real thing.
  amount          Decimal?        @db.Decimal(14, 2)
  /// Null alongside a null amount. Meaningless without one.
  interval        PayoutInterval?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [organizationId, doctorProfileId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, doctorProfileId])
  @@map("doctor_compensation")
}

/// A recurring block of working hours: this doctor, this branch, this weekday.
///
/// ⚠️ `startTime`/`endTime` ARE WALL-CLOCK IN THE BRANCH'S TIMEZONE.
///   Not UTC, not the org's zone, not the server's. `branches.timezone` is the
///   only authority for what "09:00" means, and the conversion to an instant
///   happens in Postgres — `($date::date + start_time) AT TIME ZONE b.timezone`
///   — never in Node, where the container's TZ would silently shift IST by 5:30.
///   `dayOfWeek` is 0-6 with 0 = Sunday, matching `branch_operating_hours`.
///
/// Two blocks a day (morning and evening) is normal, so there is no natural
/// unique key. Non-overlap is a GiST EXCLUDE constraint in the migration.
///
/// An overnight block is forbidden by a CHECK: it would produce an inverted
/// range that `tstzrange` refuses. An overnight OPD is two rows.
model DoctorSchedule {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  doctorProfileId String    @map("doctor_profile_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  dayOfWeek       Int       @map("day_of_week") @db.SmallInt
  startTime       DateTime  @map("start_time") @db.Time(0)
  endTime         DateTime  @map("end_time") @db.Time(0)
  /// NULL = fall back to the resolved `appointment.slot_minutes` setting. This
  /// is the ONLY per-block override, and the only column the engine reads.
  slotMinutes     Int?      @map("slot_minutes") @db.SmallInt
  /// Cap on bookings in this block. ⚠️ ADVISORY — no constraint enforces it, so
  /// two concurrent bookings into different free slots can exceed it by one.
  /// Enforcing it would serialise every booking for the block. See the service.
  maxPatients     Int?      @map("max_patients") @db.SmallInt
  validFrom       DateTime  @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId, dayOfWeek])
  @@index([doctorProfileId, dayOfWeek])
  @@map("doctor_schedules")
}

/// A one-off departure from the recurring schedule: leave, a block, an extra shift.
///
/// Stored as `timestamptz` rather than a date plus a time, because an exception
/// is an absolute interval — "away from Friday 18:00 until Monday 09:00" — and
/// does not repeat, so there is nothing for a wall-clock reading to anchor to.
///
/// ⚠️ ORG-SCOPED, WITH NO `branch_isolation` POLICY, DELIBERATELY.
///   `branchId` NULL means "every branch". A doctor's leave is org-level
///   information, and hiding it from a branch-scoped reader would not restrict
///   anything useful — it would make the engine offer slots on a day the doctor
///   is away. Phantom availability is worse than a visible absence. The service
///   filters by branch instead.
model DoctorScheduleException {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  doctorProfileId String                  @map("doctor_profile_id") @db.Uuid
  /// NULL = applies at every branch.
  branchId        String?                 @map("branch_id") @db.Uuid
  exceptionType   ScheduleExceptionType   @map("exception_type")
  startsAt        DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime                @map("ends_at") @db.Timestamptz(6)
  reason          String?                 @db.VarChar(255)
  status          ScheduleExceptionStatus @default(REQUESTED)
  requestedBy     String?                 @map("requested_by") @db.Uuid
  decidedBy       String?                 @map("decided_by") @db.Uuid
  decidedAt       DateTime?               @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, doctorProfileId, startsAt])
  /// The approvals inbox.
  @@index([organizationId, status, startsAt])
  @@map("doctor_schedule_exceptions")
}

// =============================================================================
// PATIENTS
//
// ⚠️ EVERYTHING BELOW THIS LINE IS PHI. The rules are not stylistic:
//
//   - No column here may reach `audit_logs` except through an allow-list
//     snapshot. `REDACTED_KEYS` in audit.service.ts is the second layer, not
//     the first.
//   - Every read that discloses one of these rows calls `recordDataAccess`
//     INSIDE the transaction that read it.
//   - Ids only in Redis, in logs, and in a URL.
//
// WHY IDENTITY IS ORG-WIDE AND ATTENDANCE IS BRANCH-LOCAL
//   `patients` carries org-scoped RLS and deliberately NO `branch_isolation`;
//   `patient_registrations` carries both. A person is one person across a
//   hospital group — their allergy list must follow them to whichever branch
//   they walk into, and, more sharply, a branch-scoped duplicate check is
//   impossible if the front desk cannot see that head office already registered
//   them. Two UHIDs for one human being is a clinical safety failure, not a
//   tidiness one: the second record has no allergies on it.
//
//   What IS branch-local is which clinic they attend, and that is exactly what
//   `patient_registrations` records. The patient list a receptionist sees is
//   driven off that join, not off `patients` — see the service.
// =============================================================================

/// One human being, once per organization.
///
/// UHID is the number the clinic says out loud. It is org-wide, issued from the
/// `UHID` counter with the `patient.uhid_prefix` setting as its prefix, and it
/// never changes — including across a merge, where the losing record keeps its
/// own so an old file card still resolves.
model Patient {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// The org-wide hospital number. Issued, never typed.
  uhid           String        @db.VarChar(32)
  /// Set only when the patient signs up for the portal. Most never will, which
  /// is why `patients` is not a kind of `users`: the record must exist for an
  /// unconscious admission with no email address.
  userId         String?       @map("user_id") @db.Uuid
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String?       @map("last_name") @db.VarChar(100)
  /// ⚠️ NULLABLE, AND `approx_age_years` EXISTS FOR THE REASON.
  ///   A walk-in who knows they are "about 60" is the common case in an Indian
  ///   OPD. Storing a fabricated 1st-January birthday to satisfy a NOT NULL is
  ///   how a paediatric dose gets calculated from a lie.
  dateOfBirth    DateTime?     @map("date_of_birth") @db.Date
  /// Age in whole years as stated, when no birth date is known. Never derived
  /// from `dateOfBirth` — one of the two is authoritative and the other is null.
  approxAgeYears Int?          @map("approx_age_years") @db.SmallInt
  gender         Gender        @default(UNKNOWN)
  bloodGroup     BloodGroup    @default(UNKNOWN) @map("blood_group")
  phone          String?       @db.VarChar(20)
  email          String?       @db.VarChar(255)
  /// India's health account number. 14 digits, or the `user@abdm` address form.
  abhaNumber     String?       @map("abha_number") @db.VarChar(32)
  /// Aadhaar, passport, or whatever the clinic photocopied. Deliberately not
  /// validated per-country here — see the contract.
  ///
  /// ⚠️ STORED NORMALISED — no spaces, no hyphens, upper-cased. `2345 6789 0123`
  ///   and `2345-6789-0123` are one Aadhaar, and a duplicate check that treats
  ///   them as two is a duplicate check that does nothing. The grouping is put
  ///   back for display by `formatNationalId`.
  nationalId     String?       @map("national_id") @db.VarChar(64)
  /// WHICH document `national_id` is: `AADHAAR`, `PAN`, `NHS_NUMBER`, `PASSPORT`.
  ///
  /// ⚠️ A VARCHAR, NOT A PRISMA ENUM, AND FOR THE SAME REASON `country_code` is
  ///   one. The accepted list is per-country and grows every time the platform
  ///   opens a new market; as an enum that is a migration per country, and a
  ///   patient carrying a document the enum has not learned yet cannot be
  ///   recorded at all. The vocabulary lives in `locale.ts` next to the postcode
  ///   and dialling tables, and the contract validates against it.
  ///
  /// Null where the desk did not say — including on every row written before
  /// this column existed, which is why it is nullable and not defaulted.
  nationalIdType String?       @map("national_id_type") @db.VarChar(32)
  maritalStatus  MaritalStatus @default(UNKNOWN) @map("marital_status")
  status         PatientStatus @default(ACTIVE)
  /// Set with `status = DECEASED`. A date, because the time of death is a
  /// clinical record this table is not the place for.
  deceasedOn     DateTime?     @map("deceased_on") @db.Date
  /// The surviving record, when `status = MERGED`. Composite-FK'd to this same
  /// table so a merge can never point across tenants.
  mergedIntoId   String?       @map("merged_into_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Erasure, not death and not a merge. See `PatientStatus`.
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  mergedInto    Patient?              @relation("PatientMerge", fields: [organizationId, mergedIntoId], references: [organizationId, id], onDelete: Restrict)
  mergedFrom    Patient[]             @relation("PatientMerge")
  registrations PatientRegistration[]
  addresses     PatientAddress[]
  contacts      PatientContact[]
  allergies     PatientAllergy[]
  conditions    PatientCondition[]
  medications   PatientMedication[]
  appointments  Appointment[]
  vitals        AppointmentVital[]
  invoices      Invoice[]

  @@unique([organizationId, uhid])
  /// Composite-FK target. Registrations, appointments, encounters, invoices and
  /// everything else clinical references (organization_id, id) so a
  /// cross-tenant child row is unrepresentable (ADR-0004).
  @@unique([organizationId, id])
  /// The duplicate check at the front desk: phone first, it is what people
  /// actually remember.
  @@index([organizationId, phone])
  @@index([organizationId, status])
  /// The phone trigram index, DECLARED HERE rather than left hand-written.
  /// ⚠️ It backs `p.phone LIKE '%term%'` in the search, which the btree above
  ///   cannot serve. It was originally created only in the patients migration,
  ///   and Prisma — which CAN see an index on a plain column — proposed dropping
  ///   it in the very next `migrate dev`. Declaring it is what stops that from
  ///   recurring. Its sibling over `lower(first_name || ' ' || …)` stays
  ///   hand-written because it is an EXPRESSION index, which Prisma cannot
  ///   express or see, and therefore never offers to drop.
  @@index([phone(ops: raw("gin_trgm_ops"))], map: "patients_phone_trgm_idx", type: Gin)
  /// ⚠️ THE NAME SEARCH INDEX IS A GIN TRIGRAM INDEX WRITTEN BY HAND in the
  ///   migration, over `lower(first_name || ' ' || coalesce(last_name, ''))`.
  ///   Prisma cannot express an expression index, and without it every search
  ///   is a sequential scan over every patient in the database — filtered by
  ///   RLS afterwards, so the cost grows with the PLATFORM, not with the tenant.
  @@map("patients")
}

/// Which clinic a patient attends, and the branch-local record number.
///
/// One row per (patient, branch). The MRN is per branch and issued from the
/// `MRN` counter with `branch_id` set, so branch A and branch B both start at 1
/// and neither can collide with the other.
///
/// ⚠️ ORG-SCOPED **PLUS** RESTRICTIVE `branch_isolation`, unlike `patients`.
///   This is the row that answers "is this person one of ours?", and it is the
///   only place a branch boundary belongs — see the section header.
model PatientRegistration {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  patientId      String                    @map("patient_id") @db.Uuid
  branchId       String                    @map("branch_id") @db.Uuid
  /// The branch-local medical record number. Issued, never typed.
  mrn            String                    @db.VarChar(32)
  registeredAt   DateTime                  @default(now()) @map("registered_at") @db.Timestamptz(6)
  /// SetNull: the receptionist may leave; the registration stays.
  registeredBy   String?                   @map("registered_by") @db.Uuid
  status         PatientRegistrationStatus @default(ACTIVE)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  branch       Branch        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  registrar    User?         @relation("PatientRegisteredBy", fields: [registeredBy], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([organizationId, patientId, branchId])
  @@unique([organizationId, branchId, mrn])
  /// Composite-FK target: an appointment references the registration it was
  /// booked against.
  @@unique([organizationId, id])
  @@index([organizationId, branchId, status])
  @@map("patient_registrations")
}

/// Where a patient lives. Org-scoped, because an address follows the person
/// rather than the clinic they happened to register at.
model PatientAddress {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  patientId      String      @map("patient_id") @db.Uuid
  addressType    AddressType @default(HOME) @map("address_type")
  line1          String      @db.VarChar(255)
  line2          String?     @db.VarChar(255)
  city           String?     @db.VarChar(100)
  state          String?     @db.VarChar(100)
  pincode        String?     @db.VarChar(10)
  countryCode    String      @default("IN") @map("country_code") @db.Char(2)
  /// ⚠️ ADVISORY — no partial unique index enforces one primary per patient.
  ///   The service demotes the previous primary in the same transaction. A
  ///   constraint would be `WHERE is_primary` on (organization_id, patient_id),
  ///   which is correct and was left out only because a second primary is a
  ///   cosmetic defect, not a clinical one.
  isPrimary      Boolean     @default(false) @map("is_primary")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, patientId])
  @@map("patient_addresses")
}

/// Next of kin, guardian, the person to ring.
///
/// `relation` is free text on purpose. A closed enum of family relations is a
/// cultural assumption, and the field is displayed, never queried.
model PatientContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  relation       String   @db.VarChar(64)
  name           String   @db.VarChar(255)
  phone          String   @db.VarChar(20)
  email          String?  @db.VarChar(255)
  /// Who is rung in an emergency.
  isEmergency    Boolean  @default(false) @map("is_emergency")
  /// Who may consent on the patient's behalf. A different question from
  /// `isEmergency` and frequently a different person: the neighbour with a car
  /// is not the parent who can sign.
  isGuardian     Boolean  @default(false) @map("is_guardian")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, patientId])
  @@map("patient_contacts")
}

/// What a patient reacts to. The table a prescription is checked against.
///
/// ⚠️ NO `medicine_id` COLUMN YET, DELIBERATELY.
///   The §6 ERD has one, and the `medicines` catalogue does not exist until
///   Phase 5. A nullable uuid with no foreign key behind it is a column that
///   looks like a reference and enforces nothing — it would accept any uuid,
///   including another tenant's, for as long as it took Phase 5 to arrive.
///   `allergen_text` carries the answer until there is a real row to point at,
///   and the migration that adds the catalogue adds the FK with it.
model PatientAllergy {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  allergenType   AllergenType    @default(DRUG) @map("allergen_type")
  /// ⚠️ PHI, and in `REDACTED_KEYS` — never let this reach an audit snapshot.
  allergenText   String          @map("allergen_text") @db.VarChar(255)
  severity       AllergySeverity @default(MODERATE)
  reaction       String?         @db.VarChar(255)
  notedOn        DateTime?       @map("noted_on") @db.Date
  notedBy        String?         @map("noted_by") @db.Uuid
  /// Soft, because "this was recorded and later withdrawn" is itself clinically
  /// interesting — an allergy that vanishes without trace is indistinguishable
  /// from one that was never recorded.
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  noter        User?        @relation("AllergyNotedBy", fields: [notedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, patientId])
  @@map("patient_allergies")
}

/// The problem list. `diagnosis_id` is absent for the same reason
/// `medicine_id` is absent from allergies — see that model.
model PatientCondition {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  patientId      String                 @map("patient_id") @db.Uuid
  /// ⚠️ PHI, and in `REDACTED_KEYS`.
  conditionText  String                 @map("condition_text") @db.VarChar(255)
  status         PatientConditionStatus @default(ACTIVE)
  onsetDate      DateTime?              @map("onset_date") @db.Date
  resolvedDate   DateTime?              @map("resolved_date") @db.Date
  note           String?                @db.Text
  notedBy        String?                @map("noted_by") @db.Uuid
  deletedAt      DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  noter        User?        @relation("ConditionNotedBy", fields: [notedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, patientId])
  @@map("patient_conditions")
}

/// What the patient is taking, including what someone else prescribed.
///
/// `is_ongoing` is stored rather than derived from `stopped_on IS NULL`: "still
/// taking it" and "nobody has asked since" are different answers, and only the
/// first one is safe to hand a prescriber.
model PatientMedication {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  /// ⚠️ PHI, and in `REDACTED_KEYS`.
  medicineText   String    @map("medicine_text") @db.VarChar(255)
  /// "500mg twice daily after food" — one string, because it is transcribed off
  /// somebody else's prescription and structuring it would invent precision.
  dosage         String?   @db.VarChar(255)
  startedOn      DateTime? @map("started_on") @db.Date
  stoppedOn      DateTime? @map("stopped_on") @db.Date
  isOngoing      Boolean   @default(true) @map("is_ongoing")
  notedBy        String?   @map("noted_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  noter        User?        @relation("MedicationNotedBy", fields: [notedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, patientId])
  @@map("patient_medications")
}

// =============================================================================
// SCHEDULING
//
// ⚠️ AN APPOINTMENT IS PHI. It names a patient, a doctor and a reason, and the
//   three together disclose more than any one of them: "cardiology, Tuesday" is
//   a diagnosis with extra steps. The patient rules apply unchanged — allow-list
//   snapshots into `audit_logs`, `recordDataAccess` on any read that discloses
//   one patient, ids only in Redis and in a URL.
//
// A BOOKING IS NOT A VISIT. `appointments` is the intention; `encounters`
// (Phase 3, later) is the clinical event. A walk-in has an encounter with no
// appointment and a no-show has an appointment with no encounter, so folding
// them into one table loses both facts.
// =============================================================================

/// One booked slot: this patient, this doctor, this branch, this instant.
///
/// ⚠️ `scheduledStart`/`scheduledEnd` ARE ABSOLUTE INSTANTS, unlike
///   `doctor_schedules.start_time`, which is wall-clock in the branch's zone.
///   The conversion from one to the other happens in Postgres inside the
///   availability engine (`($date::date + start_time) AT TIME ZONE b.timezone`)
///   and nowhere else — the container runs UTC, so composing a Date from local
///   components in Node silently turns 09:00 IST into 03:30.
///
/// ⚠️ DOUBLE-BOOKING IS REFUSED BY POSTGRES, NOT BY THE SERVICE.
///   A GiST EXCLUDE constraint over (doctor_profile_id, tstzrange(start, end))
///   WHERE the status still holds the slot is written by hand in the migration —
///   Prisma cannot declare one. The service checks availability first so the
///   common case gets a sentence rather than a constraint name, but two
///   receptionists clicking the same 10:20 within the same millisecond is
///   exactly the case a check cannot win. Cancelling frees the slot because the
///   constraint's predicate excludes CANCELLED and NO_SHOW.
///
///   The constraint is deliberately NOT partial on `deleted_at`: a soft-deleted
///   appointment that still reads as BOOKED is a bug, and letting it keep its
///   slot is the safer failure.
model Appointment {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  branchId              String               @map("branch_id") @db.Uuid
  patientId             String               @map("patient_id") @db.Uuid
  /// The branch-local attendance row this booking was made against. Composite-
  /// FK'd, so a booking can never cite a registration at a different branch.
  patientRegistrationId String               @map("patient_registration_id") @db.Uuid
  doctorProfileId       String               @map("doctor_profile_id") @db.Uuid
  /// Branch-local, issued from the `APPOINTMENT` counter. Said out loud on the
  /// phone, so it is issued rather than typed.
  appointmentNumber     String               @map("appointment_number") @db.VarChar(32)
  scheduledStart        DateTime             @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd          DateTime             @map("scheduled_end") @db.Timestamptz(6)
  visitType             AppointmentVisitType @default(NEW) @map("visit_type")
  source                AppointmentSource    @default(FRONT_DESK)
  status                AppointmentStatus    @default(BOOKED)
  /// The visit this one follows up on. Composite-FK'd to (organization_id, id),
  /// so a follow-up can never cite a parent in another tenant.
  ///
  /// ⚠️ THE FOLLOW-UP GETS ITS OWN `appointment_number`, NOT THE PARENT'S. The
  ///   number is issued from a branch counter with a unique constraint behind it
  ///   and is what the patient is called by in the waiting room; two live rows
  ///   sharing one token is an ambiguous call, not a feature. The continuity the
  ///   clinic actually needs — same chain, cumulative prescription — is this
  ///   column, which is a stronger link than a reused string because the database
  ///   enforces it.
  parentAppointmentId   String?              @map("parent_appointment_id") @db.Uuid
  /// ⚠️ PHI, AND IN `REDACTED_KEYS`. "Chest pain since Tuesday" is a clinical
  /// statement typed at the front desk. It never reaches an audit row.
  reason                String?              @db.Text
  checkedInAt           DateTime?            @map("checked_in_at") @db.Timestamptz(6)
  startedAt             DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime?            @map("completed_at") @db.Timestamptz(6)
  /// SetNull: the receptionist may leave; the booking stays.
  bookedBy              String?              @map("booked_by") @db.Uuid
  cancelledBy           String?              @map("cancelled_by") @db.Uuid
  /// ⚠️ PHI by the same reasoning as `reason`.
  cancellationReason    String?              @map("cancellation_reason") @db.Text
  /// What this visit will be billed at, RESOLVED AND FROZEN WHEN IT WAS BOOKED.
  ///
  /// ⚠️ THE PRICE THE PATIENT WAS QUOTED, NOT THE PRICE IN FORCE TODAY. The fee
  ///   schedule can be edited between a booking and the visit, and the patient
  ///   standing at the desk was told a number. Re-resolving at invoice time —
  ///   which is what happened before this column — silently bills a rise nobody
  ///   was told about.
  ///
  ///   It is re-resolved in exactly ONE case: a reschedule that moves the visit
  ///   to a DIFFERENT DOCTOR, because that is a different consultation rather
  ///   than a price change. A move that only changes the time keeps this value.
  ///
  /// NULL means the schedule priced nothing — no entry at any level — and the
  /// billing panel says so rather than billing zero.
  bookedFee             Decimal?             @map("booked_fee") @db.Decimal(14, 2)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?            @map("deleted_at") @db.Timestamptz(6)

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch                     @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  patient       Patient                    @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  registration  PatientRegistration        @relation(fields: [organizationId, patientRegistrationId], references: [organizationId, id], onDelete: Cascade)
  doctorProfile DoctorProfile              @relation(fields: [organizationId, doctorProfileId], references: [organizationId, id], onDelete: Restrict)
  booker        User?                      @relation("AppointmentBookedBy", fields: [bookedBy], references: [id], onDelete: SetNull)
  canceller     User?                      @relation("AppointmentCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  statusHistory AppointmentStatusHistory[]
  vitals        AppointmentVital[]
  invoices      Invoice[]
  reschedules   AppointmentReschedule[]

  /// Restrict, not Cascade: deleting a visit must never silently take the
  /// follow-ups hanging off it — and the follow-up is the row that carries the
  /// cumulative prescription.
  parent    Appointment?  @relation("AppointmentFollowUp", fields: [organizationId, parentAppointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  followUps Appointment[] @relation("AppointmentFollowUp")

  @@unique([organizationId, branchId, appointmentNumber])
  /// Composite-FK target: encounters, invoices and queue tokens will reference
  /// (organization_id, id) so a cross-tenant child is unrepresentable (ADR-0004).
  @@unique([organizationId, id])
  /// The day board: one branch, one day, in time order.
  @@index([organizationId, branchId, scheduledStart])
  /// "What does my afternoon look like?" — and the read the engine does on every
  /// availability request.
  @@index([organizationId, doctorProfileId, scheduledStart])
  /// "When was this patient last here?"
  @@index([organizationId, patientId, scheduledStart])
  /// "What follows this visit?" — walked in both directions when the diagnosis
  /// page assembles the cumulative prescription for a chain.
  @@index([organizationId, parentAppointmentId])
  @@map("appointments")
}

/// One move of one appointment: who asked, why, and what it cost.
///
/// ⚠️ A TABLE AND NOT A COUNTER, BECAUSE A REASON IS WANTED PER MOVE. A patient
///   who moves an appointment three times is billed three times and has given
///   three explanations, and "why do patients keep moving Dr Tejas's slots?" is
///   a question a clinic can only answer from rows. A `reschedule_count` column
///   plus a JSON list of reasons would be ADR-0006 exactly.
///
/// ⚠️ `charge_amount` IS SNAPSHOTTED, NOT LOOKED UP. It is what the `RESCHEDULE`
///   fee resolved to at the moment of the move. Re-reading the schedule when the
///   invoice is raised would re-price moves that happened before the clinic
///   changed the charge — the same mistake `bookedFee` exists to prevent.
///   A clinic-initiated move stores 0, not NULL: nothing was charged, and that
///   is a decision rather than a missing value.
///
/// ⚠️ `reason` IS PHI-CAPABLE FREE TEXT and is in `REDACTED_KEYS`. "Can't come
///   Thursday, chemo" is a clinical statement typed at the front desk, exactly
///   like `appointments.reason`. It never reaches an audit row.
///
/// Append-only in practice: nothing updates or deletes a row here, because the
/// history of a booking is not editable. Not enforced by a trigger — unlike
/// `audit_logs`, this is an ordinary business table and a correction to a
/// mistyped reason is legitimate.
model AppointmentReschedule {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Copied from the appointment, so this row is an ordinary member of the
  /// branch RLS loop rather than inheriting only the org half through a parent.
  /// Contrast `appointment_status_history`, which has neither and pays for it.
  branchId       String @map("branch_id") @db.Uuid
  appointmentId  String @map("appointment_id") @db.Uuid

  /// Where the visit was, and where it went. Both instants, both UTC.
  fromStart DateTime @map("from_start") @db.Timestamptz(6)
  toStart   DateTime @map("to_start") @db.Timestamptz(6)

  /// Who was going to see the patient, and who will now. Equal on an ordinary
  /// move; different when the swap is what re-resolved the fee.
  fromDoctorProfileId String @map("from_doctor_profile_id") @db.Uuid
  toDoctorProfileId   String @map("to_doctor_profile_id") @db.Uuid

  initiatedBy  RescheduleInitiator @map("initiated_by")
  /// ⚠️ PHI. See the model note.
  reason       String?             @db.Text
  /// What the move cost. Always 0 for a CLINIC move.
  chargeAmount Decimal             @default(0) @map("charge_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)

  /// The billing read: every move of one appointment, oldest first.
  @@index([organizationId, appointmentId, createdAt])
  @@map("appointment_reschedules")
}

/// A set of observations taken for one appointment: the numbers the front desk
/// or the nurse writes down before the doctor is handed the patient.
///
/// ⚠️ PHI, ALL OF IT. A blood pressure attached to a named person is a clinical
///   record. Nothing here reaches an audit row, and reads are logged to
///   `data_access_logs` like every other chart read.
///
/// APPEND-ONLY IN PRACTICE, AND DELIBERATELY MANY-PER-APPOINTMENT. A repeat
/// blood pressure twenty minutes after a high first reading is the normal
/// clinical act, and it is a second observation rather than a correction of the
/// first. `deletedAt` exists for the genuine mistyping, which is a different
/// thing and leaves a trail.
///
/// BRANCH-SCOPED, like `appointments`. Vitals are taken at a place.
model AppointmentVital {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  appointmentId  String @map("appointment_id") @db.Uuid
  /// Denormalised from the appointment so the patient timeline ("show me every
  /// BP this year") does not have to join through every visit to find them.
  /// Composite-FK'd, so it cannot drift to a patient in another tenant; the
  /// service copies it from the appointment rather than trusting the caller.
  patientId      String @map("patient_id") @db.Uuid

  /// Centimetres. Decimal because paediatric heights are recorded to the mm.
  heightCm           Decimal? @map("height_cm") @db.Decimal(5, 1)
  /// Kilograms, to 100g — the resolution of a clinic scale.
  weightKg           Decimal? @map("weight_kg") @db.Decimal(5, 1)
  /// ⚠️ NOT STORED. BMI is derived from the two above and would go stale the
  ///   moment either is corrected. Computed at read time.
  /// Degrees Celsius. 37.00, never 37.
  ///
  /// ⚠️ CELSIUS IN EVERY COUNTRY, INCLUDING THE ONES THAT WRITE FAHRENHEIT.
  ///   India, the rest of the subcontinent and the United States record a body
  ///   temperature in °F at the bedside, and the vitals form asks in °F there —
  ///   but the COLUMN is Celsius everywhere, because a column whose unit depends
  ///   on the row cannot be trended, range-checked or exported, and FHIR/UCUM
  ///   `Cel` is what ABDM will want it in. The conversion happens once, at the
  ///   edge, in `toCelsius`/`fromCelsius` in @rcln/contracts.
  ///
  /// ⚠️ TWO DECIMALS, NOT ONE, AND THE SECOND ONE IS LOAD-BEARING. 0.1 °C is
  ///   0.18 °F, so a °F reading rounded into one decimal of Celsius does not
  ///   survive the trip back: a nurse types 99.4, it stores 37.4, and the chart
  ///   redraws as 99.3 seconds later. At two decimals 99.4 stores 37.44 and
  ///   reads back 99.4. Nothing clinical needs 0.01 °C; the round trip does.
  temperatureC       Decimal? @map("temperature_c") @db.Decimal(4, 2)
  pulseBpm           Int?     @map("pulse_bpm") @db.SmallInt
  respiratoryRateBpm Int?     @map("respiratory_rate_bpm") @db.SmallInt
  /// The two halves of the blood pressure, apart rather than as "120/80". They
  /// are independently trended and independently out of range.
  systolicMmHg       Int?     @map("systolic_mm_hg") @db.SmallInt
  diastolicMmHg      Int?     @map("diastolic_mm_hg") @db.SmallInt
  /// Oxygen saturation, whole percent.
  spo2Percent        Int?     @map("spo2_percent") @db.SmallInt
  /// mg/dL — the unit Indian clinics report in. Decimal, not float.
  bloodGlucoseMgDl   Decimal? @map("blood_glucose_mg_dl") @db.Decimal(5, 1)
  /// ⚠️ PHI. Free text — "patient was distressed, repeated after 10 min".
  notes              String?  @db.Text

  /// When the observation was taken, which is not when the row was written. The
  /// front desk types up a paper slip an hour later often enough that inferring
  /// one from the other would misdate the trend.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  /// SetNull: the nurse may leave; the reading stays.
  recordedBy String?  @map("recorded_by") @db.Uuid

  /// ⚠️ SET ON A SUPERSEDED VERSION, NULL ON A LIVE READING, AND EVERY QUERY THAT
  ///   RENDERS A CHART MUST FILTER ON IT.
  ///
  ///   A correction keeps the reading's identity and rewrites its values (see
  ///   `amendVitals`), so the numbers that were there before would otherwise be
  ///   gone — and "who changed a blood pressure from 180 to 120, and when" is the
  ///   question a medical record has to be able to answer years later. Before
  ///   each amendment the previous version is copied here, pointing at the
  ///   reading it is a version OF.
  ///
  ///   These rows are NOT observations. They never appear on a chart, never
  ///   count towards a trend, and `listVitals` filters them out with
  ///   `revision_of_id IS NULL`. A future "every BP this year" query must do the
  ///   same, or it will count one measurement once per time somebody fixed a typo
  ///   in it.
  ///
  /// ⚠️ THE VALUES LIVE HERE AND NOT IN `audit_logs`, DELIBERATELY. That table is
  ///   read through `audit.record.read` — a compliance code held by people with
  ///   no clinical access at all — so a blood pressure in it is a disclosure with
  ///   a timestamp. This table is the clinical record: same RLS policy, same
  ///   branch scoping, read behind `clinical.vitals.record`, and every read
  ///   writes a `data_access_logs` row. `audit_logs` still records THAT the
  ///   amendment happened and which measurements moved.
  revisionOfId String?   @map("revision_of_id") @db.Uuid
  /// When this version stopped being the current one. Null on a live reading.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  /// Who amended it — NOT who took the observation, which stays in `recordedBy`.
  supersededBy String?   @map("superseded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  recorder     User?        @relation("VitalRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)
  amender      User?        @relation("VitalSupersededBy", fields: [supersededBy], references: [id], onDelete: SetNull)

  /// Composite, so a version cannot point at a reading in another tenant —
  /// ADR-0004 applied to a self-relation.
  revisionOf AppointmentVital?  @relation("VitalRevisions", fields: [organizationId, revisionOfId], references: [organizationId, id], onDelete: Cascade)
  revisions  AppointmentVital[] @relation("VitalRevisions")

  /// Composite-FK target, so a later child (an observation flag, say) is
  /// cross-tenant-unrepresentable by construction (ADR-0004).
  @@unique([organizationId, id])
  /// The visit's readings, oldest first — how the diagnosis page renders them.
  @@index([organizationId, appointmentId, recordedAt])
  /// The trend: every reading for one person, newest first.
  @@index([organizationId, patientId, recordedAt])
  /// One reading's earlier versions, oldest first.
  @@index([organizationId, revisionOfId, supersededAt])
  @@map("appointment_vitals")
}

/// Every status change, in order. Append-only by construction — nothing updates
/// a row here, and the service writes one inside the same transaction as the
/// change it records.
///
/// WHY A TABLE AND NOT `audit_logs`
///   The clinical questions — how long between check-in and being seen, how many
///   were cancelled after confirmation — are asked of this trail constantly and
///   by ordinary screens. `audit_logs` is the compliance record and gets a row
///   too; it is not something a waiting-time report should have to parse.
///
/// ⚠️ NO `branch_id`, DELIBERATELY. It is reached only through its appointment,
///   and its RLS is an EXISTS against `appointments` — whose own RESTRICTIVE
///   branch policy applies to that subquery, so the branch boundary composes
///   rather than being restated and drifting.
model AppointmentStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  appointmentId  String             @map("appointment_id") @db.Uuid
  /// Null only for the row recording the booking itself.
  fromStatus     AppointmentStatus? @map("from_status")
  toStatus       AppointmentStatus  @map("to_status")
  changedBy      String?            @map("changed_by") @db.Uuid
  /// ⚠️ PHI. Free text a clinician typed. Never audited, never exported.
  note           String?            @db.Text
  changedAt      DateTime           @default(now()) @map("changed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)
  changer      User?        @relation("AppointmentStatusChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, appointmentId, changedAt])
  @@map("appointment_status_history")
}

// =============================================================================
// PATIENT INVOICING
//
// ⚠️ THIS IS NOT `subscription_invoices`, AND THE TWO MUST NEVER BE MERGED.
//   `subscription_invoices` is RCLN billing the CLINIC for its SaaS
//   subscription: our GSTIN, the customer's location as the place of supply,
//   a gateway-driven lifecycle. These tables are the CLINIC billing a PATIENT:
//   the clinic's own GSTIN out of `issuer_tax_registrations`, the BRANCH as the
//   place of supply, a cashier-driven lifecycle, and branch-scoped RLS on top
//   of the tenant policy. Two issuers, two legal obligations, two tables. The
//   full comparison is §0.1 of `.kb/Architecture/invoice-engine-implementation.md`.
//
// PHI-ADJACENT, AND TREATED AS PHI.
//   An invoice names a patient and lists what was done to them — a line reading
//   "MRI Brain with contrast" is a clinical fact. Same rules as the PATIENTS
//   block above: allow-list snapshots into `audit_logs`, ids only in Redis and
//   in logs, never a name in a URL.
//
// WHAT IS AND IS NOT DECIDED HERE
//   Phase 3 is the data model. The arithmetic that fills the money columns is
//   Phase 4 (`packages/invoicing`, pure), and the lifecycle that defends them is
//   Phase 5 — landed, in `20260811090000_invoice_lifecycle_immutability`.
//
//   THREE TRIGGERS, WHICH `prisma migrate diff` CANNOT SEE AND WILL NOT WARN
//   YOU ABOUT. `invoices_lifecycle_guard` holds the transition table and freezes
//   every column of an ISSUED row except status, `amount_paid`, the
//   cancel/void fields and `updated_at`; `invoices_no_delete_after_issue` keeps
//   a numbered invoice in its series; `invoice_children_follow_parent` freezes
//   the lines and tax rows with the document that prints them. The frozen set is
//   an ALLOW-LIST, so a column added to this model tomorrow is immutable after
//   issue by default and somebody has to go and argue for it.
// =============================================================================

/// What the invoice was raised FOR. Drives the `{SOURCE}` segment of the number
/// and, from Phase 7, which invoices a caller is allowed to see at all.
///
/// ⚠️ THE ENUM IS COMPLETE; THE INTEGRATIONS ARE NOT.
///   `LAB`, `PHARMACY` and `INVENTORY` ship as values with nothing writing them,
///   because those modules do not exist yet (roadmap Phases 5 and 6). That is
///   deliberate: an enum value costs a migration to add later and nothing to
///   carry now, and shipping the shape means those modules land as integrations
///   rather than as a redesign of the invoice.
///
/// ⚠️ EACH SOURCE THAT EXISTS GETS ITS OWN COLUMN AND ITS OWN FOREIGN KEY.
///   There is deliberately NO generic `source_id`. A single polymorphic id
///   cannot be foreign-keyed anywhere, and — the part that actually matters —
///   the composite `(organization_id, id)` reference is what makes a
///   cross-tenant link unrepresentable (ADR-0004). A loose uuid would let an
///   invoice cite another clinic's appointment with nothing raising an error,
///   and the mitigation would be "the service remembers to re-read it", which is
///   the class of guarantee this schema exists to replace.
///
///   Stub tables holding just an id were considered and rejected: a link to a
///   table with no `organization_id` proves the row EXISTS and says nothing
///   about who it belongs to, which is the wrong half of the problem. Giving a
///   stub a tenant column makes it a half-designed `lab_orders` written with no
///   lab module behind it — plus an RLS policy and an isolation test for a table
///   that can never hold a row. The column and its FK arrive with the module, in
///   the migration that creates its table anyway.
///
///   `invoices_source_reference_matches_type` is the CHECK that keeps this enum
///   and the columns honest. It gains one clause per module.
enum InvoiceSourceType {
  /// A consultation. The only source integrated end to end today (Phase 8).
  APPOINTMENT
  /// A billable clinical procedure that is not a consultation.
  PROCEDURE
  /// Anything from the clinic's own service catalogue.
  SERVICE
  LAB
  PHARMACY
  INVENTORY
  /// A manual invoice typed by the cashier, citing nothing.
  OTHER
}

/// Where an invoice is in its life.
///
/// ⚠️ `DRAFT` IS THE ONLY STATE IN WHICH ANY MONEY COLUMN MAY MOVE. Everything
///   from ISSUED onwards is a document a patient has been handed and may have
///   claimed against insurance; a mistake is corrected with a credit note and a
///   new invoice, never by editing the totals of one already shown.
///   `invoices_lifecycle_guard` enforces that in the database rather than in the
///   service, and it is the transition table below as well: anything not on the
///   arrows is refused, including the ones that look harmless.
///
///     DRAFT ──▶ FINALIZING ──▶ ISSUED ──▶ PARTIALLY_PAID ──▶ PAID
///       │                        │              │             │
///       ▼                        └──────────────┴─────────────┴──▶ VOID
///     CANCELLED
enum InvoiceStatus {
  /// Being assembled. No number has been issued, so nothing here consumes a
  /// serial — an abandoned draft leaves no gap in the series.
  DRAFT
  /// The brief moment inside finalisation: the number has been taken and the
  /// totals frozen, but the transaction has not committed. A row observed in
  /// this state after a crash is a failed finalisation, not a lost invoice.
  FINALIZING
  /// Issued to the patient. Immutable from here.
  ISSUED
  /// Some money has arrived, and less than `grand_total` has.
  PARTIALLY_PAID
  PAID
  /// Abandoned before it was ever issued. Only reachable from DRAFT, which is
  /// what distinguishes it from VOID — nothing was ever shown to anybody, so
  /// there is nothing to reverse and no credit note to raise.
  CANCELLED
  /// Issued and then reversed. The row and its number stay for ever: voiding is
  /// how a series stays contiguous when a document has to be undone. A void
  /// that involved money also produces a credit note.
  VOID
}

/// How a discount was expressed by whoever entered it.
///
/// The INPUT is kept alongside the computed amount because "10% off" and "₹150
/// off" print differently and are re-derivable from each other only by knowing
/// which one was typed.
enum InvoiceDiscountType {
  /// Basis points, in `discount_bps`. 10% is 1000.
  PERCENTAGE
  /// A currency amount, in `discount_fixed`.
  FIXED
}

/// One patient invoice.
///
/// ⚠️ `invoice_number` IS NULL UNTIL FINALISATION, AND THAT IS THE POINT.
///   The number comes from `issueNumber()`, whose row lock is held to COMMIT, so
///   it is taken as late as possible — at finalisation, not at creation. A draft
///   the cashier abandons therefore burns no serial. See §0.6 of the
///   implementation log for the scope decision behind the format.
///
/// ⚠️ THE NUMBER'S SERIES IS PER BRANCH, AND THE BRANCH CODE IS IN THE NUMBER.
///   `INV-{PERIOD_YEAR}-{SOURCE}-{BRANCH_CODE}-{000001}`. The branch segment is
///   not decoration: GST requires a serial that is consecutive and unique per
///   ISSUER, and the issuer is the GSTIN, which in India is per state. A
///   per-branch counter without a per-branch discriminator gives two branches
///   sharing one GSTIN two different invoices both numbered
///   `INV-2026-APP-000001`, which is the one thing the series may not do.
///   Multiple series under one registration are allowed; a repeated number is
///   not. Branch codes are org-unique, so the whole string is too.
///
/// ⚠️ EVERY TAX FIELD BELOW IS A SNAPSHOT AND IS NEVER RE-READ.
///   Registrations lapse, rates change by statute, and a branch's `region_code`
///   gets corrected. An invoice that recomputed itself from today's
///   configuration would silently restate a document somebody has already filed
///   a return on. What was true at issue is what stays on the row.
model Invoice {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// NOT NULL: the branch is the place of supply, the number series and the RLS
  /// boundary. An invoice with no branch could not be taxed or numbered.
  branchId       String  @map("branch_id") @db.Uuid
  /// Null while DRAFT. See the header.
  invoiceNumber  String? @map("invoice_number") @db.VarChar(64)

  /// What kind of thing this invoice bills for. The discriminator over the
  /// typed reference columns below — see the enum's header.
  sourceType    InvoiceSourceType @map("source_type")
  /// The visit this invoice bills for. Set iff `sourceType` is APPOINTMENT, and
  /// composite-FK'd, so an invoice can never bill another clinic's appointment.
  ///
  /// The first of what will be one column per integrated source: `labOrderId`
  /// arrives with the lab module, `pharmacySaleId` with the pharmacy module,
  /// each in the migration that creates its own table. PROCEDURE, SERVICE and
  /// OTHER carry no reference at all — a manual invoice cites nothing, and the
  /// service catalogue those first two will point at does not exist either.
  ///
  /// ⚠️ NOT UNIQUE, DELIBERATELY. A visit billed, voided and billed again has
  ///   two invoices citing it, and the void must keep its reference or the
  ///   correction cannot be explained. "Is this visit already billed?" is a
  ///   question about the LIVE invoice, which is a lifecycle concern (Phase 5)
  ///   rather than a uniqueness one.
  appointmentId String?           @map("appointment_id") @db.Uuid

  /// Null for a walk-in customer with no record — a supplier's rep buying a
  /// consumable, or a bill raised to a company. Composite-FK'd when present, so
  /// an invoice can never name another tenant's patient.
  patientId String? @map("patient_id") @db.Uuid

  /// ⚠️ THE CUSTOMER BLOCK IS A SNAPSHOT, NOT A JOIN, AND THAT IS NOT
  ///   DENORMALISATION FOR SPEED. A patient marries and changes their surname;
  ///   an address is corrected. The invoice must keep printing what it printed,
  ///   because the copy in the patient's file and the copy in the clinic's
  ///   records have to agree years later. `patient_id` is the link for querying;
  ///   these columns are the document.
  customerName    String  @map("customer_name") @db.VarChar(255)
  customerPhone   String? @map("customer_phone") @db.VarChar(20)
  customerEmail   String? @map("customer_email") @db.VarChar(255)
  customerAddress String? @map("customer_address") @db.Text
  /// The customer's own GSTIN/VAT number, on the rare invoice raised to a
  /// business. Passed to the engine as UNVALIDATED — nothing checks it.
  customerTaxId   String? @map("customer_tax_id") @db.VarChar(32)

  /// WHO PROVIDED THE CARE THIS INVOICE BILLS.
  ///
  /// A bill for a consultation that does not name the clinician is a receipt for
  /// an unattributed service: the patient cannot claim it, an insurer will not
  /// accept it, and the clinic cannot answer "who saw them?" from the document.
  ///
  /// ⚠️ SNAPSHOTTED FOR EXACTLY THE REASON THE CUSTOMER BLOCK ABOVE IS. A doctor
  ///   leaves the clinic, changes their name, or renews under a new council
  ///   number — and the invoices they were named on must go on saying what they
  ///   said. `appointment_id` is the link for querying; these are the document.
  ///   Nothing in the template joins to `appointments` or `doctor_profiles`.
  ///
  /// Null on every source that is not a consultation. A pharmacy dispense has a
  /// PRESCRIBER, which is a different fact deserving its own column when that
  /// module exists — putting it here would print "attended by" on a bill for a
  /// box of tablets nobody was attended for.
  practitionerName               String? @map("practitioner_name") @db.VarChar(255)
  /// Their registration with their council, printed under the name where they
  /// hold one. Read from `doctor_profiles.registration_number` at billing time.
  practitionerRegistrationNumber String? @map("practitioner_registration_number") @db.VarChar(64)
  /// WHO THIS INVOICE BELONGS TO, FOR QUERYING. The live link, where the two
  /// columns above are the printed document — exactly the split between
  /// `patient_id` and `customer_name`.
  ///
  /// ⚠️ IT IS A VISIBILITY BOUNDARY AND NOT A CONVENIENCE. A doctor holds
  ///   `billing.invoice.read` and not `.read_all`, and sees the invoices for the
  ///   care THEY gave — this column is what that filter runs on, in the query
  ///   rather than in a route guard. Reading it off the appointment through a
  ///   join would work today and stop working the moment a lab or pharmacy
  ///   invoice has an ordering clinician and no appointment.
  ///
  /// Null on anything nobody attended: a counter sale, a manual invoice.
  practitionerProfileId          String? @map("practitioner_profile_id") @db.Uuid

  /// ⚠️ THE DATE OF SUPPLY, WHICH IS NOT `issued_at` AND NOT `now()`.
  ///   It is what selects the effective-dated tax rule and the registration, so
  ///   an invoice raised in April for a consultation given in March is taxed as
  ///   March was. Every caller passes it explicitly; `loadTaxContext(at)` is
  ///   handed this value and nothing else.
  suppliedAt DateTime  @map("supplied_at") @db.Timestamptz(6)
  /// When it became a document. Null until then, and the pair with
  /// `invoice_number` — both are set by finalisation or neither is.
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(6)
  dueDate    DateTime? @map("due_date") @db.Date

  /// Which of the clinic's registrations this was issued under. Composite-FK'd,
  /// so an invoice can never be raised under another tenant's GSTIN. Null when
  /// the clinic holds none covering the branch — a legal position, not an
  /// error, and the reason `tax_treatment` has a NOT_REGISTERED value.
  issuerTaxRegistrationId String?      @map("issuer_tax_registration_id") @db.Uuid
  /// The registration number as printed. Snapshotted beside the id because the
  /// row it came from can be corrected and this string may not change.
  issuerTaxId             String?      @map("issuer_tax_id") @db.VarChar(64)
  /// The legal name the registration is held in, which is not always the name
  /// over the door. A GST invoice must print the registered name.
  issuerLegalName         String?      @map("issuer_legal_name") @db.VarChar(255)
  /// Where this supply was deemed to take place — `IN-KA`, `AE`. The BRANCH's
  /// jurisdiction, never the patient's address. Getting this backwards bills a
  /// Karnataka consultation for a Kerala patient as inter-state: IGST instead of
  /// CGST+SGST, and the state's half never reaches the state.
  placeOfSupply           String?      @map("place_of_supply") @db.VarChar(10)
  /// The document-level position, which is the worst of its lines: one UNRATED
  /// line makes the whole invoice unissuable. `isIssuable()` in `@rcln/tax` is
  /// the single definition, so this column and the engine cannot drift.
  taxTreatment            TaxTreatment @default(NOT_REGISTERED) @map("tax_treatment")

  currency String @default("INR") @db.Char(3)

  /// Σ line gross, before any discount. The order every column below is computed
  /// in is fixed in §0.5 of the implementation log and implemented once, in
  /// Phase 4's `priceInvoice`.
  subtotal             Decimal              @default(0) @db.Decimal(14, 2)
  /// Σ per-line discounts.
  lineDiscountTotal    Decimal              @default(0) @map("line_discount_total") @db.Decimal(14, 2)
  /// The invoice-level discount AS ENTERED. Null means none.
  discountType         InvoiceDiscountType? @map("discount_type")
  /// Set iff `discount_type` is PERCENTAGE. Basis points, so the input stays an
  /// integer. Enforced by CHECK — the two input columns and the type agree or
  /// the row does not go in.
  discountBps          Int?                 @map("discount_bps")
  /// Set iff `discount_type` is FIXED.
  discountFixed        Decimal?             @map("discount_fixed") @db.Decimal(14, 2)
  /// What the invoice-level discount came to once apportioned.
  ///
  /// ⚠️ APPORTIONED ACROSS THE LINES BEFORE TAX, NOT SUBTRACTED AFTER IT.
  ///   A discount that reduces what the customer pays reduces the taxable value
  ///   of the supply. Tax computed on the pre-discount amount is over-collected
  ///   tax, remitted to an authority on money nobody ever received. The split is
  ///   pro-rata by taxable amount, largest-remainder so the parts sum to the
  ///   whole exactly, and it lands in `invoice_items.apportioned_discount`. This
  ///   is a deliberate deviation from the original brief's §7 sketch.
  invoiceDiscountTotal Decimal              @default(0) @map("invoice_discount_total") @db.Decimal(14, 2)
  /// Σ line taxable — what tax was actually computed on.
  taxableAmount        Decimal              @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  /// Σ every `invoice_taxes` row. Rounded PER LINE, not per invoice: the two
  /// differ by up to (n−1) minor units, and per-line is what a GST invoice does
  /// and what makes each printed line internally consistent.
  taxTotal             Decimal              @default(0) @map("tax_total") @db.Decimal(14, 2)
  /// Cash rounding to the nearest note, where a clinic does that. Signed, and
  /// kept as its own column so `grand_total` never has to be explained.
  roundingAdjustment   Decimal              @default(0) @map("rounding_adjustment") @db.Decimal(14, 2)
  grandTotal           Decimal              @default(0) @map("grand_total") @db.Decimal(14, 2)
  /// Settled so far. The balance is `grand_total − amount_paid` and is
  /// deliberately NOT a column: a stored balance is a third number that can
  /// disagree with the two it is derived from.
  amountPaid           Decimal              @default(0) @map("amount_paid") @db.Decimal(14, 2)

  status InvoiceStatus @default(DRAFT)

  /// ⚠️ PHI-CAPABLE FREE TEXT, printed on the invoice. In `REDACTED_KEYS`.
  notes              String? @db.Text
  /// Why it was cancelled or voided. Same PHI treatment as `notes`.
  cancellationReason String? @map("cancellation_reason") @db.Text

  createdBy   String?   @map("created_by") @db.Uuid
  /// Who finalised it. The accountable act — a draft's editor is in audit_logs.
  issuedBy    String?   @map("issued_by") @db.Uuid
  cancelledBy String?   @map("cancelled_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete for a DRAFT only. An issued invoice is never deleted by any
  /// path — it is VOIDed, which keeps the number and the trail.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch             Branch                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  patient            Patient?               @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  /// Restrict: a visit that has been billed cannot be deleted out from under its
  /// invoice. Appointments are soft-deleted anyway, so this only ever fires on a
  /// hard delete somebody meant to be harmless.
  appointment        Appointment?           @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Restrict: a registration that priced issued invoices cannot be deleted out
  /// from under them. `effective_to` is how a registration is retired.
  issuerRegistration IssuerTaxRegistration? @relation(fields: [organizationId, issuerTaxRegistrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Composite FK, per ADR-0004: the tenant travels in the key, so an invoice can
  /// never be attributed to another clinic's clinician.
  ///
  /// Restrict, like `appointment` above and for the same reason — a clinician
  /// whose work has been billed cannot be hard-deleted out from under the
  /// invoices that name them. Doctor profiles are soft-deleted anyway, so this
  /// only ever fires on a delete somebody meant to be harmless. (`SetNull` is not
  /// available: the key includes `organization_id`, which is NOT NULL.)
  practitioner       DoctorProfile?         @relation("InvoicePractitioner", fields: [organizationId, practitionerProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  creator            User?                  @relation("InvoiceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  issuer             User?                  @relation("InvoiceIssuedBy", fields: [issuedBy], references: [id], onDelete: SetNull)
  canceller          User?                  @relation("InvoiceCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)

  items     InvoiceItem[]
  taxes     InvoiceTax[]
  documents InvoiceDocument[]

  /// ⚠️ THE ONE UNIQUE IN THIS SCHEMA THAT WANTS NULLS **DISTINCT**, WHICH IS
  ///   POSTGRES' DEFAULT — so it is written plainly and this comment exists
  ///   because CONVENTIONS.md says every nullable unique gets NULLS NOT
  ///   DISTINCT. Here the opposite is required: every DRAFT has a NULL
  ///   `invoice_number`, and a clinic has many drafts open at once. NULLS NOT
  ///   DISTINCT would let it hold exactly one.
  ///
  ///   Org-wide rather than per branch, which is STRONGER than the legal
  ///   requirement and safe because the branch code is inside the string.
  @@unique([organizationId, invoiceNumber])
  /// Composite-FK target for items, taxes and documents (ADR-0004).
  @@unique([organizationId, id])
  /// The invoice list: one branch, newest first, filtered by state.
  @@index([organizationId, branchId, status, createdAt])
  /// "What does this patient owe?" — and the ledger on the patient page.
  @@index([organizationId, patientId, createdAt])
  /// "Has this appointment been billed?", asked once per row on the day board.
  @@index([organizationId, appointmentId])
  @@map("invoices")
}

/// One billable line.
///
/// ⚠️ CARRIES ITS OWN `organization_id` AND `branch_id` RATHER THAN HANGING OFF
///   THE INVOICE, and that is a security decision rather than a convenience.
///   Its parent is BRANCH-scoped. A child with no tenant columns can only be
///   protected by a policy that reaches into the parent, and such a policy
///   evaluates with row security DISABLED on the table it reads — so the branch
///   half has to be restated by hand, exactly as `appointment_status_history`
///   was forced to. Carrying both columns makes this an ordinary member of both
///   RLS loops instead, which is the same call `appointment_vitals` made and for
///   the same reason. The service copies both from the invoice; the composite FK
///   is what stops them disagreeing.
///
/// ⚠️ NO `deleted_at`, DELIBERATELY. A line is hard-deleted while the invoice is
///   DRAFT and cannot be touched afterwards. A soft-deleted line is a row that
///   every total in Phase 4 must remember to exclude, and the first query that
///   forgets prices an invoice that does not match its own printout.
model InvoiceItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  invoiceId      String @map("invoice_id") @db.Uuid

  /// Print order, 1-based. Explicit rather than implied by `created_at`,
  /// because a cashier reorders lines and a reprint must match the original.
  lineNumber  Int     @map("line_number") @db.SmallInt
  description String  @db.VarChar(255)
  /// The HSN/SAC code printed on the line. Presentation only — `tax_category`
  /// is what actually selects the rate, and the two are separate so a clinic can
  /// print a code without that string silently becoming a lookup key.
  itemCode    String? @map("item_code") @db.VarChar(32)
  /// ⚠️ THE KEY INTO `tax_rules`, MATCHED EXACTLY. There is no HSN prefix tree,
  ///   deliberately: a prefix match that resolved `30049099` to the broader
  ///   `3004` heading would apply a confident, unreviewed rate. A category with
  ///   no rule comes back UNRATED and Phase 5 refuses to issue the invoice.
  taxCategory String  @map("tax_category") @db.VarChar(64)

  /// Decimal(14,3): half a tablet is real, and so is 0.5 hours of physiotherapy.
  quantity  Decimal @default(1) @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)

  /// round(unit_price × quantity). Stored rather than derived because every
  /// later column is computed from the ROUNDED value, and re-deriving it in a
  /// query would reintroduce the fraction the rounding removed.
  grossAmount         Decimal              @map("gross_amount") @db.Decimal(14, 2)
  /// The line's own discount, as entered. Same three-column shape and same
  /// CHECK as the invoice.
  discountType        InvoiceDiscountType? @map("discount_type")
  discountBps         Int?                 @map("discount_bps")
  discountFixed       Decimal?             @map("discount_fixed") @db.Decimal(14, 2)
  discountAmount      Decimal              @default(0) @map("discount_amount") @db.Decimal(14, 2)
  /// This line's share of the INVOICE-level discount, pro-rata by taxable
  /// amount with the remainder distributed largest-first. Kept apart from
  /// `discount_amount` so the printed line can show the discount the customer
  /// asked for separately from the one the whole bill got.
  apportionedDiscount Decimal              @default(0) @map("apportioned_discount") @db.Decimal(14, 2)
  /// gross − discount − apportioned. What tax is computed on.
  taxableAmount       Decimal              @map("taxable_amount") @db.Decimal(14, 2)
  /// Σ this line's `invoice_taxes` rows.
  taxAmount           Decimal              @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal           Decimal              @map("line_total") @db.Decimal(14, 2)

  /// Why this line was taxed the way it was, per line and not per invoice: a
  /// bill can carry an EXEMPT consultation and a STANDARD-rated medicine.
  taxTreatment TaxTreatment @default(UNRATED) @map("tax_treatment")
  /// The engine's own explanation, printed on the invoice where a jurisdiction
  /// requires one ("Healthcare services — exempt under Notification 12/2017").
  /// ⚠️ Never a message built for a developer: this reaches a patient.
  taxReason    String?      @map("tax_reason") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)

  taxes InvoiceTax[]

  /// Composite-FK target so `invoice_taxes` can cite the line it priced.
  @@unique([organizationId, id])
  /// Two lines cannot claim the same position on one document.
  @@unique([organizationId, invoiceId, lineNumber])
  @@index([organizationId, invoiceId])
  @@map("invoice_items")
}

/// One PRINTED tax line on one invoice item.
///
/// ⚠️ A RATE AND A LINE ARE NOT THE SAME THING, WHICH IS WHY THIS TABLE IS PER
///   LINE AND NOT PER RATE. 12% in Karnataka prints as two rows of 6% owed to
///   two different governments; the same 12% in Singapore prints as one; British
///   Columbia prints two rows at two different rates. The arithmetic is
///   identical and only the presentation differs, so the presentation is data —
///   `@rcln/tax` decides it, and this table records what it decided.
///
/// ⚠️ EVERYTHING HERE IS SNAPSHOTTED, INCLUDING THE NAME. Rates change by
///   statute and a rule can be retired. `name` is what the authority calls it,
///   printed verbatim: a line reading "Tax" is compliant nowhere.
model InvoiceTax {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  /// Denormalised from the item so the invoice's tax summary is one indexed
  /// read rather than a join through every line.
  invoiceId      String @map("invoice_id") @db.Uuid
  invoiceItemId  String @map("invoice_item_id") @db.Uuid

  /// Which rule priced this line, for the auditor who asks why.
  ///
  /// ⚠️ EXACTLY ONE OF THE TWO IS SET, ENFORCED BY CHECK — a rate resolves
  ///   either from the clinic's own `tax_rules` or, inherited, from rcln's
  ///   `tax_rule_defaults`, and which one it was is the difference between "the
  ///   clinic chose this" and "the clinic accepted our published default".
  ///   Collapsing them into one nullable id would destroy that distinction, and
  ///   it is the distinction the rate-card screen exists to show. Both are NULL
  ///   only where no rule was involved at all: an UNRATED or NOT_REGISTERED
  ///   line, or a rate that came from an external tax provider.
  taxRuleId        String? @map("tax_rule_id") @db.Uuid
  taxRuleDefaultId String? @map("tax_rule_default_id") @db.Uuid

  /// `CGST`, `SGST`, `IGST`, `VAT`, `HST`, `PST`, `Consumption Tax`.
  name          String       @db.VarChar(32)
  /// Which authority it is owed to — `IN` for CGST, `IN-KA` for SGST. One supply
  /// carrying two lines to two governments is exactly what a GST split is, and
  /// without this column the two halves are indistinguishable on a return.
  jurisdiction  String?      @db.VarChar(10)
  /// Basis points, snapshotted. 6% is 600.
  rateBps       Int          @map("rate_bps")
  /// What this rate was applied to. Equal to the item's `taxable_amount` for
  /// every rule this engine computes, and NOT redundant: a stacked provincial
  /// tax elsewhere may be levied on a different base, and a provider quote
  /// supplies its own.
  taxableAmount Decimal      @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount     Decimal      @map("tax_amount") @db.Decimal(14, 2)
  treatment     TaxTreatment

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  invoice        Invoice         @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  item           InvoiceItem     @relation(fields: [organizationId, invoiceItemId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  /// Restrict on both: the row that explains a charge outlives the screen that
  /// created it. A rate is withdrawn with `effective_to`, never a DELETE.
  taxRule        TaxRule?        @relation(fields: [organizationId, taxRuleId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  taxRuleDefault TaxRuleDefault? @relation(fields: [taxRuleDefaultId], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceId])
  @@index([organizationId, invoiceItemId])
  @@map("invoice_taxes")
}

/// The join between an invoice and a file in `files`.
///
/// A separate table rather than a `file_id` column on `invoices` because one
/// invoice legitimately has several documents over its life — the invoice PDF, a
/// credit note against it, a reprint after a FAILED render — and the current one
/// of each kind has to be findable without the invoice row growing a column per
/// document type.
///
/// ⚠️ `file_id` IS A PLAIN FK, NOT THE COMPOSITE ONE ADR-0004 ASKS FOR.
///   `files.organization_id` is NULLABLE — platform assets live in the same
///   table — so a composite FK from a NOT NULL column cannot reference it. The
///   tenant guarantee is therefore restored in the policy layer instead: a
///   RESTRICTIVE `file_in_same_org` policy in enable-rls.sql, written the same
///   way `invitation_branches.branch_in_same_org` was and for the same reason.
///   Removing that policy silently re-opens a cross-tenant reference.
model InvoiceDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  invoiceId      String       @map("invoice_id") @db.Uuid
  fileId         String       @map("file_id") @db.Uuid
  documentType   DocumentType @map("document_type")

  /// Which template drew it, and which revision of that template.
  ///
  /// ⚠️ PROVENANCE, NOT A FEATURE FLAG. Nothing reads these back to choose a
  ///   renderer — an issued invoice's PDF is generated once and never
  ///   regenerated, so there is no code path that could. They exist so that
  ///   "what did the document this patient is holding actually look like?" has
  ///   an answer years later, when the template has moved on several revisions
  ///   and the only copy of the old one is in the git history. Without them the
  ///   stored bytes are the sole record of their own layout, which is fine until
  ///   the question is about a document somebody has disputed.
  ///
  ///   `@rcln/documents` owns both values — `INVOICE_TEMPLATE_KEY` and
  ///   `INVOICE_TEMPLATE_VERSION`. A second document type takes a new KEY; a
  ///   change to how this one looks bumps the VERSION.
  templateKey     String @map("template_key") @db.VarChar(64)
  templateVersion Int    @map("template_version") @db.SmallInt

  generatedAt  DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  generatedBy  String?   @map("generated_by") @db.Uuid
  /// Set when a newer document of the same kind replaces this one — which can
  /// only happen for a render that FAILED. An issued invoice's PDF is immutable,
  /// so a corrected invoice is a credit note plus a new invoice, never a version
  /// 2 of this file.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  /// Restrict: nothing may delete the PDF an issued invoice points at. There is
  /// deliberately no `deleteDocument` in DocumentService either.
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  generator    User?        @relation("InvoiceDocumentGeneratedBy", fields: [generatedBy], references: [id], onDelete: SetNull)

  /// ⚠️ THE "ONE CURRENT DOCUMENT PER TYPE" UNIQUE IS **NOT DECLARED HERE**, and
  ///   that is deliberate. It is PARTIAL — `WHERE superseded_at IS NULL` — which
  ///   Prisma cannot express, and a declared total unique would both be a lie
  ///   about the shape and make `migrate diff` propose renaming the real index
  ///   on every run. It is created by hand in the migration as
  ///   `invoice_documents_current_per_type_key`, the same treatment the
  ///   expression trigram index on `patients` gets. A non-partial unique would
  ///   refuse the retry after a FAILED render, which is the exact case
  ///   `superseded_at` exists to allow.
  @@index([organizationId, invoiceId])
  @@index([organizationId, fileId])
  @@map("invoice_documents")
}

// =============================================================================
// SETTINGS / FILES / AUDIT
// =============================================================================

/// Adding a new setting is an INSERT here — no migration, no new column.
///
/// This is a PLATFORM CATALOGUE, not tenant data: no organization_id, no RLS
/// policy, EXEMPT in check-rls.ts. Every clinic reads the same twelve rows.
model SettingDefinition {
  key              String          @id @db.VarChar(128)
  module           String          @db.VarChar(64)
  dataType         SettingDataType @map("data_type")
  defaultValue     Json            @map("default_value")
  allowedScopes    Json            @map("allowed_scopes")
  isTenantEditable Boolean         @default(true) @map("is_tenant_editable")
  /// The short human name. What the settings screen puts on the row.
  description      String?         @db.VarChar(512)
  /// What the setting is for, and what changing it does. Prose, one or two
  /// sentences, written for whoever runs the clinic rather than for us.
  helpText         String?         @map("help_text") @db.VarChar(1024)
  /// A closed set of choices: `[{ "value": …, "label": … }]`.
  ///
  /// Null means "any value of `data_type`". Present means the API refuses
  /// anything else and the screen renders a select instead of a text box — one
  /// source, so the two cannot disagree. JSONB as a DOCUMENT, never as foreign
  /// keys (ADR-0006): these are literal setting values, not row ids.
  allowedValues    Json?           @map("allowed_values")

  values SettingValue[]

  @@index([module])
  @@map("setting_definitions")
}

/// Resolution, most specific wins:
/// USER/PATIENT -> BRANCH -> ORGANIZATION -> PLATFORM -> definition default.
model SettingValue {
  id         String           @id @default(uuid()) @db.Uuid
  settingKey String           @map("setting_key") @db.VarChar(128)
  scopeType  SettingScopeType @map("scope_type")
  /// null only when scopeType = PLATFORM
  scopeId    String?          @map("scope_id") @db.Uuid
  value      Json
  updatedBy  String?          @map("updated_by") @db.Uuid
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  definition SettingDefinition @relation(fields: [settingKey], references: [key], onDelete: Cascade)

  @@unique([settingKey, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("setting_values")
}

/// What a stored document IS, independent of what generated it.
///
/// Deliberately a document taxonomy rather than a module list — `INVOICE_PDF`,
/// not `BILLING`. The invoice engine is the first thing to write here and will
/// not be the last (§31: lab reports, prescriptions, consent forms, patient
/// attachments, referral letters), and a `DocumentService` keyed by which
/// module called it is a `DocumentService` that every new module has to edit.
enum DocumentType {
  /// The frozen PDF of an issued invoice. See `DocumentStatus` for why it has
  /// a lifecycle at all.
  INVOICE_PDF
  /// A credit note against an invoice.
  CREDIT_NOTE_PDF
  /// Anything a user uploaded rather than the system generating. The historical
  /// meaning of every row in this table before the invoice engine existed, and
  /// therefore the default.
  UPLOAD
}

/// Whether the bytes are actually there yet.
///
/// ⚠️ THIS EXISTS SO THAT "THE INVOICE IS ISSUED" AND "THE PDF EXISTS" CAN BE
///   TWO DIFFERENT FACTS, WHICH THEY GENUINELY ARE (§40, §42).
///   Rendering a PDF can fail — a missing logo, an out-of-memory renderer, a
///   full disk. If the only record of a document were its row, a failed render
///   would leave an issued invoice pointing at a file that 404s, and the
///   failure would be discovered by a patient at the front desk. With a status,
///   the invoice is issued (which is a financial fact, and correct), the
///   document is FAILED, and the screen can say so and offer a retry.
///
///   It is also what lets PDF generation move to a queue later (§41) without a
///   schema change: a worker picks up PENDING, sets GENERATING, and the API
///   never changes.
enum DocumentStatus {
  /// Recorded, not yet rendered. The state a queued generation starts in.
  PENDING
  /// A renderer has claimed it. Distinct from PENDING so a crashed worker's
  /// rows are findable rather than looking like fresh work forever.
  GENERATING
  /// Bytes are in storage and the checksum is recorded. The only state a
  /// download may be served from.
  READY
  /// Rendering failed. `failure_reason` says why, for an operator — never for
  /// a client.
  FAILED
}

/// Every document the platform stores, generated or uploaded: the one table
/// `DocumentService` writes to (§31).
///
/// ⚠️ THE BYTES ARE NOT IN HERE, AND MUST NOT BE (§27).
///   This row is metadata plus a `storage_key`. Which provider holds the bytes
///   is `storage_provider`, and moving a tenant from local disk to S3 is a copy
///   of the objects and an UPDATE of that one column — every row already
///   written keeps its key and nothing above `@rcln/storage` moves.
///
/// ⚠️ THERE IS NO URL COLUMN, DELIBERATELY.
///   A stored URL is either public (which invoice PDFs must never be) or
///   expired (which a persisted signed URL always is, within the hour). The
///   download route mints one per request after checking authorization, or
///   streams the bytes itself when the provider has no URL space.
model StoredFile {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String?        @map("organization_id") @db.Uuid
  branchId        String?        @map("branch_id") @db.Uuid
  documentType    DocumentType   @default(UPLOAD) @map("document_type")
  status          DocumentStatus @default(READY)
  /// Which `StorageProvider` implementation holds the bytes — `local` or `s3`.
  /// A string rather than an enum: it names an implementation in a package, not
  /// a domain concept, and adding one should not be a migration.
  storageProvider String         @default("local") @map("storage_provider") @db.VarChar(16)
  storageKey      String         @unique @map("storage_key") @db.VarChar(512)
  originalName    String         @map("original_name") @db.VarChar(255)
  mimeType        String         @map("mime_type") @db.VarChar(128)
  /// Zero until the bytes land. Nullable would be more honest and would also
  /// mean every reader handles a null it can do nothing with.
  sizeBytes       BigInt         @default(0) @map("size_bytes")
  /// Lowercase hex SHA-256, computed by the provider over what it actually
  /// wrote — never supplied by the caller. Null until READY.
  checksum        String?        @db.VarChar(128)
  /// Bumped when a FAILED document is regenerated. An issued invoice's PDF is
  /// immutable (§23), so this only ever moves for a document that never
  /// successfully existed — a corrected invoice is a credit note plus a new
  /// invoice, not a version 2 of this file.
  version         Int            @default(1) @db.SmallInt
  /// Why rendering failed, for an operator reading logs. ⚠️ Never returned to
  /// a client and never allowed to carry PHI — see `document.service.ts`.
  failureReason   String?        @map("failure_reason") @db.VarChar(500)
  uploadedBy      String?        @map("uploaded_by") @db.Uuid
  uploadedAt      DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader         User?             @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  invoiceDocuments InvoiceDocument[]

  /// The composite-FK target (ADR-0004) so a document can be referenced from a
  /// tenant table without the reference being able to cross tenants.
  ///
  /// Unlike every other nullable-column unique in this schema, this one needs
  /// NO `NULLS NOT DISTINCT` rewrite: `id` is the primary key, so the pair is
  /// unique whatever `organization_id` does, and the index is only ever an FK
  /// target rather than a constraint in its own right. Stated because the
  /// convention says otherwise and the next reader will check.
  @@unique([organizationId, id])
  @@index([organizationId, branchId])
  /// Finding a tenant's documents of one kind — the invoice list's join, and
  /// the sweep that retries FAILED renders.
  @@index([organizationId, documentType, status])
  @@map("files")
}

/// Written on every mutation by Prisma middleware. Partition by month once this
/// grows — retrofitting partitioning onto a large table is painful.
model AuditLog {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String?     @map("organization_id") @db.Uuid
  branchId             String?     @map("branch_id") @db.Uuid
  actorUserId          String?     @map("actor_user_id") @db.Uuid
  impersonatedByUserId String?     @map("impersonated_by_user_id") @db.Uuid
  action               AuditAction
  entityType           String      @map("entity_type") @db.VarChar(64)
  entityId             String?     @map("entity_id") @db.Uuid
  beforeData           Json?       @map("before_data")
  afterData            Json?       @map("after_data")
  ipAddress            String?     @map("ip_address") @db.Inet
  userAgent            String?     @map("user_agent") @db.VarChar(512)
  occurredAt           DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_logs")
}

/// What a PHI read was: a view, a search, a print, an export, a share.
enum DataAccessType {
  VIEW
  SEARCH
  PRINT
  EXPORT
  SHARE
}

/// What kind of record was read. Not the table name — the clinical noun, so the
/// enum survives a table being split or renamed.
enum DataAccessResource {
  PATIENT
  PATIENT_LIST
  MEDICAL_HISTORY
  APPOINTMENT
  /// Observations taken at a visit. Kept apart from MEDICAL_HISTORY because the
  /// two answer different questions in a disclosure review: history is what the
  /// patient brought with them, vitals are what this clinic measured.
  VITALS
  PRESCRIPTION
  LAB_REPORT
  INVOICE
  DOCUMENT
}

/// Who looked at whose record. The read-side counterpart to `audit_logs`.
///
/// WHY THIS IS A SEPARATE TABLE AND NOT AN `AuditAction.READ`
///   `audit_logs` answers "what changed", and the per-record history screen
///   already reads it by `(entity_type, entity_id)`. Folding millions of read
///   rows into it would drown that screen, and would let every caller of
///   `recordAudit` write into the immutable mutation trail. Two questions, two
///   tables, two helpers.
///
/// ⚠️ THE SCHEMA CONTRACT: IDS, ENUMS, COUNTS AND A HASH. NOTHING ELSE.
///   No names, no phone numbers, no free text, ever. This table is built to be
///   readable by compliance and security people who have no business reading
///   patient records, so a name landing here is a disclosure, not a log line.
///   `query_hash` is a SHA-256 of the normalised search term — enough to prove
///   two searches were the same, never enough to recover a surname. `route` is
///   the matched route pattern (`GET /v1/patients/:id`), NOT the URL, because a
///   URL carries the search string with it.
///
/// ONE ROW PER REQUEST, NEVER PER RESULT ROW. A search writes a single row with
/// `resultCount` set and `patientId` null; a detail view writes one naming the
/// patient. See `recordDataAccess` for the dedupe window that keeps a doctor
/// tabbing between panels of one chart from writing thirty rows.
///
/// Append-only, enforced by Postgres in two independent layers exactly as
/// `audit_logs` is — see the `data_access_log_immutability` migration.
///
/// TODO: partition by RANGE (occurred_at) once this grows. Prisma cannot declare
/// a partitioned table, so it is deliberately not partitioned today; the same
/// note stands on AuditLog.
model DataAccessLog {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  branchId             String?            @map("branch_id") @db.Uuid
  actorUserId          String?            @map("actor_user_id") @db.Uuid
  impersonatedByUserId String?            @map("impersonated_by_user_id") @db.Uuid
  /// Null when the read resolved no single patient — a search, or a list.
  patientId            String?            @map("patient_id") @db.Uuid
  accessType           DataAccessType     @map("access_type")
  resource             DataAccessResource
  resourceId           String?            @map("resource_id") @db.Uuid
  /// How many records came back. 1 for a detail view.
  resultCount          Int                @default(1) @map("result_count")
  /// SHA-256 of the normalised search term. NEVER the term.
  queryHash            String?            @map("query_hash") @db.Char(64)
  /// The matched route pattern, never the URL. See the warning above.
  route                String?            @db.VarChar(128)
  ipAddress            String?            @map("ip_address") @db.Inet
  userAgent            String?            @map("user_agent") @db.VarChar(512)
  occurredAt           DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// "Who has looked at this patient?" — the subject-access question.
  @@index([organizationId, patientId, occurredAt])
  /// "What has this member of staff been reading?" — the misuse question.
  @@index([organizationId, actorUserId, occurredAt])
  @@map("data_access_logs")
}

// ---------------------------------------------------------------------------
// Document numbering
// ---------------------------------------------------------------------------

enum NumberSequenceType {
  UHID
  MRN
  APPOINTMENT
  QUEUE_TOKEN
  /// Staff employee codes, issued when an invitation is accepted.
  EMPLOYEE
  /// Patient invoice serials. One counter per (branch, source, period) — the
  /// source and the period share `period_key` (`'2026-27:APP'` in India,
  /// `'2026:APP'` where the year is the calendar one). See §0.6 of the
  /// invoice-engine log for why the series is per branch, and
  /// `invoice-number.service.ts` for the only code that builds the key.
  INVOICE
}

/// One counter per (organization, branch, type, period). The issuer for every
/// human-facing document number: UHID, branch-local MRN, appointment number and
/// the daily queue token.
///
/// `periodKey` generalises the "financial year" of the original design so one
/// mechanism serves all four reset cadences:
///   ''                        never resets (UHID, MRN)
///   '2026-27'                 financial year (appointment numbers)
///   '<date>:<doctorProfileId>' per doctor per day (queue tokens)
///
/// WHY NOT A POSTGRES SEQUENCE
///   `nextval` is deliberately non-transactional, so a booking that rolls back
///   would burn an appointment number permanently. It would also need one
///   sequence OBJECT per (org, branch, type, period) — runtime DDL, which
///   `rcln_app` cannot execute and should never be able to.
///
/// Numbers are issued by `issueNumber()` with a single `ON CONFLICT DO UPDATE`
/// statement whose row lock makes concurrent issues gapless. See that service.
///
/// ⚠️ ORG-SCOPED RLS ONLY — DELIBERATELY NO `branch_isolation` POLICY.
///   `ON CONFLICT DO UPDATE` against a row RLS hides does not update it; it
///   raises a duplicate-key error instead. A branch-scoped policy here would
///   turn "this branch is outside your scope" into a mystifying 23505 at the
///   moment of booking. Isolation is the tenant policy plus the explicit
///   `organizationId` every call passes.
model NumberSequence {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  /// Null for an org-wide counter (UHID). Set for everything branch-local.
  branchId       String?            @map("branch_id") @db.Uuid
  sequenceType   NumberSequenceType @map("sequence_type")
  periodKey      String             @default("") @map("period_key") @db.VarChar(64)
  /// ⚠️ 64, NOT 16, BECAUSE AN INVOICE PREFIX CARRIES THE BRANCH CODE.
  ///   `INV-2026-APP-MAIN-` is already 18 characters and `branches.code` may be
  ///   32 on its own. The old width was sized for `P` and `MRN-` and failed at
  ///   the moment of billing with a raw Postgres 22001 — found by the first
  ///   invoice this repository ever numbered, not by any type.
  prefix         String             @default("") @db.VarChar(64)
  padding        Int                @default(6) @db.SmallInt
  lastNumber     BigInt             @default(0) @map("last_number")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// ⚠️ Rewritten as NULLS NOT DISTINCT in the migration — `branchId` is null on
  /// every org-wide counter, and a plain unique index does not constrain nullable
  /// columns, so two UHID counters could otherwise coexist. It is also the
  /// ON CONFLICT arbiter, which requires the index to actually match.
  @@unique([organizationId, branchId, sequenceType, periodKey])
  @@map("number_sequences")
}

// ---------------------------------------------------------------------------
// Marketing (apex domain, pre-tenant)
// ---------------------------------------------------------------------------

enum DemoRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  SPAM
}

/// A demo request from the public landing page at the apex domain.
///
/// Deliberately NOT tenant-scoped, and this is the one model where that is the
/// correct answer rather than an oversight: the person submitting it has no
/// organization yet, so there is no `organization_id` to put on the row and no
/// tenant context for an RLS policy to read. Giving it a policy requiring
/// `app.current_org` would make the table permanently unwritable.
///
/// Recorded as an exemption in prisma/rls/enable-rls.sql and in the EXEMPT list
/// in scripts/check-rls.ts. Access is gated in the application layer: one
/// public, rate-limited, write-only endpoint, and reads restricted to platform
/// admins.
///
/// Contact details, never clinical data.
model DemoRequest {
  id          String            @id @default(uuid()) @db.Uuid
  clinicName  String            @map("clinic_name") @db.VarChar(255)
  contactName String            @map("contact_name") @db.VarChar(255)
  email       String            @db.VarChar(255)
  phone       String            @db.VarChar(20)
  city        String?           @db.VarChar(100)
  branchCount Int?              @map("branch_count")
  specialty   String?           @db.VarChar(120)
  message     String?           @db.Text
  /// Referrer or campaign label. Must never carry anything identifying.
  source      String?           @db.VarChar(255)
  status      DemoRequestStatus @default(NEW)
  handledAt   DateTime?         @map("handled_at") @db.Timestamptz(6)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([email])
  @@map("demo_requests")
}
