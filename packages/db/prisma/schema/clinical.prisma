// =============================================================================
// CLINICAL — the consultation engine's vocabulary and its journey.
//
// CE-1 ships the FOUNDATION: what a clinic can say, and what treatment journey
// it is saying it about. No consultation yet — `encounters` lands in CE-3.
//
// Full reasoning: .kb/Consultation/. Decisions are cited as CD-n from
// .kb/Consultation/DECISIONS.md.
//
// ── THREE TENANCY CLASSES, AND THE SEAM IS "WHOSE FACT IS IT" ────────────────
//
//   PLATFORM-EXTENSIBLE, organization_id NULLABLE
//     clinical_master_items · clinical_master_codings · clinical_master_scopes ·
//     product_clinical_scopes
//
//   ORG-SCOPED, no branch
//     clinical_episodes · animal_profiles
//
//   ORG + BRANCH SCOPED
//     encounter_follow_up_recommendations
//
// "Tooth pain", "Dental caries" and "Root canal treatment" are WORDS. Every
// clinic needs the same few hundred on the day it opens, and shipping them as
// platform rows is what lets a dentist record a first consultation without
// inventing a vocabulary first. Same argument `stock_reason_codes` makes.
//
// A patient's treatment JOURNEY is not a word. It is a fact about one person at
// one clinic, so it is org-scoped and it is PHI.
//
// ⚠️ THE PLATFORM-EXTENSIBLE POLICY HERE IS `specialties`', NOT `files`'.
//   `files` permits a NULL organization_id in its WITH CHECK, which is right for
//   an asset the platform uploads on a tenant's behalf. Reproducing it here
//   would let ANY CLINIC INSERT A PLATFORM-WIDE DIAGNOSIS — a row with
//   organization_id NULL, instantly visible to every other tenant, writable by
//   anyone holding `clinical.master.manage`. Read is permissive; write is not.
//
// ⚠️ PHI LIVES IN THIS FILE. `clinical_episodes.title` is a clinical statement
//   about a named person ("Androgenetic alopecia — management") and so is every
//   text column on a follow-up recommendation. None of it reaches an audit row;
//   all of it is in REDACTED_KEYS; reads that disclose one patient write a
//   `data_access_logs` row.
// =============================================================================

/// What KIND of clinical word this is.
///
/// ⚠️ ONE TABLE WITH A DISCRIMINATOR, NOT SEVEN TABLES (CD-5). This is the house
///   pattern: `products` is one table with a `ProductType` discriminator over
///   twelve types (PI-ADR-001), and `specialties` deliberately collapsed a
///   specialties / sub-specialties / specialization-map triple into one
///   self-referencing master.
///
///   Seven near-identical tables would mean seven search endpoints, seven
///   scope join tables, seven coding tables and seven RLS policies that have to
///   stay in step with one another. They differ in nothing but this column.
enum ClinicalMasterKind {
  /// What the patient reports. "Hair fall", "Tooth pain".
  SYMPTOM
  /// What the clinician concludes. "Androgenetic alopecia", "Dental caries".
  DIAGNOSIS
  /// What is done about it. "Root canal treatment", "Chemical peel".
  PROCEDURE
  /// What is ordered. "CBC", "OPG", "Biopsy".
  ///
  /// ⚠️ NOT A LAB TEST. The lab module does not exist (only its permission
  ///   codes do). An investigation here is the ORDER's vocabulary; when the lab
  ///   ships, its catalogue references these rather than replacing them.
  INVESTIGATION
  /// What the patient is told to do. "Brushing technique", "Sun protection".
  ADVICE
  /// A structured history entry. "Diabetes mellitus", "Smoking", "Penicillin".
  HISTORY_ITEM
  /// What is observed AT an anatomical region, for the visual map (CE-6).
  /// "Caries", "Mobility", "Erythema". Distinct from DIAGNOSIS: a finding is
  /// what you see on tooth 36, a diagnosis is what it means.
  FINDING_TYPE
}

/// Whether a treatment journey is still running.
///
/// Deliberately two states. "Abandoned" and "completed" are both CLOSED and the
/// difference belongs in `closureReason`, not in the enum — a clinic that wants
/// to report on the difference filters on text it wrote, and a clinic that does
/// not is spared a decision at close time.
enum ClinicalEpisodeStatus {
  OPEN
  CLOSED
}

/// Whether the patient is a person or an animal (CD-4).
///
/// ⚠️ THE ONLY THING IN THE CONSULTATION ENGINE THAT BRANCHES ON THIS IS CARE
///   CONTEXT RESOLUTION. §4 asks that the architecture not bake in a human-only
///   assumption; §42.7 forbids building veterinary functionality now. A column
///   and a thin extension table satisfy the first without doing the second.
enum CareSubjectType {
  HUMAN
  ANIMAL
}

/// How long a clinical thing has been going on.
///
/// ⚠️ DELIBERATELY NOT `FollowUpIntervalUnit`, WHICH IT RESEMBLES. That enum
///   says when to come BACK and stops at MONTHS because nobody recalls a patient
///   in hours; this one says how long a complaint has been RUNNING and needs
///   both ends of the range — "tooth pain since this morning" and "hair fall for
///   three years" are the two ordinary answers. Sharing one enum would mean
///   either offering HOURS on a recall or refusing YEARS on a complaint.
///
/// CE-4's `encounter_symptoms` uses this too, which is why it is named for the
/// duration and not for the chief complaint.
enum ClinicalDurationUnit {
  HOURS
  DAYS
  WEEKS
  MONTHS
  YEARS
}

/// How the complaint began. UNKNOWN is a real answer — the patient does not
/// always know, and a NULL would say the clinician did not ask.
enum ClinicalOnset {
  SUDDEN
  GRADUAL
  UNKNOWN
}

/// The unit a follow-up interval is expressed in.
enum FollowUpIntervalUnit {
  DAYS
  WEEKS
  MONTHS
}

/// Why the patient is being asked back. Drives the recall list's grouping and
/// nothing else — it is never an authorization or billing input.
enum FollowUpType {
  ROUTINE
  PROCEDURE_REVIEW
  LAB_REVIEW
  POST_OPERATIVE
  OTHER
}

// -----------------------------------------------------------------------------
// CLINICAL VOCABULARY
// -----------------------------------------------------------------------------

/// Every clinical word the platform or a clinic can say (CD-5).
///
/// Platform catalogue with per-tenant extension, exactly like `specialties`:
/// `organizationId = NULL` is a row every clinic sees, and a clinic that needs a
/// word we have not thought of adds its own rather than waiting for a deploy.
///
/// ⚠️ NOT SCOPED TO A SPECIALTY BY A COLUMN. Relevance is
/// `clinical_master_scopes`, a join table, because §34 is explicit that a word
/// can matter to several specialties and a single `specialty_id` forces a lie.
/// And the scope RANKS rather than FILTERS — see that model.
model ClinicalMasterItem {
  id             String             @id @default(uuid()) @db.Uuid
  /// NULL = platform row, visible to every tenant.
  organizationId String?            @map("organization_id") @db.Uuid
  kind           ClinicalMasterKind
  /// Optional grouping within a kind — "Cardiovascular" over a set of symptoms.
  ///
  /// ⚠️ `onDelete: Restrict`, NOT SetNull, for the reason `specialties` records:
  ///   SetNull "succeeds" at deleting a node and silently promotes its entire
  ///   subtree to the root. Refusing is the honest outcome.
  parentId       String?            @map("parent_id") @db.Uuid
  /// ⚠️ FLAT, NOT A PATH — `DENTAL_CARIES`, never `DENT-CARIES-DEEP`. A
  ///   path-encoded code becomes a lie the moment a node is re-parented, and the
  ///   path already has a home: `parent_id`. Same rule as the taxonomy's codes.
  code           String             @db.VarChar(64)
  name           String             @db.VarChar(255)
  /// Clinician-facing detail. NOT patient data — this is a dictionary entry.
  description    String?            @db.Text
  /// Sort among siblings. Ties break by `name` so the order is total.
  displayOrder   Int                @default(0) @map("display_order")
  /// Free-form document: display labels per locale, severity vocabularies a
  /// kind wants to offer, units for a measurement.
  ///
  /// ⚠️ A DOCUMENT, NEVER FOREIGN KEYS (ADR-0006). A list of `specialty_id`s in
  ///   here is `clinical_master_scopes` wearing a disguise.
  metadata       Json?              @db.JsonB
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  organization      Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent            ClinicalMasterItem?      @relation("ClinicalMasterParent", fields: [parentId], references: [id], onDelete: Restrict)
  children          ClinicalMasterItem[]     @relation("ClinicalMasterParent")
  codings           ClinicalMasterCoding[]
  scopes            ClinicalMasterScope[]
  /// What consultations have actually said with this word (CE-4). Five
  /// relations rather than one because the FKs are five different columns on
  /// five different tables — and `onDelete: Restrict` on every one of them is
  /// why the admin screen deactivates a word instead of deleting it.
  symptomUses       EncounterSymptom[]       @relation("SymptomItem")
  diagnosisUses     EncounterDiagnosis[]     @relation("DiagnosisItem")
  procedureUses     EncounterProcedure[]     @relation("ProcedureItem")
  investigationUses EncounterInvestigation[] @relation("InvestigationItem")
  adviceUses        EncounterAdvice[]        @relation("AdviceItem")
  /// What a chart says with this word (CE-6). `FINDING_TYPE` items only in
  /// practice — the kind is not enforced by the FK, and the selector is what
  /// makes it true.
  findingUses       ClinicalFinding[]        @relation("FindingItem")

  /// ⚠️ Rewritten NULLS NOT DISTINCT in the migration — without it the platform
  /// rows (organization_id NULL) are not unique among themselves.
  ///
  /// `kind` is part of the key deliberately: `DENTAL_CARIES` as a DIAGNOSIS and
  /// `DENTAL_CARIES` as a FINDING_TYPE are two legitimate rows saying different
  /// things about the same word.
  @@unique([organizationId, kind, code])
  /// Composite-FK target for the codings and scopes below, so a tenant can never
  /// bolt its own coding onto a PLATFORM word (ADR-0004).
  @@unique([organizationId, id])
  /// The search: one kind, active rows, one tenant plus the platform.
  @@index([organizationId, kind, isActive])
  /// Descendant walks recurse on `parent_id`. Without this the recursive CTE
  /// seq-scans the table once PER LEVEL — the lesson `specialties` records.
  @@index([parentId])
  /// ⚠️ THE NAME SEARCH INDEX IS A GIN TRIGRAM INDEX WRITTEN BY HAND in the
  ///   migration, over `lower(name)`. Prisma cannot express an expression index,
  ///   and without it every clinical selector's search is a sequential scan over
  ///   every word on the PLATFORM — filtered by RLS afterwards, so the cost
  ///   grows with the platform and not with the tenant. Exactly `patients`.
  @@map("clinical_master_items")
}

/// External codes for a clinical word. ICD-10, SNOMED CT, LOINC, ICD-11, or a
/// clinic's own scheme — all at once, on the same row.
///
/// ⚠️ WHY THIS IS A TABLE AND NOT TWO COLUMNS ON THE ITEM (§9). "Support
///   standardized clinical codes such as ICD without making the architecture
///   dependent on a single coding system" is only true if there is NO coding
///   column on the item at all. One `icd10_code` column makes ICD-10 the
///   privileged system and everything else a second-class citizen; two columns
///   (`system`, `code`) make it impossible to carry both an ICD-10 and a SNOMED
///   code for one diagnosis, which is the ordinary case in a hospital that
///   reports to more than one body.
///
/// ⚠️ `system` IS A VARCHAR, NOT AN ENUM, and for the reason
///   `patients.national_id_type` is one: the accepted list is per-market and
///   grows every time the platform opens a country. As an enum that is a
///   migration per coding system, and a clinic carrying a scheme the enum has
///   not learned yet cannot record it at all.
model ClinicalMasterCoding {
  id             String  @id @default(uuid()) @db.Uuid
  /// Mirrors the parent's. NULL for a coding on a platform item.
  organizationId String? @map("organization_id") @db.Uuid
  itemId         String  @map("item_id") @db.Uuid
  /// `ICD10`, `ICD11`, `SNOMEDCT`, `LOINC`, or a clinic's own label.
  system         String  @db.VarChar(32)
  code           String  @db.VarChar(64)
  /// The term as that system words it, which is often not how the clinic does.
  display        String? @db.VarChar(512)
  /// Which code to print on a report when several exist. At most one TRUE per
  /// (item, system), enforced by a partial unique index in the migration —
  /// Prisma cannot express `WHERE is_primary`.
  isPrimary      Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite-FK'd so a tenant cannot bolt its own coding onto a PLATFORM item
  /// — the tenant row would have to name an organization_id the platform row
  /// does not have. The same guard the product children use.
  ///
  /// Optional ONLY because Prisma refuses a required relation whose scalar
  /// fields include a nullable one. The row always has an item.
  item         ClinicalMasterItem? @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)

  /// ⚠️ NULLS NOT DISTINCT in the migration.
  @@unique([organizationId, itemId, system, code])
  @@index([organizationId, system, code])
  @@map("clinical_master_codings")
}

/// Which parts of the clinical taxonomy a word is relevant to (§34).
///
/// ⚠️ THIS RANKS. IT DOES NOT FILTER. §11 and §34 both say so in as many words:
///   "Prescription search should be context-aware but must not prevent the
///   doctor from using an appropriate medicine merely because it is not tagged
///   to a specialty."
///
///   So the search orders scoped matches above unscoped ones and returns both.
///   A hard filter would mean that the day a clinic adds a diagnosis and forgets
///   to tag it, that diagnosis becomes invisible to every doctor — a failure
///   mode with no error message, discovered by a clinician who cannot record
///   what they just concluded.
model ClinicalMasterScope {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  itemId         String  @map("item_id") @db.Uuid
  /// A node anywhere in the taxonomy — a care context, a domain, a specialty or
  /// a sub-specialty. Scoping a word to DENTISTRY covers every node beneath it;
  /// the resolver walks down, so a clinic tags once at the level it means.
  specialtyId    String  @map("specialty_id") @db.Uuid
  /// Higher sorts first among scoped matches. A tie-break, not a filter.
  relevance      Int     @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         ClinicalMasterItem? @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Cascade)
  /// ⚠️ A PLAIN FK, NOT COMPOSITE, and it therefore needs a RESTRICTIVE
  ///   `specialty_visible` policy — `specialties` allows a NULL organization_id,
  ///   so a composite FK cannot be drawn and the row would otherwise be able to
  ///   cite another tenant's specialty. Exactly the shape `doctor_specialties`
  ///   has, for exactly the same reason.
  specialty    Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, itemId, specialtyId])
  @@index([organizationId, specialtyId])
  @@map("clinical_master_scopes")
}

/// The same relevance mapping for the product catalogue (§34, §42.8).
///
/// ⚠️ A SEPARATE TABLE RATHER THAN A POLYMORPHIC `entity_type` COLUMN ON
///   `clinical_master_scopes`. A polymorphic parent cannot carry a foreign key,
///   which would mean the one thing this codebase refuses everywhere else: an id
///   the database does not check. Two small tables with real FKs beat one table
///   with none.
///
/// ⚠️ AND MEDICINES ARE STILL NEVER FILTERED BY IT. §42.8 — "do not assume
///   medicines belong to exactly one specialty". A dermatologist prescribes an
///   antibiotic; a dentist prescribes the same one.
model ProductClinicalScope {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  specialtyId    String  @map("specialty_id") @db.Uuid
  relevance      Int     @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  /// Plain FK into a possibly-platform row — `specialty_visible` policy, as above.
  specialty    Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, productId, specialtyId])
  @@index([organizationId, specialtyId])
  @@map("product_clinical_scopes")
}

// -----------------------------------------------------------------------------
// THE TREATMENT JOURNEY
// -----------------------------------------------------------------------------

/// One continuous treatment journey: every appointment about the same thing.
///
/// ⚠️ THREE DIFFERENT QUESTIONS, THREE DIFFERENT MECHANISMS, AND CONFLATING ANY
///   TWO IS THE MISTAKE THIS MODEL EXISTS TO PREVENT:
///
///     "what visit did this one come from?"  -> appointments.parent_appointment_id
///     "what journey is this part of?"       -> appointments.clinical_episode_id
///     "what did the doctor ASK for?"        -> encounter_follow_up_recommendations
///
///   The first two are facts about bookings. The third is a clinical
///   instruction, true whether or not anybody books anything. See
///   .kb/Consultation/FOLLOW_UP_ARCHITECTURE.md.
///
/// ── WHY THIS IS NOT "WALK parent_appointment_id TO THE ROOT" ─────────────────
///
///   1. A walk is O(depth) and recursive — a CTE on every render, where this is
///      one indexed equality.
///   2. A journey can BRANCH. A patient sent to a colleague and back has two
///      chains and one journey.
///   3. A journey can start WITHOUT a chain. A walk-in has no appointment at
///      all, and a chain rooted at a booking cannot express that.
///
/// ⚠️ ORG-SCOPED, NOT BRANCH-SCOPED — the same call `patients` makes, for the
///   same reason. A person who starts treatment at the main branch and continues
///   at the satellite has ONE journey; a branch-scoped episode would split it in
///   two and hide the second half from the first branch.
///
/// ⚠️ PHI. `title` and `notes` are clinical statements about a named person.
///   Both are in REDACTED_KEYS, neither reaches an audit row, and every read
///   that discloses one writes a `data_access_logs` row under CLINICAL_EPISODE.
model ClinicalEpisode {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  patientId          String                @map("patient_id") @db.Uuid
  /// Human-facing identifier, issued from the `CLINICAL_EPISODE` counter. Said
  /// out loud and quoted on a report, so it is issued rather than typed.
  code               String                @db.VarChar(32)
  /// ⚠️ PHI. "Androgenetic alopecia — management". Optional: a clinic that never
  ///   titles an episode still gets the grouping, and an untitled journey
  ///   renders by its first diagnosis rather than forcing a decision at booking
  ///   time, when nobody yet knows what the journey is about.
  title              String?               @db.VarChar(255)
  /// What the journey is broadly about. Advisory grouping for reporting; never
  /// an authorization input, and never what resolves a consultation template —
  /// that is the DOCTOR's classification, not the episode's.
  primarySpecialtyId String?               @map("primary_specialty_id") @db.Uuid
  status             ClinicalEpisodeStatus @default(OPEN)
  /// A DATE, not an instant: "when did this journey start" is a calendar
  /// question a clinic answers in its own timezone.
  ///
  /// ⚠️ Compare it with `startOfCalendarDay`, never against an instant.
  openedOn           DateTime              @map("opened_on") @db.Date
  closedOn           DateTime?             @map("closed_on") @db.Date
  /// ⚠️ PHI. Why it was closed, in the clinician's words.
  closureReason      String?               @map("closure_reason") @db.Text
  /// ⚠️ PHI.
  notes              String?               @db.Text
  /// SetNull: the person who opened it may leave; the journey stays.
  openedBy           String?               @map("opened_by") @db.Uuid
  closedBy           String?               @map("closed_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient          Patient       @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  primarySpecialty Specialty?    @relation(fields: [primarySpecialtyId], references: [id], onDelete: Restrict)
  opener           User?         @relation("EpisodeOpenedBy", fields: [openedBy], references: [id], onDelete: SetNull)
  closer           User?         @relation("EpisodeClosedBy", fields: [closedBy], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  /// The consultations recorded along this journey (CE-3). ⚠️ PHI.
  encounters       Encounter[]

  @@unique([organizationId, code])
  /// Composite-FK target: appointments and, from CE-3, encounters reference
  /// (organization_id, id) so a cross-tenant child is unrepresentable (ADR-0004).
  @@unique([organizationId, id])
  /// "What journeys is this patient on?" — the visit-history read, newest first.
  @@index([organizationId, patientId, openedOn])
  /// The open-episode picker at the front desk.
  @@index([organizationId, status])
  @@map("clinical_episodes")
}

/// Species, breed and weight, when the patient is not a person (CD-4).
///
/// ⚠️ DELIBERATELY THIN, AND DELIBERATELY NOT ON `patients`. §42.7 forbids
///   building veterinary functionality now; §4 asks only that the architecture
///   stop assuming humans. Six nullable columns on `patients` that are NULL for
///   every row in every clinic on the platform would be the wrong trade — this
///   table exists, has no rows, and costs a join that only a veterinary practice
///   ever pays for.
///
///   `weightKg` is here rather than on the encounter on purpose: it is the
///   animal's current recorded weight for the record, NOT the observation taken
///   at a visit. That observation is `appointment_vitals`, which already exists
///   and already handles a measurement taken at a point in time.
model AnimalProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  /// Free text, not an enum: the species list is unbounded and a veterinary
  /// clinic that treats a tortoise must not need a migration. Same reasoning as
  /// `patients.national_id_type`.
  species        String?  @db.VarChar(64)
  breed          String?  @db.VarChar(128)
  /// Recorded weight in kilograms. ⚠️ Decimal, never a float — a dose is
  /// calculated from it.
  weightKg       Decimal? @map("weight_kg") @db.Decimal(8, 3)
  /// Who brings the animal in and is billed. NOT a `patients` row: the guardian
  /// is not the patient, and making them one would put a human's identity on an
  /// animal's chart.
  guardianName   String?  @map("guardian_name") @db.VarChar(255)
  guardianPhone  String?  @map("guardian_phone") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, patientId])
  @@map("animal_profiles")
}

/// What the doctor ASKED the patient to do — which is not an appointment (CD-13).
///
/// ⚠️ THE TABLE LANDS IN CE-1 AND FILLS IN CE-4. `encounterId` is nullable ONLY
///   until `encounters` exists in CE-3; the column is documented as required and
///   the migration that adds the FK also makes it NOT NULL. Nothing writes here
///   before CE-4.
///
/// ── WHY A RECOMMENDATION IS NOT A BOOKING ────────────────────────────────────
///
/// "Come back after 15 days" has nowhere to live today. The only way to express
/// it is to BOOK an appointment — which asserts a slot the patient never agreed
/// to, burns a number from a branch counter a clinic reads as a sequence, and
/// puts a booking on the day board nobody is expecting.
///
/// ⚠️ AND IT IS WHAT MAKES A RECALL LIST POSSIBLE. The clinic's real question is
///   "who was told to come back and hasn't?" — unanswerable if a recommendation
///   and a booking are the same row, because an unbooked recommendation would
///   simply not exist. What the doctor advised also stays clinically true
///   whether or not the patient complies: deriving it from a booking means a
///   patient who never returns has no record of having been told to.
///
/// ⚠️ PHI throughout. `reason` and `notes` are clinical free text.
model EncounterFollowUpRecommendation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Copied from the appointment rather than reached through a parent, so this
  /// row is an ordinary member of the branch RLS loop. The call the invoice
  /// children made and the one `appointment_status_history` did not — a child of
  /// a branch-scoped parent that inherits only the org half re-opens the branch
  /// boundary.
  branchId       String @map("branch_id") @db.Uuid
  /// ⚠️ NOT NULL SINCE CE-3, AND THE MIGRATION THAT ADDED THE FK IS THE ONE THAT
  ///   TIGHTENED IT. Advice is given IN a consultation; a recommendation with no
  ///   encounter is a row nothing could ever have written. The tightening was
  ///   free because nothing wrote here before CE-4 — the table was empty on
  ///   every deployment, which is exactly the window in which a NOT NULL costs
  ///   nothing and after which it costs a backfill.
  encounterId    String @map("encounter_id") @db.Uuid
  /// The visit at which the advice was given. Denormalised from the encounter so
  /// the recall list can be assembled without joining through it.
  appointmentId  String @map("appointment_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid

  /// ⚠️ FALSE IS A REAL ANSWER, NOT AN ABSENCE. "No follow-up needed" is a
  ///   clinical decision worth recording, and it carries no interval. A screen
  ///   that only ever wrote a row when a follow-up WAS needed could not tell
  ///   "the doctor decided against one" from "the doctor forgot".
  isRequired Boolean @default(true) @map("is_required")

  /// "In 15 days." ⚠️ EXACTLY ONE OF (intervalValue + intervalUnit) OR
  ///   `recommendedDate` is set — a CHECK constraint in the migration, not a
  ///   convention. Both are legitimate ways for a doctor to put it, and storing
  ///   both invites them to disagree about which one the recall list believes.
  intervalValue   Int?                  @map("interval_value") @db.SmallInt
  intervalUnit    FollowUpIntervalUnit? @map("interval_unit")
  /// "On 4 September." A DATE, not an instant — compare with
  /// `startOfCalendarDay`, never against a timestamp.
  recommendedDate DateTime?             @map("recommended_date") @db.Date

  followUpType FollowUpType @default(ROUTINE) @map("follow_up_type")
  /// ⚠️ PHI.
  reason       String?      @db.Text
  /// ⚠️ PHI.
  notes        String?      @db.Text

  /// The booking that satisfied this, once the patient actually made one.
  ///
  /// ⚠️ NULL IS THE INTERESTING STATE — it is the whole recall list. And
  ///   fulfilment is optional in BOTH directions: a patient may book a follow-up
  ///   nobody recommended, and a recommendation may never be fulfilled. Neither
  ///   is an error.
  ///
  /// ⚠️ A PARTIAL UNIQUE INDEX in the migration stops one appointment fulfilling
  ///   two recommendations, and makes re-posting the same booking idempotent.
  fulfilledByAppointmentId String?   @map("fulfilled_by_appointment_id") @db.Uuid
  fulfilledAt              DateTime? @map("fulfilled_at") @db.Timestamptz(6)

  /// The patient declined, or the plan changed before they booked. Recorded
  /// rather than deleted: "we asked and they said no" is the answer to a recall
  /// chase, and a deleted row makes the desk ring them again next month.
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  /// ⚠️ PHI.
  cancelledReason String?   @map("cancelled_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  patient      Patient      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  appointment  Appointment  @relation("RecommendationSource", fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)
  /// The consultation the advice was given in (CE-3). Cascade: a deleted
  /// encounter takes its own content with it, and a recommendation is content.
  encounter    Encounter    @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting the booking that FULFILLED a recommendation
  /// must not take the clinical advice with it. The advice was given; the
  /// booking is what happened next.
  fulfilledBy  Appointment? @relation("RecommendationFulfilment", fields: [organizationId, fulfilledByAppointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  canceller    User?        @relation("RecommendationCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)

  /// The recall list: everything still outstanding, soonest first. ⚠️ The
  /// partial predicate (`fulfilled_by_appointment_id IS NULL AND cancelled_at IS
  /// NULL`) is hand-written in the migration — Prisma cannot express a partial
  /// index, and without it the recall query scans every recommendation the
  /// clinic has ever made.
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, branchId, recommendedDate])
  /// "What did this consultation ask for?" — the read CE-4's screen does.
  @@index([organizationId, encounterId])
  @@map("encounter_follow_up_recommendations")
}

// -----------------------------------------------------------------------------
// CONSULTATION TEMPLATES (CE-2)
//
// ⚠️ THIS IS INVARIANT 5 BEING TAKEN UP ON ITS OWN OFFER. "Per-specialty
//   variation goes through versioned form templates — JSONB as a document, never
//   as a foreign key." A dentist's consultation and a dermatologist's differ in
//   which sections appear, in what order, labelled how and over which
//   vocabulary. That is a DOCUMENT. It is emphatically not a table per
//   specialty, and it is not a `specialty_id` list inside a document either.
//
// ⚠️ THE `definition` HOLDS SECTION TYPES, ORDER, LABELS, FIELD DESCRIPTORS, MAP
//   CODES AND SCOPE CODES — NEVER MASTER-ITEM IDS (CD-6, ADR-0006). An id inside
//   JSONB is invisible to every constraint, join and cascade in the database; it
//   belongs to one tenant, so a document carrying one can never be a platform
//   row and can never be copied between clinics. Vocabulary is resolved BY SCOPE
//   at render time.
//
// ⚠️ AND NOTHING READS A `definition` DIRECTLY. `@rcln/clinical` parses and
//   validates it first, and refuses a document that says nothing checkable
//   (CD-10). A service that reaches into the JSONB has deleted that guarantee.
// -----------------------------------------------------------------------------

/// Where a template version is in its life.
///
/// ⚠️ A PUBLISHED VERSION IS IMMUTABLE IN EVERY FIELD, INCLUDING ITS DATES.
///   `assertVersionIsDraft` guards every writer — the lesson `assertPackIsOpen`
///   records in PI-5. Editing a live template is PUBLISHING A NEW VERSION, for
///   the reason §29 gives: a finalized consultation's snapshot is a statement
///   about the configuration that existed when it was made, and quietly
///   rewriting v3 makes every record that cites v3 a claim about a document that
///   no longer exists.
enum ConsultationTemplateStatus {
  DRAFT
  PUBLISHED
  /// Superseded. Kept, never deleted: encounters cite it, and the FK is what
  /// answers "how many consultations used v3".
  RETIRED
}

/// One clinic's (or the platform's) consultation configuration for one part of
/// the clinical taxonomy.
///
/// ── WHY THIS IS TWO TABLES AND NOT ONE ───────────────────────────────────────
///
/// The template is the IDENTITY — "our dentistry consultation" — and it is what
/// a clinic names, deactivates and thinks about. The version is the DOCUMENT,
/// and there are many. Collapsing them means either no history (edit in place,
/// and every finalized consultation's citation rots) or no identity (a new row
/// per edit, and nothing to attach to a taxonomy node).
///
/// ⚠️ PLATFORM-EXTENSIBLE, WITH `specialties`' POLICY AND NOT `files`'. The
///   platform ships a GENERAL template per care context so that a clinic can
///   consult on day one; a clinic writes its own beside it. Reproducing `files`'
///   NULL-permissive WITH CHECK here would let any clinic publish a
///   PLATFORM-WIDE consultation template — visible to every other tenant, and
///   writable by anyone holding `clinical.template.manage`.
///
/// NO PHI. A template is configuration; it names no patient and no clinician.
model ConsultationTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  /// NULL = platform row, visible to every tenant.
  organizationId String? @map("organization_id") @db.Uuid
  /// ⚠️ FLAT, NOT A PATH — `DENTAL_GENERAL`, never `HUMAN-DEN-GENERAL`. Same
  ///   rule as every other code in this repo: a path-encoded code becomes a lie
  ///   the moment the node it names is re-parented.
  code           String  @db.VarChar(64)
  name           String  @db.VarChar(160)
  description    String? @db.Text

  /// The CARE CONTEXT this template belongs to — the `CARE_CONTEXT` root of the
  /// taxonomy (CD-3). Human dermatology and veterinary dermatology want
  /// different forms, different vocabulary and different maps, and are otherwise
  /// indistinguishable in this tree.
  ///
  /// ⚠️ A COLUMN AND NOT A DERIVATION. It could be walked up from `specialtyId`
  ///   — except that `specialtyId` is NULL for the care-context default, which
  ///   is the one template that must always resolve.
  careContextId String  @map("care_context_id") @db.Uuid
  /// The node this template is attached to, anywhere below the care context.
  ///
  /// ⚠️ NULL IS THE CARE-CONTEXT DEFAULT AND IS THE MOST IMPORTANT VALUE THIS
  ///   COLUMN TAKES. It is what a doctor with no classification at all resolves
  ///   to (Scenario 3), and it is why resolution never returns nothing.
  specialtyId   String? @map("specialty_id") @db.Uuid

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// ⚠️ PLAIN FKs, NOT COMPOSITE, and they therefore need a RESTRICTIVE
  ///   `specialty_visible` policy — `specialties` allows a NULL organization_id,
  ///   so a composite FK cannot be drawn and the row could otherwise cite
  ///   another tenant's private node and read its name back out of the join.
  ///   Exactly the shape `clinical_master_scopes` has.
  careContext  Specialty                     @relation("TemplateCareContext", fields: [careContextId], references: [id], onDelete: Restrict)
  specialty    Specialty?                    @relation("TemplateSpecialty", fields: [specialtyId], references: [id], onDelete: Restrict)
  versions     ConsultationTemplateVersion[]
  /// Consultations conducted under this template (CE-3). Restrict on the FK: a
  /// template an encounter cites is deactivated, never deleted.
  encounters   Encounter[]

  /// ⚠️ Rewritten NULLS NOT DISTINCT in the migration — without it the platform
  /// templates are not unique among themselves.
  @@unique([organizationId, code])
  /// Composite-FK target for the versions, so a tenant can never bolt its own
  /// version onto a PLATFORM template (ADR-0004).
  @@unique([organizationId, id])
  /// The resolver's read: every candidate for one care context, in one index
  /// scan.
  @@index([organizationId, careContextId, isActive])
  @@index([organizationId, specialtyId])
  /// ⚠️ THE PARTIAL UNIQUE THAT MAKES RESOLUTION DETERMINISTIC IS HAND-WRITTEN:
  ///   at most one ACTIVE template per (organization, care context, specialty).
  ///   Prisma cannot express `WHERE is_active AND deleted_at IS NULL`. Without
  ///   it a clinic can attach two templates to the same node and which one
  ///   applies is a tie-break rather than a decision.
  @@map("consultation_templates")
}

/// One published (or draft, or retired) configuration document.
///
/// ⚠️ `version` IS THE ROW'S, `definition.schemaVersion` IS THE DOCUMENT'S, AND
///   THEY ARE NOT THE SAME NUMBER. A clinic on v7 of its dentistry template has
///   seven `schemaVersion: 1` documents. Conflating them means the day the
///   document shape changes, every historical version claims to be the new one —
///   and a finalized consultation's frozen snapshot (§29) is exactly what must
///   not change under it.
model ConsultationTemplateVersion {
  id             String  @id @default(uuid()) @db.Uuid
  /// Mirrors the parent's. NULL for a version of a platform template.
  organizationId String? @map("organization_id") @db.Uuid
  templateId     String  @map("template_id") @db.Uuid
  /// Monotonic per template, issued by the service. 1, 2, 3 — never reused.
  version        Int

  /// The configuration document.
  ///
  /// ⚠️ PARSED BY `@rcln/clinical` BEFORE ANYTHING ACTS ON IT, ALWAYS. Section
  ///   types, order, labels, field descriptors, map CODES and scope CODES. No
  ///   ids, ever (CD-6).
  definition Json @db.JsonB

  status      ConsultationTemplateStatus @default(DRAFT)
  publishedAt DateTime?                  @map("published_at") @db.Timestamptz(6)
  /// SetNull: the person who published it may leave; the configuration stays.
  publishedBy String?                    @map("published_by") @db.Uuid
  retiredAt   DateTime?                  @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite-FK'd so a tenant cannot bolt its own version onto a PLATFORM
  /// template. Optional ONLY because Prisma refuses a required relation whose
  /// scalar fields include a nullable one; the row always has a template.
  template     ConsultationTemplate? @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Cascade)
  publisher    User?                 @relation("TemplateVersionPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  /// ⚠️ THE REPORTING JOIN, NOT THE RENDERING ONE (§29). "How many
  ///   consultations used v3" is answered here; what a given consultation LOOKS
  ///   like is answered by its own frozen `templateSnapshot`.
  encounters   Encounter[]

  /// ⚠️ NULLS NOT DISTINCT in the migration.
  @@unique([organizationId, templateId, version])
  /// Composite-FK target for `encounters.template_version_id` in CE-3.
  @@unique([organizationId, id])
  /// The resolver's read: the latest PUBLISHED version of each candidate.
  @@index([organizationId, templateId, status])
  /// ⚠️ AT MOST ONE DRAFT PER TEMPLATE is a partial unique index in the
  ///   migration. Two open drafts is two people editing the same configuration
  ///   with no idea the other exists, and whichever publishes second silently
  ///   discards the first.
  @@map("consultation_template_versions")
}

// -----------------------------------------------------------------------------
// THE ENCOUNTER (CE-3)
//
// The clinical record itself: what one doctor recorded about one patient at one
// visit. Everything above this line is configuration or vocabulary and names
// nobody; everything from here down is PHI in every text column.
//
// ⚠️ THE ENCOUNTER IS THE ONLY THING IN THIS FILE ONLY A DOCTOR MAY AUTHOR
//   (invariant 7). `clinical.encounter.create` / `.close` / `.amend` belong to
//   DOCTOR alone among the system roles and are stripped from ORG_OWNER and
//   ORG_ADMIN by name. Reading a patient's record is not writing in it.
//
// ⚠️ FINALIZED IS IMMUTABLE, AND AN AMENDMENT IS A NEW ROW (CD-2). Nothing edits
//   a finalized consultation — not a typo, not a correction, not "just this
//   once". The correction is a fresh row that cites the old one through
//   `amendsEncounterId`, the old row moves to AMENDED, and both stay readable.
//   A clinical record that can be silently rewritten is not a record.
// -----------------------------------------------------------------------------

/// The sections a consultation can be made of.
///
/// ⚠️ THE AUTHORITATIVE COPY OF THIS SET IS `ConsultationSectionType` IN
///   `packages/clinical/src/types.ts`, AND THE TWO ARE ASSERTED EQUAL BY A
///   TYPE-LEVEL CHECK IN `services/clinical/sections.ts`. It is duplicated here
///   on purpose: `encounter_sections.section_type` is a column the database
///   should be able to check, and a VarChar would let a typo'd section type land
///   as a row no component ever renders and nobody ever sees again.
///
///   A new member is therefore a migration AND a component. That is the intended
///   cost — ARCHITECTURE.md's line is that configuration selects sections and
///   cannot invent one.
enum ConsultationSectionType {
  CHIEF_COMPLAINT
  SYMPTOMS
  HISTORY
  EXAMINATION
  VISUAL_MAPPING
  DIAGNOSIS
  PROCEDURE
  PRESCRIPTION
  INVESTIGATION
  ADVICE
  REFERRAL
  CLINICAL_NOTES
  ATTACHMENTS
  FOLLOW_UP
}

/// Where a consultation is in its life.
///
/// ⚠️ AMENDED IS A STATE OF THE SUPERSEDED ROW, NOT OF THE CORRECTION. The
///   amendment itself is DRAFT and then FINALIZED like any other consultation;
///   what it amends becomes AMENDED and stops being the current record. Reading
///   it the other way round is the mistake that makes a chain of amendments
///   unresolvable — every row would claim to be an amendment of something.
enum EncounterStatus {
  DRAFT
  FINALIZED
  /// Superseded by a later row that cites it. Kept for ever.
  AMENDED
  /// Abandoned before it was finalized. Kept rather than deleted: "the doctor
  /// started a consultation and abandoned it" is a fact about a visit.
  CANCELLED
}

/// One consultation: the clinical record of one visit.
///
/// ⚠️ `appointmentId` IS NULLABLE, AND THAT IS CD-1 RATHER THAN AN OVERSIGHT. A
///   walk-in seen without a booking is an ordinary event in a clinic, and a
///   required appointment would force the desk to invent a slot the patient
///   never took just so the doctor could write. What is NOT nullable is the
///   patient, the episode and the doctor — a consultation with no subject, no
///   journey or no author is not a record of anything.
///
/// ⚠️ ORG + BRANCH SCOPED, IN BOTH RLS LOOPS. A consultation happens AT a place;
///   `branchId` is NOT NULL, so the branch policy is absolute — a doctor scoped
///   to one site cannot read what was written about a patient at another. That
///   is the opposite call from `clinical_episodes`, deliberately: the journey
///   follows the person, the visit belongs to the clinic it happened at.
///
/// ⚠️ IT CARRIES `templateVersionId` AND `templateSnapshot`, AND THEY ANSWER
///   DIFFERENT QUESTIONS (§29). The FK is for REPORTING — "how many
///   consultations used v3". The SNAPSHOT is what RENDERS the record, and it is
///   the reason a template edited in 2029 changes nothing about a consultation
///   finalized in 2026. A record that re-read the live template to display
///   itself would show a 2026 visit through a 2029 form, with sections the
///   clinician never saw and answers under keys that no longer exist.
///
///   The snapshot is written when the draft is OPENED, not at finalization. A
///   draft resumed after the clinic published a new version must go on showing
///   the form the doctor started typing into; re-resolving mid-consultation
///   would move the fields under the cursor.
model Encounter {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  /// Where the consultation happened. Copied from the appointment when there is
  /// one, and taken from the acting membership's branch for a walk-in.
  branchId          String  @map("branch_id") @db.Uuid
  patientId         String  @map("patient_id") @db.Uuid
  /// ⚠️ NULL FOR A WALK-IN (CD-1). See the model note.
  appointmentId     String? @map("appointment_id") @db.Uuid
  /// The journey this consultation belongs to. NOT NULL for the same reason
  /// `appointments.clinical_episode_id` is: an episode of one is the ordinary
  /// case, and "a consultation belonging to no journey" should not be
  /// representable.
  clinicalEpisodeId String  @map("clinical_episode_id") @db.Uuid
  /// Who wrote it. Restrict, never SetNull: an unsigned clinical record is not
  /// a thing, and a doctor leaving the clinic does not un-write what they saw.
  doctorProfileId   String  @map("doctor_profile_id") @db.Uuid

  /// Branch-local, issued from the `ENCOUNTER` counter.
  ///
  /// ⚠️ NULL UNTIL FINALIZATION, AND ISSUED THERE RATHER THAN AT CREATE. It is
  ///   printed on a prescription and quoted back months later, so it is a
  ///   document number in the sense PI-4's four counters are — and a draft that
  ///   is abandoned must burn none, because a gap in the series is a question
  ///   somebody will ask.
  ///
  /// ⚠️ AN AMENDMENT GETS ITS OWN NUMBER rather than reusing the number of the
  ///   row it corrects. Reusing it would put two live rows behind one
  ///   identifier, which is exactly what `appointments.appointment_number`
  ///   refuses for a follow-up and for the same reason: the link the clinic
  ///   needs is `amendsEncounterId`, and the database enforces that where it
  ///   cannot enforce a shared string.
  encounterNumber String? @map("encounter_number") @db.VarChar(32)

  /// The configuration this consultation was conducted under.
  ///
  /// Restrict on both: a template version an encounter cites can be RETIRED but
  /// never deleted, because deleting it would break the reporting question the
  /// FK exists to answer.
  templateId        String @map("template_id") @db.Uuid
  templateVersionId String @map("template_version_id") @db.Uuid
  /// ⚠️ THE FROZEN COPY OF THE PARSED DEFINITION (§29). Written at open, read by
  ///   every render and by finalization's validation, and never rewritten.
  ///   Nothing reads it raw — `parseStoredDefinition` is the one door, and it
  ///   throws rather than returning an empty configuration.
  templateSnapshot  Json   @map("template_snapshot") @db.JsonB

  status EncounterStatus @default(DRAFT)

  /// ⚠️ PHI. "Pain in the lower left molar." Free text and not a master item on
  ///   purpose: the chief complaint is the patient's own words, and forcing it
  ///   through a vocabulary loses the only part of the record written in them.
  ///   The coded version of the same thing is `encounter_symptoms` in CE-4.
  chiefComplaint              String?               @map("chief_complaint") @db.Text
  /// "Three days." Value and unit travel together or not at all — a CHECK in the
  /// migration, because a duration of "3" of nothing is not a duration.
  chiefComplaintDurationValue Int?                  @map("chief_complaint_duration_value") @db.SmallInt
  chiefComplaintDurationUnit  ClinicalDurationUnit? @map("chief_complaint_duration_unit")
  onset                       ClinicalOnset?
  /// ⚠️ PHI. The doctor's own narrative, which every specialty wants and no
  ///   template can structure away.
  clinicalNotes               String?               @map("clinical_notes") @db.Text

  /// When the doctor opened it. Not the appointment's `startedAt`: a
  /// consultation can be written up after the patient has left, and pretending
  /// otherwise would put a false time on a clinical record.
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(6)
  /// Restrict on the FK, not SetNull: who signed a clinical record is part of
  /// the record. Contrast every other `*_by` column in this file.
  finalizedBy String?   @map("finalized_by") @db.Uuid

  /// The consultation THIS ONE CORRECTS. NULL on an original.
  amendsEncounterId String?   @map("amends_encounter_id") @db.Uuid
  /// Set on the row that WAS amended, at the moment its correction is finalized.
  /// ⚠️ Read the enum's note: this column and `amendsEncounterId` are never both
  ///   set on the same row unless an amendment was itself amended, which is
  ///   legitimate and is why neither is unique on its own.
  amendedAt         DateTime? @map("amended_at") @db.Timestamptz(6)
  /// ⚠️ PHI. Why the record was corrected — required by the service on amend,
  ///   because "the record changed and nobody said why" is the failure an
  ///   amendment trail exists to prevent.
  amendmentReason   String?   @map("amendment_reason") @db.Text

  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  /// ⚠️ PHI.
  cancelledReason String?   @map("cancelled_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch                      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  patient         Patient                     @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Cascade)
  appointment     Appointment?                @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  clinicalEpisode ClinicalEpisode             @relation(fields: [organizationId, clinicalEpisodeId], references: [organizationId, id], onDelete: Restrict)
  doctorProfile   DoctorProfile               @relation(fields: [organizationId, doctorProfileId], references: [organizationId, id], onDelete: Restrict)
  /// ⚠️ PLAIN FKs, NOT COMPOSITE, AND THIS IS THE ONE PLACE ADR-0004 CANNOT BE
  ///   FOLLOWED HERE. A composite (organization_id, template_id) reference would
  ///   make a PLATFORM template — organization_id NULL — UNCITABLE: the
  ///   encounter's organization_id is NOT NULL, both columns are therefore
  ///   non-null, and the FK would demand a template row belonging to the
  ///   clinic. Since the platform's `GENERAL_HUMAN` is precisely what a doctor
  ///   with no classification resolves to, that constraint would refuse the most
  ///   ordinary consultation on the platform.
  ///
  ///   The same shape `encounter_prescriptions.product_id` has in CE-4, and
  ///   `batches` has today, and for the identical reason. What replaces the
  ///   composite FK is a RESTRICTIVE `template_visible` policy in the migration:
  ///   without it a clinic could cite ANOTHER TENANT'S private template and read
  ///   its name and definition back out of the join.
  template        ConsultationTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion ConsultationTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  finalizer       User?                       @relation("EncounterFinalizedBy", fields: [finalizedBy], references: [id], onDelete: Restrict)
  canceller       User?                       @relation("EncounterCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  amends          Encounter?                  @relation("EncounterAmendment", fields: [organizationId, amendsEncounterId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  amendedBy       Encounter[]                 @relation("EncounterAmendment")

  sections        EncounterSection[]
  /// Pharmacy's workflow state over this consultation's prescription (PI-7).
  /// ⚠️ ONE WAY. The dispensary reads the clinical record and writes only its
  ///   own rows beside it — invariant 7.
  fulfilment      PrescriptionFulfilment?
  dispenses       Dispense[]
  recommendations EncounterFollowUpRecommendation[]
  /// The clinical content (CE-4). Cascade on every one of them: a deleted
  /// consultation takes its own content with it, and all of this IS content.
  symptoms        EncounterSymptom[]
  diagnoses       EncounterDiagnosis[]
  procedures      EncounterProcedure[]
  prescriptions   EncounterPrescription[]
  investigations  EncounterInvestigation[]
  advice          EncounterAdvice[]
  referrals       EncounterReferral[]
  attachments     EncounterAttachment[]
  /// What was found on a chart at this consultation (CE-6).
  findings        ClinicalFinding[]

  @@unique([organizationId, branchId, encounterNumber])
  /// Composite-FK target for every CE-4 child, the sections below and the
  /// follow-up recommendations above (ADR-0004).
  @@unique([organizationId, id])
  /// The chart: this patient's consultations, newest first.
  @@index([organizationId, patientId, startedAt])
  /// "Show me this whole journey." One indexed equality, as on `appointments`.
  @@index([organizationId, clinicalEpisodeId, startedAt])
  /// "What is still open on my desk?" — the doctor's draft list.
  @@index([organizationId, doctorProfileId, status])
  /// Reporting: how many consultations used version v.
  @@index([organizationId, templateVersionId])
  /// ⚠️ TWO PARTIAL UNIQUES ARE HAND-WRITTEN IN THE MIGRATION, because Prisma
  ///   cannot express a predicate:
  ///
  ///     at most one LIVE encounter per appointment
  ///       (status IN ('DRAFT','FINALIZED') AND deleted_at IS NULL) — without
  ///       it a second "start consultation" click opens a second record of the
  ///       same visit, and which one the prescription hangs off is a race.
  ///
  ///     at most one amendment per amended encounter
  ///       (amends_encounter_id IS NOT NULL AND deleted_at IS NULL AND status <>
  ///       'CANCELLED') — two live corrections of one record is two versions of
  ///       the truth with nothing to choose between them.
  @@map("encounters")
}

/// The answers to a descriptor-driven section — HISTORY and EXAMINATION.
///
/// ⚠️ ONLY THE DESCRIPTOR-DRIVEN SECTIONS LIVE HERE, AND THAT IS THE WHOLE LINE
///   THE ARCHITECTURE DRAWS. A diagnosis, a prescription, an investigation and a
///   procedure are FIRST-CLASS: they have their own tables in CE-4, they are
///   queried, reported on, dispensed against and consumed from stock. Putting
///   them in a JSONB blob here would make "what did we prescribe this year"
///   unanswerable and would put a `product_id` inside a document, which is
///   ADR-0006 exactly.
///
///   What is left is genuinely per-specialty and genuinely unqueried: a
///   dentist's occlusion notes, a dermatologist's Fitzpatrick type. Those are a
///   document, and `data` is where they go.
///
/// ⚠️ `data` IS VALIDATED AGAINST THE ENCOUNTER'S SNAPSHOT DESCRIPTORS, NOT
///   AGAINST THE LIVE TEMPLATE, and it is validated at finalization rather than
///   at every autosave — a half-typed draft is allowed to be incomplete, and a
///   finalized one is not.
model EncounterSection {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Copied from the encounter so this is an ordinary member of the branch RLS
  /// loop rather than a child inheriting only the org half — the call the
  /// invoice children made and the one `appointment_status_history` did not.
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  /// Which component wrote it. A Postgres enum rather than free text: the set is
  /// closed by the engine anyway, and a typo'd section type would be a row no
  /// component ever renders and nobody ever sees again.
  sectionType  ConsultationSectionType @map("section_type")
  /// The template section's `key`. Stable by contract — renaming one in a
  /// template orphans every answer already recorded under the old key, in every
  /// finalized consultation.
  sectionKey   String                  @map("section_key") @db.VarChar(64)
  /// ⚠️ PHI. The descriptor answers, keyed by `FieldDescriptor.key`.
  data         Json                    @default("{}") @db.JsonB
  /// Copied from the section's `order` in the snapshot, so a read that does not
  /// parse the snapshot can still render in the right order.
  displayOrder Int                     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter    @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)

  /// One row per section key per encounter — the autosave upserts on it.
  @@unique([organizationId, encounterId, sectionKey])
  @@index([organizationId, encounterId, displayOrder])
  @@map("encounter_sections")
}

// -----------------------------------------------------------------------------
// CLINICAL CONTENT (CE-4)
//
// The eight tables that hold what the doctor actually concluded, prescribed,
// ordered and advised. Everything above the encounter is configuration or
// vocabulary and names nobody; every row from here down is PHI about one named
// person.
//
// ⚠️ ALL EIGHT CARRY `organization_id` AND `branch_id` THEMSELVES rather than
//   inheriting through the encounter, and that is a security decision and not a
//   normalisation one. A child of a branch-scoped parent that inherits only the
//   org half is exactly the hole `appointment_status_history` had to restate by
//   hand — the org policy passes and the branch boundary is simply not there.
//   The composite FK to `(organization_id, encounter_id)` is what stops the two
//   columns disagreeing with the consultation they belong to.
//
// ⚠️ THEY ARE TABLES AND NOT JSONB, AND THAT IS THE LINE `encounter_sections`
//   DRAWS. A diagnosis is reported on, a prescription is dispensed against
//   (PI-7), a procedure is consumed from stock (PI-9). "What did we prescribe
//   this year" has to be a query, and a `product_id` inside a document is
//   ADR-0006 exactly.
//
// ⚠️ NOTHING HERE EDITS A FINALIZED CONSULTATION (CD-2). Every writer goes
//   through `assertDraft` on the parent encounter; an amendment COPIES these
//   rows onto a new encounter rather than moving them, so both records stay
//   whole and readable for ever.
//
// ⚠️ FIVE OF THEM POINT AT `clinical_master_items`, WHICH ALLOWS A NULL
//   `organization_id`, SO NONE OF THOSE POINTERS CAN BE A COMPOSITE FK. What
//   replaces it is a RESTRICTIVE `item_visible` policy, the same shape
//   `template_visible` has on `encounters` and `product_visible` has on
//   `batches`. Without it a clinic could cite another tenant's private word and
//   read its name back out of the join.
// -----------------------------------------------------------------------------

/// How bad the patient says it is. Three steps and not ten: a scale a clinician
/// has to think about is a scale they stop filling in.
enum ClinicalSeverity {
  MILD
  MODERATE
  SEVERE
}

/// What a diagnosis IS to this consultation.
///
/// ⚠️ `DIFFERENTIAL` IS NOT A WEAKER `SECONDARY`. A differential is something
///   being considered and not concluded; recording it as a secondary diagnosis
///   asserts the patient has a condition the clinician was only ruling out.
enum DiagnosisRole {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

/// How sure the clinician is. `RULED_OUT` is a real and useful answer — "we
/// looked and it is not this" is worth as much on a chart as a confirmation.
enum DiagnosisCertainty {
  CONFIRMED
  PROVISIONAL
  SUSPECTED
  RULED_OUT
}

/// Where a procedure recorded on a consultation has got to.
///
/// ⚠️ NOT AN INVENTORY STATE. What was consumed doing it is `stock_ledger`
///   (PI-9); this says whether the clinician did it, plans to, or called it off.
enum EncounterProcedureStatus {
  PLANNED
  PERFORMED
  CANCELLED
}

/// How soon an investigation is wanted.
enum InvestigationPriority {
  ROUTINE
  URGENT
  STAT
}

/// Where an order has got to.
///
/// ⚠️ THE LAB MODULE DOES NOT EXIST, AND THIS ENUM IS NOT PRETENDING IT DOES.
///   These are the states the CLINIC can observe from the consultation side —
///   ordered, taken, back, called off. When the lab ships it owns its own
///   workflow and reports into this column rather than replacing it.
enum InvestigationStatus {
  ORDERED
  COLLECTED
  COMPLETED
  CANCELLED
}

/// How soon a referral is wanted.
enum ReferralUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

/// How a medicine is taken.
///
/// ⚠️ AN ENUM WHERE `clinical_master_codings.system` IS A VARCHAR, AND THE
///   DIFFERENCE IS REAL. A coding system is a per-market list that grows every
///   time the platform opens a country; a route of administration is a closed
///   clinical set that has not moved in a century. `OTHER` is the escape, and it
///   pairs with `instructions` rather than with a migration.
enum MedicationRoute {
  ORAL
  TOPICAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  INHALATION
  OPHTHALMIC
  OTIC
  NASAL
  RECTAL
  VAGINAL
  SUBLINGUAL
  TRANSDERMAL
  OTHER
}

/// The period a dose count is per. "1 × per DAY", "2 × per WEEK".
///
/// ⚠️ DELIBERATELY NOT `ClinicalDurationUnit`, WHICH IT RESEMBLES AND WHICH THIS
///   TABLE ALSO USES. That enum says how LONG the course runs and needs HOURS
///   and YEARS at its ends; this one says how OFTEN a dose is taken, and neither
///   "twice per hour" nor "twice per year" is a prescription anybody writes.
///   Sharing one enum would offer both.
enum MedicationFrequencyUnit {
  DAY
  WEEK
  MONTH
}

/// When to take it relative to eating. `ANY` is a real answer and NULL is not:
/// NULL says the clinician did not say, which for a medicine that must be taken
/// with food is a different and more dangerous statement.
enum MedicationFoodRelation {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  ANY
}

/// What an attachment on a consultation is.
///
/// ⚠️ NOT `DocumentType`, WHICH IT SITS BESIDE. `DocumentType` says what kind of
///   FILE the platform is storing and is read by the storage layer;
///   `CLINICAL_ATTACHMENT` is one of its members. This says what the file is
///   clinically, which is a question only the chart asks.
enum EncounterAttachmentKind {
  /// A clinical photograph. ⚠️ The densest PHI the product stores.
  PHOTO
  /// A report the patient brought, or one the clinic produced.
  REPORT
  /// An X-ray, an OPG, a scan.
  SCAN
  /// A signed consent.
  CONSENT
  /// A letter to or from another clinician.
  LETTER
  OTHER
}

/// What the patient reports, coded (§6).
///
/// ⚠️ `itemId` OR `customText`, EXACTLY ONE, AND A CHECK CONSTRAINT SAYS SO.
///   §6 wants a clinician able to record a symptom the vocabulary has not
///   learned yet, and forcing every free-text entry to create a master row
///   pollutes a shared platform catalogue with one clinic's typos. Allowing both
///   would let a custom label silently contradict the coded word beside it.
///
/// The free-text COMPLAINT is `encounters.chief_complaint` and is a different
/// thing: that is the patient's own words about why they came, this is the
/// clinician's coded list of what is wrong.
model EncounterSymptom {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  /// A `SYMPTOM` row from the vocabulary. NULL when the clinician typed one.
  itemId     String? @map("item_id") @db.Uuid
  /// ⚠️ PHI. The clinician's own words when the vocabulary has no word for it.
  customText String? @map("custom_text") @db.VarChar(255)

  /// How long it has been going on. ⚠️ Value and unit travel together or not at
  /// all — a CHECK, because "3" of nothing is not a duration.
  durationValue Int?                  @map("duration_value") @db.SmallInt
  durationUnit  ClinicalDurationUnit? @map("duration_unit")
  severity      ClinicalSeverity?
  /// "Intermittent", "on waking", "after meals". Free text: the useful answers
  /// are endless and an enum would refuse the one the patient gave.
  frequency     String?               @db.VarChar(120)
  /// Where on the body. ⚠️ Free text until CE-6 — the coded version is a finding
  /// against a `visual_regions` row, and that table does not exist yet.
  site          String?               @db.VarChar(120)
  /// ⚠️ PHI.
  notes         String?               @db.Text
  displayOrder  Int                   @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter           @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  /// ⚠️ A PLAIN FK INTO A POSSIBLY-PLATFORM ROW, so it needs `item_visible`.
  ///   Restrict, never Cascade: a word is deactivated and never deleted, because
  ///   deleting one would erase what a clinician actually concluded.
  item         ClinicalMasterItem? @relation("SymptomItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([organizationId, encounterId, displayOrder])
  @@index([organizationId, itemId])
  @@map("encounter_symptoms")
}

/// What the clinician concluded.
///
/// ⚠️ THE ROW A PROCEDURE HANGS OFF, WHICH IS WHY IT CARRIES
///   `@@unique([organizationId, id])`. "This root canal was for that caries" is
///   a real clinical link and it is a foreign key, not a note.
model EncounterDiagnosis {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  itemId     String? @map("item_id") @db.Uuid
  /// ⚠️ PHI. See `EncounterSymptom` — exactly one of the two, by CHECK.
  customText String? @map("custom_text") @db.VarChar(255)

  role         DiagnosisRole      @default(SECONDARY)
  certainty    DiagnosisCertainty @default(PROVISIONAL)
  /// ⚠️ PHI.
  notes        String?            @db.Text
  displayOrder Int                @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter            @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  item         ClinicalMasterItem?  @relation("DiagnosisItem", fields: [itemId], references: [id], onDelete: Restrict)
  procedures   EncounterProcedure[]
  /// The marks on the chart this diagnosis explains (CE-6).
  findings     ClinicalFinding[]

  /// Composite-FK target for `encounter_procedures.diagnosis_id` (ADR-0004).
  @@unique([organizationId, id])
  /// ⚠️ AT MOST ONE PRIMARY DIAGNOSIS PER CONSULTATION is a partial unique index
  ///   in the migration — Prisma cannot express `WHERE role = 'PRIMARY'`. Two
  ///   primaries is two answers to "what is this visit about", and every report
  ///   that groups by primary diagnosis would count the visit twice.
  @@index([organizationId, encounterId, displayOrder])
  @@index([organizationId, itemId])
  @@map("encounter_diagnoses")
}

/// What was done about it, or is planned.
///
/// ⚠️ `itemId` IS NOT NULL HERE, UNLIKE SYMPTOMS AND DIAGNOSES. A procedure is
///   what gets billed, consumed from stock (PI-9) and reported on; a free-text
///   one is a line nothing downstream can price or count. The clinic adds the
///   word to its own vocabulary first — which is one click and is the right
///   place for it to live.
model EncounterProcedure {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  itemId         String? @map("item_id") @db.Uuid
  /// What it treats. NULL is ordinary — not every procedure answers a diagnosis
  /// recorded at the same visit.
  diagnosisId    String? @map("diagnosis_id") @db.Uuid
  /// WHERE it was done — the tooth, the quadrant, the scalp zone (CE-6).
  ///
  /// ⚠️ A PLAIN FK, NOT COMPOSITE, so it needs a RESTRICTIVE `region_visible`
  ///   policy: a platform region has no organization_id to compose with, and
  ///   this row's is NOT NULL. Same shape as `item_id` immediately above.
  ///
  /// NULL is ordinary — most procedures are not done at a place on a chart.
  visualRegionId String? @map("visual_region_id") @db.Uuid

  /// A DATE, not an instant: "when was this done" is a calendar question the
  /// clinic answers in its own timezone. ⚠️ Compare with `startOfCalendarDay`.
  performedOn  DateTime?                @map("performed_on") @db.Date
  status       EncounterProcedureStatus @default(PLANNED)
  /// ⚠️ PHI.
  notes        String?                  @db.Text
  displayOrder Int                      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter           @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  /// Optional in Prisma's eyes ONLY because a required relation may not include
  /// a nullable scalar; `item_id` is NOT NULL in the migration.
  item         ClinicalMasterItem? @relation("ProcedureItem", fields: [itemId], references: [id], onDelete: Restrict)
  /// ⚠️ Restrict, AND SetNull IS NOT AVAILABLE HERE. The composite includes
  ///   `organization_id`, which is NOT NULL, so Postgres cannot null the pair —
  ///   the same constraint `appointments.parent_appointment_id` lives under.
  ///   Removing a diagnosis a procedure cites therefore unlinks the procedure
  ///   first, in the service, which is the honest order anyway: what was done
  ///   stays on the record and only the link goes.
  diagnosis    EncounterDiagnosis? @relation(fields: [organizationId, diagnosisId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Restrict: a region a procedure cites is deactivated with its map, never
  /// deleted out from under the record.
  region       VisualRegion?       @relation("ProcedureRegion", fields: [visualRegionId], references: [id], onDelete: Restrict)

  @@index([organizationId, encounterId, displayOrder])
  /// PI-9 reads this: what procedures were performed, and therefore what stock
  /// they consumed.
  @@index([organizationId, itemId, status])
  @@map("encounter_procedures")
}

/// What was prescribed. The row PI-7 dispenses against.
///
/// ⚠️ `productId` IS A PLAIN FK INTO A POSSIBLY-PLATFORM ROW, exactly as
///   `encounters.template_id` is and `batches.product_id` is. The composite FK
///   is impossible — this row's `organization_id` is NOT NULL and a platform
///   medicine's is NULL, so the constraint would refuse the whole platform
///   catalogue. A RESTRICTIVE `product_visible` policy is what replaces it.
///
/// ⚠️ EVERY DOSING COLUMN IS A COLUMN AND NOT A SENTENCE. "1 tablet twice daily
///   after food for 5 days" typed as free text cannot be checked, cannot be
///   dispensed against and cannot be totalled — and a pharmacist reading it is
///   parsing English at the counter. `instructions` exists for what the columns
///   genuinely cannot say.
model EncounterPrescription {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  productId String  @map("product_id") @db.Uuid
  /// "500 mg", "5%". A snapshot of what was written, because a product's
  /// catalogue strength can be corrected and this prescription cannot.
  strength  String? @db.VarChar(64)

  /// How much per dose. ⚠️ Decimal, never a float — half a tablet is 0.5 and a
  /// float would make it 0.49999999999999994 on some row, some day.
  dose     Decimal?         @db.Decimal(10, 3)
  /// "tablet", "ml", "drop", "puff". A VarChar for the reason
  /// `animal_profiles.species` is one: the list is unbounded per form.
  doseUnit String?          @map("dose_unit") @db.VarChar(32)
  route    MedicationRoute?

  /// "TWICE per DAY" — a count and its period. Both or neither, by CHECK.
  frequency     Int?                     @db.SmallInt
  frequencyUnit MedicationFrequencyUnit? @map("frequency_unit")

  /// How long the course runs. Both or neither, by CHECK.
  durationValue Int?                  @map("duration_value") @db.SmallInt
  durationUnit  ClinicalDurationUnit? @map("duration_unit")

  foodRelation MedicationFoodRelation? @map("food_relation")
  /// "Morning and night", "at bedtime". Free text beside the structured
  /// frequency, because a clinic's timing vocabulary is its own.
  timing       String?                 @db.VarChar(120)

  /// Total to dispense. ⚠️ Decimal for the same reason `dose` is, and NULLABLE
  ///   because a doctor prescribing an ointment "as needed" is not stating one.
  quantity Decimal? @db.Decimal(12, 3)

  /// ⚠️ DATES, NOT INSTANTS. "Start on Monday" is a calendar statement.
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  /// ⚠️ THE PRESCRIBER'S ENDORSEMENT THAT THIS MAY BE DISPENSED MORE THAN ONCE
  ///   (PI-8, closing KNOWN_ISSUES #8). Several jurisdictions let a prescriber
  ///   write a repeat on the face of the prescription — India's Drugs Rules
  ///   r. 65(11)(b) is the one this repository has rules for — and
  ///   `@rcln/regulatory` has been able to READ that fact since PI-7 while
  ///   nothing could WRITE it. A lawful endorsed repeat was therefore refused,
  ///   in the safe direction, by the clinical record having nowhere to say so.
  ///
  /// ⚠️ THREE STATES, AND NULL IS NOT `false`. NULL is "the prescriber did not
  ///   address repeats", which is the ordinary case and the one the engine
  ///   treats as no endorsement. `false` is "the prescriber wrote that this may
  ///   NOT be repeated", which is a positive instruction. Collapsing them would
  ///   make every prescription ever written an explicit refusal of a repeat, and
  ///   would make the column unable to say the one thing it exists to say.
  repeatsAuthorised      Boolean? @map("repeats_authorised")
  /// How many repeats. ⚠️ NULL ALONGSIDE `repeatsAuthorised = true` RESOLVES
  ///   `UNDETERMINED`, WHICH REFUSES, and that is deliberate rather than a gap:
  ///   an endorsement stating no number is not an unlimited one. The engine's
  ///   own note says so and PI-7's tests pin it. CHECKed to be present only with
  ///   a true endorsement, and positive.
  repeatsAuthorisedLimit Int?     @map("repeats_authorised_limit") @db.SmallInt

  /// "As needed". ⚠️ NOT the same as a NULL frequency: PRN says the patient
  ///   decides when, a NULL says the doctor did not write it down.
  isPrn        Boolean @default(false) @map("is_prn")
  /// ⚠️ PHI. What the columns cannot say — "shake well", "stop if rash".
  instructions String? @db.Text
  /// ⚠️ PHI. For the record rather than for the patient.
  notes        String? @db.Text
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter    @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  /// Restrict: a medicine somebody was prescribed is deactivated, never deleted.
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// What the dispensary actually supplied against this line (PI-7). The
  /// fulfilment arithmetic lives here rather than in a column on this row.
  dispenseLines DispenseLine[]

  @@index([organizationId, encounterId, displayOrder])
  /// PI-7's read: what is outstanding against this product, and what was
  /// prescribed at this branch.
  @@index([organizationId, productId])
  @@index([organizationId, branchId, createdAt])
  /// Composite-FK target, added in PI-7 so a dispense line can cite the
  /// prescribed line it answers without a bare id that could point at another
  /// tenant's row (ADR-0004).
  @@unique([organizationId, id])
  @@map("encounter_prescriptions")
}

/// What was ordered.
///
/// ⚠️ NOT A LAB ORDER, BECAUSE THE LAB MODULE DOES NOT EXIST. This is the
///   CONSULTATION's statement that something was asked for; when the lab ships,
///   its own workflow references these rows rather than replacing them.
model EncounterInvestigation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  /// Not nullable in the migration — see `EncounterProcedure` for why an order
  /// is coded and a symptom need not be.
  itemId String? @map("item_id") @db.Uuid

  /// ⚠️ PHI. Why it was ordered, in the clinician's words.
  reason       String?               @db.Text
  priority     InvestigationPriority @default(ROUTINE)
  /// ⚠️ PHI. "Fasting", "left side only".
  instructions String?               @db.Text
  status       InvestigationStatus   @default(ORDERED)
  displayOrder Int                   @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter           @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  item         ClinicalMasterItem? @relation("InvestigationItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([organizationId, encounterId, displayOrder])
  @@index([organizationId, status, createdAt])
  @@map("encounter_investigations")
}

/// What the patient was told to do.
///
/// ⚠️ `isEdited` IS NOT DECORATION. Advice is picked from a library and then
///   tailored — "brushing technique" becomes "brushing technique, and stop using
///   the hard brush". The flag is how a clinic knows which of its standard
///   advice actually reaches patients unchanged, and it is the difference
///   between a library that is used and one that is worked around.
model EncounterAdvice {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  itemId     String? @map("item_id") @db.Uuid
  /// ⚠️ PHI once tailored. Exactly one of the two, by CHECK — see the symptom.
  customText String? @map("custom_text") @db.Text

  /// TRUE when the clinician changed the library text before giving it.
  isEdited     Boolean @default(false) @map("is_edited")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter           @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  item         ClinicalMasterItem? @relation("AdviceItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([organizationId, encounterId, displayOrder])
  @@map("encounter_advice")
}

/// Who else the patient is being sent to.
///
/// ⚠️ THREE WAYS TO NAME THE DESTINATION AND AT LEAST ONE IS REQUIRED, by CHECK.
///   A referral to a specialty ("see a cardiologist"), to a named colleague in
///   this organization, or to somebody outside it entirely are all ordinary, and
///   a row naming none of the three is a referral to nobody.
model EncounterReferral {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  /// ⚠️ A PLAIN FK INTO `specialties`, WHICH ALLOWS A NULL organization_id, so
  ///   it needs `specialty_visible` — the same shape `clinical_master_scopes`
  ///   and `consultation_templates` have.
  specialtyId     String? @map("specialty_id") @db.Uuid
  /// A colleague in this organization. Composite-FK'd: a doctor profile is
  /// always org-scoped, so the constraint CAN be drawn here and therefore is.
  doctorProfileId String? @map("doctor_profile_id") @db.Uuid
  /// ⚠️ PHI-adjacent. A clinician outside this organization, by name.
  externalName    String? @map("external_name") @db.VarChar(255)

  /// ⚠️ PHI. Why they are being referred.
  reason       String?         @db.Text
  urgency      ReferralUrgency @default(ROUTINE)
  /// ⚠️ PHI.
  notes        String?         @db.Text
  displayOrder Int             @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter     Encounter      @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  specialty     Specialty?     @relation("ReferralSpecialty", fields: [specialtyId], references: [id], onDelete: Restrict)
  doctorProfile DoctorProfile? @relation("ReferralDoctor", fields: [organizationId, doctorProfileId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, encounterId, displayOrder])
  @@map("encounter_referrals")
}

/// A file on the consultation — a photograph, a report, a consent.
///
/// ⚠️ THE BYTES ARE IN `files` AND THE CLINICAL MEANING IS HERE, and the split is
///   §27's. This row says a stored file belongs to this consultation and what it
///   is clinically; `files` says where the bytes are and who uploaded them. A
///   `storage_key` in this table would put the storage layer inside the chart.
///
/// ⚠️ THE FK IS COMPOSITE AND THAT REFUSES A PLATFORM FILE, WHICH IS CORRECT.
///   `files.organization_id` is nullable so that the platform can hold an asset
///   on a tenant's behalf; a clinical attachment is never one of those, so the
///   constraint saying so is a feature rather than the limitation it is on
///   `encounters.template_id`.
model EncounterAttachment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid

  storedFileId String @map("stored_file_id") @db.Uuid

  kind         EncounterAttachmentKind @default(OTHER)
  /// ⚠️ PHI. "Pre-operative, upper left quadrant."
  caption      String?                 @db.VarChar(500)
  displayOrder Int                     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter    @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  /// Optional in Prisma's eyes only because the composite includes a column
  /// `files` allows to be NULL; the row always has a file.
  storedFile   StoredFile?  @relation(fields: [organizationId, storedFileId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  /// One row per file per consultation — attaching the same photograph twice is
  /// a double-click, not a second attachment.
  @@unique([organizationId, encounterId, storedFileId])
  @@index([organizationId, encounterId, displayOrder])
  @@map("encounter_attachments")
}

// -----------------------------------------------------------------------------
// VISUAL MAPPING (CE-6)
//
// The chart a clinician draws ON: an odontogram, a scalp map, a body diagram.
// Two configuration tables and one PHI table, and the line between them is the
// same one the templates draw.
//
//   visual_maps / visual_regions   PLATFORM-EXTENSIBLE. A map is a picture of a
//     BODY, not a fact about a clinic — the 32 teeth of the FDI notation are the
//     same 32 teeth in every dental practice on the platform, so the platform
//     ships them and a clinic adds its own beside them.
//
//   clinical_findings              ORG + BRANCH SCOPED, PHI. "Caries on tooth
//     36" is a statement about a named person at a place.
//
// ⚠️ NO CLINICAL DATA IN THE ASSET (§22). The map says where the regions ARE and
//   what they are CALLED. What was found on one is a row in `clinical_findings`,
//   never a colour baked into a drawing — a chart that carried its own findings
//   could not be queried, reported on, audited, or amended.
//
// ⚠️ AND THE GEOMETRY IS THE REGION'S, NOT AN SVG FILE'S (CD-17). `metadata`
//   carries each region's shape in the map's own `view_box` coordinates, so
//   `apps/web` holds ONE generic renderer and a new map is a set of ROWS. The
//   alternative — one hand-drawn component per map — is exactly the
//   `HairConsultation.tsx` that CE-7's definition of done forbids. It is a
//   DOCUMENT and not foreign keys, so ADR-0006 is untouched.
// -----------------------------------------------------------------------------

/// How a map is drawn.
///
/// ⚠️ AN ENUM WITH TWO MEMBERS RATHER THAN A BOOLEAN, because the third is
///   foreseeable — a photograph a clinician pins findings onto is neither of
///   these. A `is_svg Boolean` would have to be migrated the day it arrives.
enum VisualMapRenderer {
  /// Regions are vector shapes, drawn from their own geometry. The only
  /// renderer CE-6 ships a map for.
  SVG
  /// Regions are hotspots over a raster asset named by `asset_key`.
  IMAGE_MAP
}

/// One chart: what it is a picture of, and how big its coordinate space is.
///
/// ⚠️ PLATFORM-EXTENSIBLE WITH `specialties`' POLICY, NOT `files`'. Reproducing
///   the NULL-permissive WITH CHECK would let any clinic publish a
///   PLATFORM-WIDE map — visible to every other tenant, writable by anyone
///   holding `clinical.visual_map.manage`.
///
/// NO PHI. A map names no patient.
model VisualMap {
  id             String            @id @default(uuid()) @db.Uuid
  /// NULL = platform row, visible to every tenant.
  organizationId String?           @map("organization_id") @db.Uuid
  /// ⚠️ FLAT, NOT A PATH — `HUMAN_DENTAL`, never `HUMAN-DEN-ADULT`. It is what
  ///   a template names in its `mapCode` (CD-6), so it is also the one string
  ///   that must stay stable: renaming it orphans every template citing it.
  code           String            @db.VarChar(64)
  name           String            @db.VarChar(160)
  description    String?           @db.Text
  renderer       VisualMapRenderer @default(SVG)
  /// The raster asset an IMAGE_MAP is drawn over. NULL for an SVG map, which
  /// draws its regions and nothing else.
  assetKey       String?           @map("asset_key") @db.VarChar(120)

  /// The `CARE_CONTEXT` root this map belongs to (CD-3). A human dental chart
  /// and a veterinary one are different pictures of different mouths.
  careContextId String  @map("care_context_id") @db.Uuid
  /// The node it is especially for, anywhere below the care context. NULL means
  /// the map is offered across the care context — a body diagram is nobody's
  /// specialty in particular.
  specialtyId   String? @map("specialty_id") @db.Uuid

  /// The SVG coordinate space every region's geometry is expressed in.
  /// `"0 0 640 320"` — four numbers, validated by `@rcln/clinical`.
  ///
  /// ⚠️ ON THE MAP AND NOT ON THE REGION. One coordinate space per picture is
  ///   what makes the regions comparable; a per-region box would mean thirty-two
  ///   teeth that cannot be laid out beside one another.
  viewBox String @map("view_box") @db.VarChar(64)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// ⚠️ PLAIN FKs, NOT COMPOSITE, and they therefore need a RESTRICTIVE
  ///   `specialty_visible` policy — `specialties` allows a NULL organization_id,
  ///   so a composite FK cannot be drawn and the row could otherwise cite
  ///   another tenant's private node and read its name back out of the join.
  ///   Exactly the shape `consultation_templates` has.
  careContext  Specialty      @relation("VisualMapCareContext", fields: [careContextId], references: [id], onDelete: Restrict)
  specialty    Specialty?     @relation("VisualMapSpecialty", fields: [specialtyId], references: [id], onDelete: Restrict)
  regions      VisualRegion[]

  /// ⚠️ Rewritten NULLS NOT DISTINCT in the migration — without it the platform
  /// maps are not unique among themselves.
  @@unique([organizationId, code])
  /// Composite-FK target for the regions, so a tenant can never bolt its own
  /// region onto a PLATFORM map (ADR-0004).
  @@unique([organizationId, id])
  @@index([organizationId, careContextId, isActive])
  @@index([organizationId, specialtyId])
  @@map("visual_maps")
}

/// One place on a map: a tooth, a quadrant, a scalp zone.
///
/// ⚠️ `code` IS FDI FOR THE DENTAL MAP — `TOOTH_11` … `TOOTH_48` (CD-11). Not an
///   index, and not a display notation. Universal and Palmer are RENDERINGS of
///   the same stored codes, which is exactly what an index would have made
///   impossible.
///
/// ⚠️ `parent_id` GROUPS AND DOES NOT NEST GEOMETRY. A quadrant is a region with
///   no geometry of its own whose children are the eight teeth in it — that is
///   what lets a screen offer "upper right" without inventing a second table,
///   and what `regionsOf` in `@rcln/clinical` reads.
///
/// NO PHI.
model VisualRegion {
  id             String  @id @default(uuid()) @db.Uuid
  /// Mirrors the parent map's. NULL for a region of a platform map.
  organizationId String? @map("organization_id") @db.Uuid
  mapId          String  @map("map_id") @db.Uuid
  code           String  @db.VarChar(64)
  label          String  @db.VarChar(160)
  /// A grouping region — a quadrant, an arch, a side. NULL for a top-level one.
  ///
  /// ⚠️ `onDelete: Restrict`, NOT SetNull, for the reason the taxonomy records:
  ///   SetNull "succeeds" at deleting a group and silently promotes its whole
  ///   subtree to the top level.
  parentId       String? @map("parent_id") @db.Uuid
  displayOrder   Int     @default(0) @map("display_order")

  /// The region's shape, in the map's `view_box` coordinates.
  ///
  /// ⚠️ PARSED BY `@rcln/clinical`'s `regions.ts` BEFORE ANYTHING DRAWS IT, and
  ///   a document that is PRESENT and malformed is an ERROR rather than a
  ///   region quietly missing from the chart. ABSENT is legal and means "this
  ///   region groups and is not drawn" — that distinction is the whole of the
  ///   PI-5 lesson, and both cases are unit-tested.
  ///
  /// ⚠️ A DOCUMENT, NEVER FOREIGN KEYS (ADR-0006). Geometry is not an id.
  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite-FK'd so a tenant cannot bolt its own region onto a PLATFORM map.
  /// Optional ONLY because Prisma refuses a required relation whose scalar
  /// fields include a nullable one; the row always has a map.
  map          VisualMap?           @relation(fields: [organizationId, mapId], references: [organizationId, id], onDelete: Cascade)
  parent       VisualRegion?        @relation("VisualRegionParent", fields: [parentId], references: [id], onDelete: Restrict)
  children     VisualRegion[]       @relation("VisualRegionParent")
  /// What consultations have said about this place. `onDelete: Restrict` on both
  /// is why a map is deactivated rather than deleted.
  findings     ClinicalFinding[]
  /// Which tooth the root canal was done on (CE-4's column, filled in here).
  procedures   EncounterProcedure[] @relation("ProcedureRegion")

  /// ⚠️ NULLS NOT DISTINCT in the migration.
  @@unique([organizationId, mapId, code])
  /// Composite-FK target for nothing yet — `clinical_findings.organization_id`
  /// is NOT NULL and a platform region's is NULL, so that pointer is a plain FK
  /// with a `region_visible` policy instead. Kept for the shape every other
  /// platform-extensible parent in this file has.
  @@unique([organizationId, id])
  @@index([organizationId, mapId, displayOrder])
  /// Group walks recurse on `parent_id` — without this the recursive CTE
  /// seq-scans once per level.
  @@index([parentId])
  @@map("visual_regions")
}

/// What the clinician found, on which region, at which visit.
///
/// ⚠️ ORG + BRANCH SCOPED AND PHI, LIKE THE EIGHT CE-4 TABLES AND FOR THE SAME
///   REASONS. It carries its own `organization_id` AND `branch_id` rather than
///   inheriting the org half through its encounter: a child of a branch-scoped
///   parent that inherits only the org half is the hole
///   `appointment_status_history` had to restate by hand.
///
/// ⚠️ A FINDING IS NOT A DIAGNOSIS. "Caries" is what the dentist SEES on tooth
///   36; "Dental caries" is what it MEANS, and `diagnosis_id` is the optional
///   link between them. Collapsing the two would make the chart claim a
///   diagnosis nobody has committed to yet.
///
/// ⚠️ `section_key` IS HERE BECAUSE `VISUAL_MAPPING` IS REPEATABLE. An ENT
///   consultation charts a left ear and a right ear; each is its own section of
///   the same template, and a finding that did not say which section it belongs
///   to would render on both.
model ClinicalFinding {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  encounterId    String @map("encounter_id") @db.Uuid
  /// The `TemplateSection.key` of the VISUAL_MAPPING section this was drawn on.
  sectionKey     String @map("section_key") @db.VarChar(64)

  /// Where on the map. A plain FK — a platform region has no organization_id to
  /// compose with — so it needs a RESTRICTIVE `region_visible` policy.
  visualRegionId String  @map("visual_region_id") @db.Uuid
  /// What was found: a `FINDING_TYPE` word. ⚠️ NOT NULL, unlike a symptom's or a
  /// diagnosis's item — a mark on a chart with no name is a mark nobody can read
  /// back, and there is no free-text half to fall back on because the region
  /// already says WHERE.
  findingItemId  String  @map("finding_item_id") @db.Uuid
  /// What it was taken to mean, if the consultation committed to one.
  ///
  /// ⚠️ Restrict, AND SetNull IS NOT AVAILABLE — the composite includes
  ///   `organization_id`, which is NOT NULL, so Postgres cannot null the pair.
  ///   The service unlinks the findings before deleting the diagnosis, exactly
  ///   as it already does for procedures.
  diagnosisId    String? @map("diagnosis_id") @db.Uuid

  severity     ClinicalSeverity?
  /// ⚠️ PHI.
  notes        String?           @db.Text
  /// Per-finding qualifiers a map wants and no column should own — which
  /// surfaces of a tooth, which grade of mobility. ⚠️ A DOCUMENT, NOT IDS.
  metadata     Json?             @db.JsonB
  displayOrder Int               @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  encounter    Encounter           @relation(fields: [organizationId, encounterId], references: [organizationId, id], onDelete: Cascade)
  region       VisualRegion        @relation(fields: [visualRegionId], references: [id], onDelete: Restrict)
  item         ClinicalMasterItem  @relation("FindingItem", fields: [findingItemId], references: [id], onDelete: Restrict)
  diagnosis    EncounterDiagnosis? @relation(fields: [organizationId, diagnosisId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  /// The same word twice on the same region of the same chart is a double
  /// click, not a second finding.
  @@unique([organizationId, encounterId, sectionKey, visualRegionId, findingItemId])
  @@index([organizationId, encounterId, displayOrder])
  @@index([organizationId, visualRegionId])
  @@map("clinical_findings")
}
