// =============================================================================
// IDENTITY
// =============================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LOCKED
}

enum AuthTokenPurpose {
  LOGIN_OTP
  PASSWORD_RESET
  VERIFY_EMAIL
  VERIFY_PHONE
  INVITE_ACCEPT
}

/// ONE table for every human: super admin, doctor, receptionist, patient.
/// Deliberately global (not org-scoped) so one person can hold memberships in
/// several organizations with a single login. There is NO role column here —
/// roles live on membership_roles, scoped per branch.
model User {
  id                         String     @id @default(uuid()) @db.Uuid
  email                      String?    @unique @db.VarChar(255)
  phone                      String?    @unique @db.VarChar(20)
  passwordHash               String?    @map("password_hash") @db.VarChar(255)
  fullName                   String     @map("full_name") @db.VarChar(255)
  avatarFileId               String?    @map("avatar_file_id") @db.Uuid
  status                     UserStatus @default(INVITED)
  /// The seeded platform operator. Bypasses membership checks entirely and can
  /// enter any tenant — every such action is written to audit_logs.
  isPlatformAdmin            Boolean    @default(false) @map("is_platform_admin")
  mfaEnabled                 Boolean    @default(false) @map("mfa_enabled")
  mfaSecret                  String?    @map("mfa_secret") @db.VarChar(255)
  locale                     String     @default("en") @db.VarChar(10)
  /// The clinic this platform admin last worked inside, so the console can offer
  /// it again on their next sign-in instead of making them find it.
  ///
  /// A PREFERENCE, NOT A GRANT. It confers nothing — entering a clinic still goes
  /// through the impersonation handoff, which re-checks `isPlatformAdmin` at
  /// redemption and writes an audit row with a stated reason (ADR-0012). A stale
  /// or deleted organization here is harmless: the console validates it on read
  /// and offers nothing if it no longer resolves.
  ///
  /// It lives on `users` rather than on a tenant table because the person it
  /// describes belongs to no tenant — that is what makes them a platform admin.
  /// Null for everyone else, which is almost everyone.
  lastPlatformOrganizationId String?    @map("last_platform_organization_id") @db.Uuid
  emailVerifiedAt            DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt            DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt                DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedAttempts             Int        @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil                DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  identities               UserIdentity[]
  sessions                 Session[]
  authTokens               AuthToken[]
  memberships              Membership[]
  ownedOrganizations       Organization[]        @relation("OrganizationOwner")
  // SetNull, and safe as a single-column FK on a nullable column: forgetting a
  // preference is the correct outcome when the clinic it named is gone.
  lastPlatformOrganization Organization?         @relation("PlatformAdminLastOrganization", fields: [lastPlatformOrganizationId], references: [id], onDelete: SetNull)
  invitationsSent          Invitation[]          @relation("InvitedBy")
  auditLogs                AuditLog[]
  dataAccessLogs           DataAccessLog[]
  uploadedFiles            StoredFile[]
  doctorProfiles           DoctorProfile[]
  /// The portal login for a patient record. Optional on both sides — most
  /// patients never sign up.
  patientRecords           Patient[]
  patientRegistrations     PatientRegistration[] @relation("PatientRegisteredBy")
  allergiesNoted           PatientAllergy[]      @relation("AllergyNotedBy")
  conditionsNoted          PatientCondition[]    @relation("ConditionNotedBy")
  medicationsNoted         PatientMedication[]   @relation("MedicationNotedBy")
  appointmentsBooked       Appointment[]         @relation("AppointmentBookedBy")
  appointmentsCancelled    Appointment[]         @relation("AppointmentCancelledBy")

  // -- Clinical consultation engine (CE-1) ------------------------------------
  episodesOpened            ClinicalEpisode[]                 @relation("EpisodeOpenedBy")
  episodesClosed            ClinicalEpisode[]                 @relation("EpisodeClosedBy")
  recommendationsCancelled  EncounterFollowUpRecommendation[] @relation("RecommendationCancelledBy")
  /// Who put a configuration live (CE-2). SetNull — they may leave, the
  /// configuration stays.
  templateVersionsPublished ConsultationTemplateVersion[]     @relation("TemplateVersionPublishedBy")
  /// Who signed a clinical record (CE-3). ⚠️ Restrict, NOT SetNull, and the only
  /// `*_by` relation in this block with that shape: who finalized a consultation
  /// is part of the consultation, and a user row that could be deleted out from
  /// under it would leave an unsigned record.
  encountersFinalized       Encounter[]                       @relation("EncounterFinalizedBy")
  encountersCancelled       Encounter[]                       @relation("EncounterCancelledBy")
  appointmentStatusChanges  AppointmentStatusHistory[]        @relation("AppointmentStatusChangedBy")
  vitalsRecorded            AppointmentVital[]                @relation("VitalRecordedBy")
  vitalsAmended             AppointmentVital[]                @relation("VitalSupersededBy")
  invoicesCreated           Invoice[]                         @relation("InvoiceCreatedBy")
  invoicesIssued            Invoice[]                         @relation("InvoiceIssuedBy")
  invoicesCancelled         Invoice[]                         @relation("InvoiceCancelledBy")
  invoiceDocumentsGenerated InvoiceDocument[]                 @relation("InvoiceDocumentGeneratedBy")
  /// Every stock movement they made. `onDelete: Restrict` on that side: a
  /// movement with no actor is a movement nobody can be asked about.
  stockMovements            StockLedgerEntry[]
  /// The PI-3 documents. `onDelete: Restrict` throughout, for the same reason:
  /// a transfer nobody dispatched and a reservation nobody made are documents
  /// with no one to ask.
  transfersCreated          StockTransfer[]                   @relation("TransferCreatedBy")
  transfersDispatched       StockTransfer[]                   @relation("TransferDispatchedBy")
  transfersReceived         StockTransfer[]                   @relation("TransferReceivedBy")
  transfersCancelled        StockTransfer[]                   @relation("TransferCancelledBy")
  reservationsCreated       StockReservation[]                @relation("ReservationCreatedBy")
  reservationsReleased      StockReservation[]                @relation("ReservationReleasedBy")
  // Procurement (PI-4). Every state change on every document names who made it.
  // ⚠️ `requisitionsCreated` and `requisitionsApproved` are the pair that MUST
  //   stay distinguishable: a requisition whose approver is its creator is
  //   refused by a CHECK constraint, which is the segregation-of-duty control the
  //   two permission codes exist for. See PurchaseRequisition.
  requisitionsCreated       PurchaseRequisition[]             @relation("RequisitionCreatedBy")
  requisitionsSubmitted     PurchaseRequisition[]             @relation("RequisitionSubmittedBy")
  requisitionsApproved      PurchaseRequisition[]             @relation("RequisitionApprovedBy")
  requisitionsRejected      PurchaseRequisition[]             @relation("RequisitionRejectedBy")
  requisitionsCancelled     PurchaseRequisition[]             @relation("RequisitionCancelledBy")
  purchaseOrdersCreated     PurchaseOrder[]                   @relation("PurchaseOrderCreatedBy")
  purchaseOrdersIssued      PurchaseOrder[]                   @relation("PurchaseOrderIssuedBy")
  purchaseOrdersClosed      PurchaseOrder[]                   @relation("PurchaseOrderClosedBy")
  purchaseOrdersCancelled   PurchaseOrder[]                   @relation("PurchaseOrderCancelledBy")
  goodsReceiptsCreated      GoodsReceipt[]                    @relation("GoodsReceiptCreatedBy")
  goodsReceiptsPosted       GoodsReceipt[]                    @relation("GoodsReceiptPostedBy")
  goodsReceiptsCancelled    GoodsReceipt[]                    @relation("GoodsReceiptCancelledBy")
  qualityDecisions          GoodsReceiptLine[]                @relation("GoodsReceiptLineQualityDecidedBy")
  purchaseReturnsCreated    PurchaseReturn[]                  @relation("PurchaseReturnCreatedBy")
  purchaseReturnsSent       PurchaseReturn[]                  @relation("PurchaseReturnSentBy")
  purchaseReturnsCancelled  PurchaseReturn[]                  @relation("PurchaseReturnCancelledBy")
  /**
   * Who pressed the button on a rule pack's sign-off (PI-5).
   * ⚠️ NOT THE SAME QUESTION AS `regulatory_rule_packs.reviewed_by`, WHICH IS A
   * NAME. The qualified person who reviewed a jurisdiction's rules — counsel,
   * a retained consultant, a registered pharmacist — is often not a user of
   * this system, and the account that recorded their decision is not the
   * person who made it. An audit of a regulatory sign-off asks both.
   */
  rulePacksReviewed         RegulatoryRulePack[]              @relation("RulePackReviewer")

  // -- Pharmacy dispensing (PI-7) --------------------------------------------
  prescriptionsVerified     PrescriptionFulfilment[]          @relation("PrescriptionFulfilmentVerifiedBy")
  prescriptionsCancelled    PrescriptionFulfilment[]          @relation("PrescriptionFulfilmentCancelledBy")
  /// ⚠️ THE PERSON WHO HANDED IT OVER, AND THE RECORD OF WHO THAT WAS IS THE
  ///   POINT. Several jurisdictions require the supply to be made BY a named
  ///   registered pharmacist; a dispense attributed to nobody is one no
  ///   inspection can follow.
  dispensesMade             Dispense[]                        @relation("DispenseDispensedBy")
  dispenseReturnsReceived   DispenseReturn[]                  @relation("DispenseReturnReceivedBy")
  regulatoryDecisionsMade   RegulatoryDecision[]              @relation("RegulatoryDecisionActor")

  // -- Charging (PI-8) --------------------------------------------------------
  /// ⚠️ WHO DECIDED TO BILL, OR NOT TO. An `OPTIONAL` charge policy hands the
  ///   question to a human, and "somebody chose not to charge for this" with no
  ///   name against it is indistinguishable from the system having missed it.
  chargeRequestsDecided     ChargeRequest[]                   @relation("ChargeRequestDecidedBy")
  chargePolicyRulesUpdated  ChargePolicyRule[]                @relation("ChargePolicyRuleUpdatedBy")
  productPricesUpdated      ProductPrice[]                    @relation("ProductPriceUpdatedBy")

  // -- Clinical consumption (PI-9) --------------------------------------------
  /// ⚠️ WHO SAYS THIS WAS USED. A consumption attributed to nobody is a stock
  ///   movement with no author, and the variance report exists precisely to be
  ///   read alongside a name.
  consumptionsRecorded      ClinicalConsumption[]             @relation("ConsumptionRecordedBy")
  consumptionsAmended       ClinicalConsumption[]             @relation("ConsumptionAmendedBy")
  consumptionTemplatesUpdated ConsumptionTemplate[]           @relation("ConsumptionTemplateUpdatedBy")

  // -- Recall & traceability (PI-10) ------------------------------------------
  /// ⚠️ THREE ACTS, THREE NAMES. Raising a notice, pulling the stock and
  ///   declaring the work finished are decisions taken at different moments by
  ///   different people, and a single `updated_by` would erase the one a
  ///   regulator asks about: who authorised the hold.
  recallsRaised             Recall[]                          @relation("RecallRaisedBy")
  recallsExecuted           Recall[]                          @relation("RecallExecutedBy")
  recallsClosed             Recall[]                          @relation("RecallClosedBy")

  // -- Online pharmacy (PI-12) ------------------------------------------------
  /// ⚠️ SIX NAMES FOR SIX ACTS, and the reasoning is the one immediately above.
  ///   Taking the order, accepting it, making up the parcel, standing it down,
  ///   handing it to a carrier and closing the delivery out are decisions taken
  ///   at different moments by different people; one `updated_by` would erase
  ///   whichever one somebody later asks about.
  onlineOrdersPlaced        OnlineOrder[]                     @relation("OnlineOrderPlacedBy")
  onlineOrdersConfirmed     OnlineOrder[]                     @relation("OnlineOrderConfirmedBy")
  onlineOrdersPacked        OnlineOrder[]                     @relation("OnlineOrderPackedBy")
  onlineOrdersCancelled     OnlineOrder[]                     @relation("OnlineOrderCancelledBy")
  onlineShipmentsShipped    OnlineOrderShipment[]             @relation("OnlineOrderShipmentShippedBy")
  onlineShipmentsDelivered  OnlineOrderShipment[]             @relation("OnlineOrderShipmentDeliveredBy")
  onlineShipmentsFailed     OnlineOrderShipment[]             @relation("OnlineOrderShipmentFailedBy")

  @@index([status])
  @@index([isPlatformAdmin])
  @@map("users")
}

model UserIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   @db.VarChar(32)
  providerUid String   @map("provider_uid") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("user_identities")
}

/// Where branch switching physically lives. Changing the active branch is an
/// UPDATE here plus a re-issued access token — never a re-login.
model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  activeBranchId       String?   @map("active_branch_id") @db.Uuid
  impersonatedByUserId String?   @map("impersonated_by_user_id") @db.Uuid
  /// Opaque 256-bit token, hashed. Rotated on every refresh; presenting an
  /// already-rotated token revokes the whole family (theft signal).
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.VarChar(255)
  previousTokenHash    String?   @map("previous_token_hash") @db.VarChar(255)
  ipAddress            String?   @map("ip_address") @db.Inet
  userAgent            String?   @map("user_agent") @db.VarChar(512)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamptz(6)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBranch Branch? @relation(fields: [activeBranchId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// OTP and one-shot links. Phone-first login is non-negotiable in Indian
/// healthcare, so this carries attempt counting and hard expiry.
model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  identifier String           @db.VarChar(255)
  codeHash   String           @map("code_hash") @db.VarChar(255)
  attempts   Int              @default(0) @db.SmallInt
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}
