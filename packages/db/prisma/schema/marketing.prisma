// ---------------------------------------------------------------------------
// Marketing (apex domain, pre-tenant)
// ---------------------------------------------------------------------------

enum DemoRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  SPAM
}

/// A demo request from the public landing page at the apex domain.
///
/// Deliberately NOT tenant-scoped, and this is the one model where that is the
/// correct answer rather than an oversight: the person submitting it has no
/// organization yet, so there is no `organization_id` to put on the row and no
/// tenant context for an RLS policy to read. Giving it a policy requiring
/// `app.current_org` would make the table permanently unwritable.
///
/// Recorded as an exemption in prisma/rls/enable-rls.sql and in the EXEMPT list
/// in scripts/check-rls.ts. Access is gated in the application layer: one
/// public, rate-limited, write-only endpoint, and reads restricted to platform
/// admins.
///
/// Contact details, never clinical data.
model DemoRequest {
  id          String            @id @default(uuid()) @db.Uuid
  clinicName  String            @map("clinic_name") @db.VarChar(255)
  contactName String            @map("contact_name") @db.VarChar(255)
  email       String            @db.VarChar(255)
  phone       String            @db.VarChar(20)
  city        String?           @db.VarChar(100)
  branchCount Int?              @map("branch_count")
  specialty   String?           @db.VarChar(120)
  message     String?           @db.Text
  /// Referrer or campaign label. Must never carry anything identifying.
  source      String?           @db.VarChar(255)
  status      DemoRequestStatus @default(NEW)
  handledAt   DateTime?         @map("handled_at") @db.Timestamptz(6)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([email])
  @@map("demo_requests")
}
