// ---------------------------------------------------------------------------
// Document numbering
// ---------------------------------------------------------------------------

enum NumberSequenceType {
  UHID
  MRN
  APPOINTMENT
  QUEUE_TOKEN
  /// Staff employee codes, issued when an invitation is accepted.
  EMPLOYEE
  /// Patient invoice serials. One counter per (branch, source, period) — the
  /// source and the period share `period_key` (`'2026-27:APP'` in India,
  /// `'2026:APP'` where the year is the calendar one). See §0.6 of the
  /// invoice-engine log for why the series is per branch, and
  /// `invoice-number.service.ts` for the only code that builds the key.
  INVOICE
  /// Stock transfer documents (PI-3). One counter per SENDING branch, issued at
  /// dispatch and never at create — a draft that is abandoned must not burn a
  /// number in a series a storekeeper reads as a sequence. Never resets: a
  /// transfer number is a document identifier and a clinic reconciling a
  /// six-month-old delivery note needs it to still mean one thing.
  STOCK_TRANSFER
  // -------------------------------------------------------------------------
  // Procurement (PI-4). All four are per BRANCH and never reset, for the reason
  // `STOCK_TRANSFER` does not: every one of them is quoted back by somebody
  // outside the clinic — a supplier on their invoice, an auditor on a purchase
  // trail — so it has to mean one thing for ever.
  //
  // ⚠️ EVERY ONE IS ISSUED AT THE MOMENT THE DOCUMENT LEAVES DRAFT, NOT AT
  //   CREATE. A requisition that is abandoned, a PO that is never sent and a
  //   delivery keyed in by mistake must all burn no number, because a gap in
  //   any of these series is a gap a supplier or an auditor will ask about.
  // -------------------------------------------------------------------------
  /// Issued on SUBMIT.
  PURCHASE_REQUISITION
  /// Issued on ISSUE. The number the supplier quotes back on their invoice.
  PURCHASE_ORDER
  /// Issued on POST. The receipt the accountant reconciles the invoice against.
  GOODS_RECEIPT
  /// Issued on SEND.
  PURCHASE_RETURN
  /// ⚠️ PRESENT AND UNUSED, DELIBERATELY. Dispensing is PI-7, and adding a
  ///   member to a Postgres enum is a migration — one this phase can pay for
  ///   now and that phase would otherwise pay for under live stock. The same
  ///   call PI-2 made for the `RESERVED` and `IN_TRANSIT` stock statuses.
  DISPENSE
  /// Treatment journeys (CE-1). ⚠️ PER ORGANIZATION, NOT PER BRANCH, and it
  ///   never resets — the only counter in this enum with that shape.
  ///
  ///   An episode follows the PATIENT, who is org-wide (ADR-0016): a journey
  ///   that starts at the main branch and continues at the satellite is one
  ///   journey, so a per-branch counter would either issue two codes for it or
  ///   have to pick a branch arbitrarily. And it never resets because an episode
  ///   code is quoted on a discharge summary and a referral letter years later.
  CLINICAL_EPISODE
  /// Consultations (CE-3). ⚠️ PER BRANCH — the opposite shape from
  ///   `CLINICAL_EPISODE` immediately above, and deliberately. A journey follows
  ///   the patient across a hospital group; a consultation happened at ONE site,
  ///   and the number is printed on a prescription that site hands over.
  ///
  /// ⚠️ ISSUED AT FINALIZATION, NOT AT CREATE — the rule the four procurement
  ///   counters follow. A draft the doctor abandons must burn no number, because
  ///   a gap in this series is a question an auditor will ask. Never resets: the
  ///   number is quoted back years later.
  ENCOUNTER
  /// Recall notices (PI-10). ⚠️ ORG-WIDE AND NEVER RESETS, unlike every
  ///   procurement counter above. A recall reaches every branch at once, so a
  ///   per-branch counter would give one notice three different numbers; and it
  ///   is quoted back to a regulator years later, so it has to mean one thing
  ///   for ever. Issued at CREATE rather than at execution — the document exists
  ///   from the moment the notice arrives, and a recall abandoned in draft
  ///   burning a number is a far smaller problem than a notice nobody can cite.
  RECALL
}

/// One counter per (organization, branch, type, period). The issuer for every
/// human-facing document number: UHID, branch-local MRN, appointment number and
/// the daily queue token.
///
/// `periodKey` generalises the "financial year" of the original design so one
/// mechanism serves all four reset cadences:
///   ''                        never resets (UHID, MRN)
///   '2026-27'                 financial year (appointment numbers)
///   '<date>:<doctorProfileId>' per doctor per day (queue tokens)
///
/// WHY NOT A POSTGRES SEQUENCE
///   `nextval` is deliberately non-transactional, so a booking that rolls back
///   would burn an appointment number permanently. It would also need one
///   sequence OBJECT per (org, branch, type, period) — runtime DDL, which
///   `rcln_app` cannot execute and should never be able to.
///
/// Numbers are issued by `issueNumber()` with a single `ON CONFLICT DO UPDATE`
/// statement whose row lock makes concurrent issues gapless. See that service.
///
/// ⚠️ ORG-SCOPED RLS ONLY — DELIBERATELY NO `branch_isolation` POLICY.
///   `ON CONFLICT DO UPDATE` against a row RLS hides does not update it; it
///   raises a duplicate-key error instead. A branch-scoped policy here would
///   turn "this branch is outside your scope" into a mystifying 23505 at the
///   moment of booking. Isolation is the tenant policy plus the explicit
///   `organizationId` every call passes.
model NumberSequence {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  /// Null for an org-wide counter (UHID). Set for everything branch-local.
  branchId       String?            @map("branch_id") @db.Uuid
  sequenceType   NumberSequenceType @map("sequence_type")
  periodKey      String             @default("") @map("period_key") @db.VarChar(64)
  /// ⚠️ 64, NOT 16, BECAUSE AN INVOICE PREFIX CARRIES THE BRANCH CODE.
  ///   `INV-2026-APP-MAIN-` is already 18 characters and `branches.code` may be
  ///   32 on its own. The old width was sized for `P` and `MRN-` and failed at
  ///   the moment of billing with a raw Postgres 22001 — found by the first
  ///   invoice this repository ever numbered, not by any type.
  prefix         String             @default("") @db.VarChar(64)
  padding        Int                @default(6) @db.SmallInt
  lastNumber     BigInt             @default(0) @map("last_number")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// ⚠️ Rewritten as NULLS NOT DISTINCT in the migration — `branchId` is null on
  /// every org-wide counter, and a plain unique index does not constrain nullable
  /// columns, so two UHID counters could otherwise coexist. It is also the
  /// ON CONFLICT arbiter, which requires the index to actually match.
  @@unique([organizationId, branchId, sequenceType, periodKey])
  @@map("number_sequences")
}
