{
  "name": "@rcln/documents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "fonts": "node scripts/build-fonts.mjs",
    "fonts:check": "node scripts/build-fonts.mjs --check",
    "clean": "rm -rf dist *.tsbuildinfo",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@rcln/contracts": "workspace:*",
    "@rcln/db": "workspace:*",
    "@rcln/payments": "workspace:*",
    "@rcln/storage": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@rcln/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.8.0",
    "ts-jest": "^29.4.6",
    "typescript": "catalog:"
  }
}
