{
  "name": "@rcln/inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "echo \"unit tests for this package live in apps/api\" && exit 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@rcln/db": "workspace:*",
    "@rcln/contracts": "workspace:*"
  },
  "devDependencies": {
    "@rcln/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "typescript": "catalog:"
  }
}
